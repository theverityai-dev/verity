# Verity — deployment environment template (Task 42).
#
# Copy to deploy/config/verity.env and fill in. That file is gitignored and
# must be mode 0600: it holds every credential this deployment uses.
#
#   cp deploy/config/verity.env.example deploy/config/verity.env
#   chmod 600 deploy/config/verity.env
#
# `deploy/scripts/install.sh` will generate the secret values for you.
#
# NOTHING IN THIS FILE IS A REAL SECRET. Every placeholder below is recognised
# by deploy/security/preflight.sh, which refuses to start a production
# deployment that still carries one.

# ── Deployment mode (Task 129, ADR-031) ─────────────────────────────────────
# A  the base package: the application, PostgreSQL and the scheduler. Identity and storage are whatever you configure below.
# B  private network: A plus Keycloak (identity), a TLS proxy and the bundled object store, all on this host, with no hosted
#    dependency at runtime. Install with:  VERITY_DEPLOYMENT_MODE=B VERITY_APP_HOST=verity.dsew.lan ./deploy/scripts/install.sh
#    install.sh then fills the Mode B values below and the Identity and Storage sections for you.
VERITY_DEPLOYMENT_MODE=A
# Mode B only. Three DNS names (or hosts-file entries) that resolve to this server on the office network.
VERITY_APP_HOST=
VERITY_IDP_HOST=
VERITY_FILES_HOST=
VERITY_HTTPS_PORT=443
VERITY_HTTPS_BIND=0.0.0.0
# Browser-facing origins derived from the hosts (ADR-032: configured, never taken from a request).
VERITY_IDP_URL=
# Keycloak administrator and its database. The administrator is for the operator on the host; the proxy does not expose it.
KEYCLOAK_ADMIN=CHANGE_ME_KEYCLOAK_ADMIN_USER
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK_ADMIN
KEYCLOAK_DB_PASSWORD=CHANGE_ME_KEYCLOAK_DB

# ── Database ────────────────────────────────────────────────────────────────
# The superuser. Migrations and role bootstrap only — never application traffic.
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_SUPERUSER
# The runtime role: NOSUPERUSER NOBYPASSRLS, created by deploy/db/init.
# If this role could bypass RLS, INV-001 would be unenforced while every policy
# still existed and every test still passed.
VERITY_APP_PASSWORD=CHANGE_ME_APP
POSTGRES_DB=verity

# ── Exposure ────────────────────────────────────────────────────────────────
# The application publishes one port. Bind it to localhost and put a
# TLS-terminating reverse proxy in front; 0.0.0.0 puts plain HTTP on the network.
VERITY_BIND_ADDRESS=127.0.0.1
VERITY_PORT=3000

# ── Identity (Task 36) ──────────────────────────────────────────────────────
# supabase | oidc
VERITY_AUTH_PROVIDER=supabase

# Supabase provider. Required when VERITY_AUTH_PROVIDER=supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# OIDC provider. Required when VERITY_AUTH_PROVIDER=oidc. Reaches Keycloak,
# Entra ID, Okta, Auth0 and Ping through configuration alone.
VERITY_OIDC_ISSUER=
VERITY_OIDC_CLIENT_ID=
VERITY_OIDC_REDIRECT_URI=https://verity.example.com/api/auth/oidc/callback
# The origin browsers reach Verity on: scheme, host, optional port, nothing else.
# Required with OIDC; https in production; must match VERITY_OIDC_REDIRECT_URI's origin.
# Verity builds every redirect from this value and never from Host or X-Forwarded-* headers.
VERITY_PUBLIC_URL=https://verity.example.com
# Leave blank for a public PKCE client; set only when the IdP registration is confidential.
VERITY_OIDC_CLIENT_SECRET=
VERITY_OIDC_AUDIENCE=
VERITY_OIDC_JWKS_URI=
VERITY_OIDC_PRINCIPAL_CLAIM=sub
VERITY_OIDC_EMAIL_CLAIM=email
VERITY_OIDC_SCOPES=openid profile email
VERITY_OIDC_SESSION_MAX_AGE_SECONDS=28800
VERITY_OIDC_SESSION_IDLE_SECONDS=3600
# Signs active-membership, login-transaction, and local OIDC session cookies.
VERITY_SESSION_SECRET=CHANGE_ME_SESSION

# ── Storage (Task 41) ───────────────────────────────────────────────────────
# supabase | s3.  Unset or incomplete means no storage driver is bound, which
# is a valid deployment: file operations refuse at the point of use.
VERITY_STORAGE_DRIVER=s3
VERITY_S3_BUCKET=verity-media
VERITY_S3_REGION=us-east-1
# Point at the bundled object store (VERITY_WITH_BUNDLED_STORAGE=1), or at AWS (leave blank), Ceph, Wasabi, B2, or a
# SeaweedFS S3 gateway. One adapter, different configuration.
VERITY_S3_ENDPOINT=http://objects:9000
VERITY_S3_ACCESS_KEY_ID=CHANGE_ME_S3_KEY
VERITY_S3_SECRET_ACCESS_KEY=CHANGE_ME_S3_SECRET
# Self-hosted servers are path-style; AWS is virtual-hosted. Getting it wrong
# yields SignatureDoesNotMatch, which reads exactly like a bad secret key.
VERITY_S3_FORCE_PATH_STYLE=true
# Whether install creates the bucket when it is missing: exactly true (default) or
# false. false means YOU own the bucket: install fails, creating nothing, if it does
# not exist. An existing bucket is never modified either way.
VERITY_STORAGE_CREATE_BUCKET=true

# Supabase Storage, when VERITY_STORAGE_DRIVER=supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=

# ── Observability (Task 40) ─────────────────────────────────────────────────
VERITY_SERVICE_NAME=verity
VERITY_VERSION=0.0.0-dev
# Set by deploy/scripts/install.sh from git. Two deployments of one version is
# a common situation; the commit is what tells them apart.
VERITY_COMMIT=
VERITY_ENVIRONMENT=production

# ── Scheduler (ADR-015/016) ─────────────────────────────────────────────────
# Authenticates POST /api/scheduled and GET /api/metrics. The packaged sidecar
# invokes frequent/hourly/daily/weekly work on UTC boundaries and retries
# transient failures with bounded exponential backoff and jitter.
CRON_SECRET=CHANGE_ME_CRON
VERITY_SCHEDULER_TIMEOUT_MS=300000
VERITY_SCHEDULER_MAX_ATTEMPTS=3

# ── Image ───────────────────────────────────────────────────────────────────
VERITY_IMAGE=verity:local
