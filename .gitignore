# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the placeholder-only template, which onboarding needs.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# Generated service worker (served by src/app/sw.js/route.ts)
public/sw.js
public/sw.js.map

tmp_backup_verity/


# Claude Code personal, machine-specific overrides (never shared)
.claude/settings.local.json

# Local environment notes (secrets; never shared)
.claude/env.txt

# PA-OMS real login credentials (real people's passwords; never committed)
pacreds.txt

# graphify: generated outputs and machine-specific scan state.
# The graph is reproducible from the corpus; these embed absolute local paths.
graphify-out/graph.json
graphify-out/graph.html
graphify-out/GRAPH_REPORT.md
graphify-out/.graphify_*
graphify-out/cache/

# Playwright
/test-results/
/playwright-report/
/e2e/.auth/
.mcp.json
tmp-010-envsync.mts
tmp-010-run.mts
tmp-010-smoke.mjs
tmp-010-inspect.mts

# Deployment package: generated credentials and dumps (Task 42).
# The example template is committed; the filled-in file never is.
deploy/config/verity.env
deploy/backups/

# Audit and browser-automation artefacts. Screenshots taken during a UI
# review are evidence for that review, not source, and a binary that changes
# every run makes every diff unreadable.
temporary screenshots/
.playwright-cli/
.env*.local

# Audit tenant B credentials, generated by npm run seed:audit-tenant.
# Real passwords: never commit.
.audit-tenant-b.local.md

# audit run artefacts (credentials, probes) — never commit
.audit-tenant-a.local.md
audit/_probe/

# k6 run artifacts: reference reproduced runs from the program docs, do not commit smoke output
/scripts/load/results/

# graphify intermediate extraction output (regenerated by graphify)
/graphify-out/staging/

# Task 123 seed-scale reports are per-run evidence; reproduced runs are cited from the program docs
/docs/enterprise-readiness/runs/
