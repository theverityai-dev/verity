// Verity Platform Foundation — Phase 0 baseline.
//
// Scope: the tenancy substrate only (Tenant, Organization) plus the base entity
// pattern every future capability inherits. No business capability is modelled here.
//
// Authority:
//   Bible V1        — Prisma/PostgreSQL is the system of record
//   Bible V5 §1     — tenant isolation is absolute; RLS at the engine level
//   ADR-005         — Tenant is the root data-isolation boundary;
//                     Organization is a nested business unit inside a Tenant
//   Spec PLA-TEN-001 — every operational table partitioned by tenant
//   Spec PLA-TEN-003 — no cross-tenant foreign keys
//   Spec PLA-ORG-001 — Organizations nest self-referentially
//
// Base entity pattern (implementation/02-foundation-build-order/bootstrap-sequence.md, step 7):
//   id, tenantId, createdAt, updatedAt, version, customFields
// `version` carries optimistic concurrency; `customFields` is the extension
// surface required by PLA-EXT-001 so capabilities extend entities without
// altering the platform ontology.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// The root data-isolation boundary — the client contract boundary (ADR-005).
/// A Tenant is not itself tenant-scoped, so it carries no `tenantId`.
model Tenant {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  /// IANA zone for reckoning local time. Null means UTC, stated explicitly
  /// rather than guessed — a wrong guess misplaces every deadline by the offset.
  timeZone     String?  @map("time_zone")
  /// True for the single Verity platform tenant whose members are HQ operators;
  /// never true for a client. D18 requires that "operator" and "tenant user" be
  /// distinguishable in code, in the UI and in audit, and a naming convention
  /// cannot answer an authority question (ADR-013).
  isPlatform   Boolean  @default(false) @map("is_platform")
  /// ADR-034 lifecycle: onboarding | active | suspended. Changed only by the HQ
  /// operator action (a database trigger refuses any other write). Suspended
  /// clients resolve to no membership for their own users; data is untouched.
  status          String    @default("active")
  statusReason    String?   @map("status_reason")
  statusChangedAt DateTime? @map("status_changed_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  version      Int      @default(1)
  customFields Json     @default("{}") @map("custom_fields")

  organizations           Organization[]
  memberships             TenantMembership[]
  roles                   Role[]
  permissions             Permission[]
  roleCompositions        RoleComposition[]
  customFieldSchemas      CustomFieldSchema[]
  domainEvents            DomainEvent[]
  statusLabels            TenantStatusLabel[]
  activities              Activity[]
  securityEvents          SecurityAuditEvent[]
  workflows               WorkflowDefinition[]
  workflowRuns            WorkflowRun[]
  credentials             Credential[]
  activations             TenantActivation[]
  configParameters        ConfigParameter[]
  offlineCommands         OfflineCommand[]
  syncExceptions          SyncException[]
  places                  Place[]
  addresses               Address[]
  locations               Location[]
  geofences               Geofence[]
  locationAssignments     LocationAssignment[]
  assets                  Asset[]
  evidence                Evidence[]
  resources               Resource[]
  resourceGroups          ResourceGroup[]
  resourceGroupMembers    ResourceGroupMember[]
  availabilityWindows     AvailabilityWindow[]
  bookings                Booking[]
  approvalRequests        ApprovalRequest[]
  approvalSteps           ApprovalStep[]
  businessCalendars       BusinessCalendar[]
  businessHours           BusinessHours[]
  businessHolidays        BusinessHoliday[]
  slaPolicies             SlaPolicy[]
  slaClocks               SlaClock[]
  storedFiles             StoredFile[]
  notificationTemplates   NotificationTemplate[]
  notificationPreferences NotificationPreference[]
  notifications           Notification[]
  packInstances           PackInstance[]
  packOperations          PackOperation[]
  packContributions       PackContribution[]
  packEvents              PackEvent[]
  capabilityUpgradeOperations CapabilityUpgradeOperation[]
  templateDefinitions     TemplateDefinition[]
  templateInstances       TemplateInstance[]

  // Capability: dine-in. Back-relations only — Prisma requires the opposite
  // side of every relation, so a capability's tables show up here whether or not
  // the platform cares about them. Nothing on this side is platform behaviour.
  menuCategories MenuCategory[]
  menuItems      MenuItem[]
  menuVariants   MenuItemVariant[]
  menuModifiers  MenuModifier[]
  menuAvailability MenuAvailability[]
  orderLineModifiers OrderLineModifier[]
  diningZones    DiningZone[]
  diningTables   DiningTable[]
  diningOrders   DiningOrder[]
  orderLines     OrderLine[]
  bills          Bill[]
  payments       Payment[]

  // Capability: plywood trading. Back-relations only, as above.
  tradingBrands                    TradingBrand[]
  tradingProducts                  TradingProduct[]
  godownRacks                      GodownRack[]
  stockLedger                      StockLedgerEntry[]
  stockBalances                    StockBalance[]
  tradingSuppliers                 TradingSupplier[]
  tradingSupplierPrices            TradingSupplierPrice[]
  tradingCustomers                 TradingCustomer[]
  tradingCustomerPrices            TradingCustomerPrice[]
  tradingPurchaseOrders            TradingPurchaseOrder[]
  tradingPurchaseOrderLines        TradingPurchaseOrderLine[]
  tradingSalesOrders               TradingSalesOrder[]
  tradingSalesOrderLines           TradingSalesOrderLine[]
  tradingStockReservations         TradingStockReservation[]
  tradingInvoiceSeries             TradingInvoiceSeries[]
  tradingAccountingPeriods         TradingAccountingPeriod[]
  tradingTaxRules                  TradingTaxRule[]
  tradingInvoiceNotes              TradingInvoiceNote[]
  tradingGoodsIssues               TradingGoodsIssue[]
  tradingGoodsIssueLines           TradingGoodsIssueLine[]
  tradingGoodsReceipts             TradingGoodsReceipt[]
  tradingGoodsReceiptLines         TradingGoodsReceiptLine[]
  tradingBusinessProfile           TradingBusinessProfile?
  tradingGstRegistrations          TradingGstRegistration[]
  tradingInvoices                  TradingInvoice[]
  tradingInvoiceLines              TradingInvoiceLine[]
  tradingPayments                  TradingPayment[]
  tradingLedgerEntries             TradingLedgerEntry[]
  tradingGstPortalRecords          TradingGstPortalRecord[]
  tradingPaymentAllocations        TradingPaymentAllocation[]
  tradingPurchaseBillConfirmations TradingPurchaseBillConfirmation[]
  tradingMetricSnapshots           TradingMetricSnapshot[]

  // Capability: accounting (Task 72). Back-relations only, as above.
  accounts       Account[]
  journalEntries JournalEntry[]
  journalLines   JournalLine[]

  // Capability: inventory (Task 73). Back-relations only, as above.
  inventoryItemGroups     InventoryItemGroup[]
  inventoryItems          InventoryItem[]
  inventoryStockBalances  InventoryStockBalance[]
  inventoryStockMovements InventoryStockMovement[]
  inventoryWastageRecords InventoryWastageRecord[]
  inventoryVendors             InventoryVendor[]
  inventoryStockRequests       InventoryStockRequest[]
  inventoryVendorPayments      InventoryVendorPayment[]
  billRefunds                  BillRefund[]
  inventoryPurchaseOrders      InventoryPurchaseOrder[]
  inventoryPurchaseOrderLines  InventoryPurchaseOrderLine[]
  inventoryGoodsReceipts       InventoryGoodsReceipt[]
  inventoryGoodsReceiptLines   InventoryGoodsReceiptLine[]

  // Capability: manufacturing (Task 118 minimal slice). Back-relations only.
  manufacturingOrders     ManufacturingOrder[]
  manufacturingOrderLines ManufacturingOrderLine[]
  manufacturingBoms       ManufacturingBom[]
  manufacturingBomLines   ManufacturingBomLine[]
  manufacturingRoutes     ManufacturingRoute[]
  manufacturingRouteStages ManufacturingRouteStage[]
  manufacturingOperations ManufacturingOperation[]
  manufacturingCheckpointResults ManufacturingCheckpointResult[]
  manufacturingPassports ManufacturingPassport[]
  manufacturingDispatches ManufacturingDispatch[]
  manufacturingBatches ManufacturingBatch[]
  manufacturingReservations ManufacturingReservation[]

  // Capability: recipe (Colonel Kebabz Phase 1). Back-relations only.
  recipes           Recipe[]
  recipeIngredients RecipeIngredient[]

  // Capability: CRM (Colonel Kebabz Phase 2). Back-relations only.
  customers          Customer[]
  customerSegments   CustomerSegment[]
  loyaltyPointEntries LoyaltyPointEntry[]
  coupons            Coupon[]
  complaints         Complaint[]
  attendanceRecords  AttendanceRecord[]
  shifts             Shift[]
  expenses           Expense[]
  cashReconciliations DailyCashReconciliation[]
  cashMovements      CashMovement[]

  // Capability: HR (Task 78). Back-relations only, as above.
  hrDepartments       HrDepartment[]
  hrEmployees         HrEmployee[]
  hrLeaveTypes        HrLeaveType[]
  hrLeaveApplications HrLeaveApplication[]
  hrLeaveDecisions    HrLeaveDecision[]

  // Capability: billing (Task 77). Back-relations only, as above.
  billingMeters         BillingMeter[]
  billingMeterReadings  BillingMeterReading[]
  billingPeriods        BillingPeriod[]
  billingInvoices       BillingInvoice[]
  plywoodProductDetails PlywoodProductDetail[]
  plywoodShades         PlywoodShade[]
  plywoodTextures       PlywoodTexture[]

  // Capability: outreach (Task 105). Back-relations only, as above.
  outreachTeams                 OutreachTeam[]
  outreachTeamMemberships       OutreachTeamMembership[]
  outreachLeads                 OutreachLead[]
  outreachActivities            OutreachActivity[]
  outreachContacts               OutreachContact[]
  outreachResearchEntries        OutreachResearchEntry[]
  outreachTasks                  OutreachTask[]
  outreachMeetings               OutreachMeeting[]
  outreachCheckInReviews         OutreachCheckInReview[]
  outreachCoachingNotes          OutreachCoachingNote[]
  outreachAiInsights    OutreachAiInsight[]
  outreachTargets               OutreachTarget[]
  outreachCheckIns              OutreachCheckIn[]
  outreachWeeklyReports         OutreachWeeklyReport[]
  outreachTeamWeeklyAssessments OutreachTeamWeeklyAssessment[]
  outreachDirections            OutreachDirection[]
  outreachDomainGroups          OutreachDomainGroup[]
  outreachDomains               OutreachDomain[]
  outreachAttributionRecords    OutreachAttributionRecord[]
  outreachEscalations           OutreachEscalation[]
  outreachOpportunities         OutreachOpportunity[]
  outreachProposals             OutreachProposal[]
  outreachClosedClients         OutreachClosedClient[]
  outreachAssignments           OutreachAssignment[]
  externalApiKeys               ExternalApiKey[]
  externalIdempotency           ExternalIdempotency[]

  @@map("tenant")
}

/// A functional, legal, or regional node inside a Tenant (ADR-005, PLA-ORG-001).
/// Nests self-referentially: Holdings -> Region -> Branch -> Site Office.
model Organization {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  parentId     String?  @map("parent_id") @db.Uuid
  name         String
  /// Overrides the tenant zone for this branch. A portfolio genuinely spans
  /// zones, and a regional manager reads times in the site's local clock.
  timeZone     String?  @map("time_zone")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  version      Int      @default(1)
  customFields Json     @default("{}") @map("custom_fields")

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // PLA-TEN-003: the parent link is keyed on (tenantId, parentId) rather than
  // parentId alone, so the database itself refuses a cross-tenant parent.
  parent      Organization?      @relation("OrganizationHierarchy", fields: [tenantId, parentId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  children    Organization[]     @relation("OrganizationHierarchy")
  memberships TenantMembership[]
  locations   Location[]

  @@unique([tenantId, id], name: "organization_tenant_scoped_id")
  @@index([tenantId])
  @@index([tenantId, parentId])
  @@map("organization")
}

/// Party lifecycle (Authority: Bible V2 Primitive 2 §3-§5, ADR-001).
/// ADR-001 keeps these platform-level only: capability-specific lifecycles
/// (CRM `Prospect`, Workforce `Employee`) belong inside those capabilities and
/// map back to this primitive, they do not extend it.
enum PartyState {
  Invited
  Active
  Suspended
  Archived
}

/// The single canonical record for any human or corporate participant.
///
/// GLOBAL, not tenant-scoped. Authority: Bible V2 Primitive 2 §2 — "Scoped
/// globally to the Platform database, mapped to Organizations via
/// TenantMembership records" — and INV-003, which requires exactly one Party
/// per person across the whole platform even when they work for many tenants
/// (PLA-IDE-004, the subcontractor case). A `tenantId` column here would force
/// one row per tenant and break INV-003.
///
/// Visibility is therefore not a tenant column but reachability: a tenant sees
/// a Party only if that Party's User holds a TenantMembership in it. See the
/// RLS policies in the migration.
///
/// No address field: ADR-004 makes Address a distinct concept from Party and
/// forbids folding mailing details into another primitive.
model Party {
  id           String     @id @default(uuid()) @db.Uuid
  /// Human or corporate participant, so the label is a single display name;
  /// given/family names are optional and only meaningful for humans.
  displayName  String     @map("display_name")
  givenName    String?    @map("given_name")
  familyName   String?    @map("family_name")
  /// Bible V2 Primitive 2 §8: identity evidence is a verified email or phone.
  email        String?
  phone        String?
  state        PartyState @default(Invited)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  version      Int        @default(1)
  customFields Json       @default("{}") @map("custom_fields")

  user          User?
  resources     Resource[]
  // Capability: HR (Task 78). Back-relation only, as above.
  hrEmployees   HrEmployee[]
  // Capability: billing (Task 77). Back-relation only, as above.
  billingMeters BillingMeter[]

  @@index([email])
  @@index([phone])
  @@map("party")
}

/// The authenticating actor. GLOBAL, for the same reason as Party.
///
/// 1:1 with Party (GOV-TER-006, INV-003). Bible V2 Primitive 2 §1 describes
/// User as storing "credentials and passwords"; authentication is offloaded to
/// Supabase Auth (Authority: EXISTING INFRASTRUCTURE, and
/// implementation/03-platform-foundation/identity.md), so no credential
/// material is stored here — `authUserId` references the Supabase `auth.users`
/// row. Keeping a second credential store would duplicate the source of truth.
model User {
  id           String   @id @default(uuid()) @db.Uuid
  /// Supabase Auth user id. Single global realm (Bible V5 §1.A.4).
  authUserId   String   @unique @map("auth_user_id") @db.Uuid
  partyId      String   @unique @map("party_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  version      Int      @default(1)
  customFields Json     @default("{}") @map("custom_fields")

  party                   Party                    @relation(fields: [partyId], references: [id], onDelete: Restrict)
  memberships             TenantMembership[]
  locationAssignments     LocationAssignment[]
  notificationPreferences NotificationPreference[]
  notifications           Notification[]

  @@map("user")
}

/// Binds a global User into one Organization inside one Tenant.
///
/// Authority: Bible V2 Primitive 2 §2 and §13 (authorization is defined at the
/// membership level), Bible V5 §1.A.4 (one identity, distinct memberships per
/// tenant), Spec PLA-IDE-002, implementation/03-platform-foundation/membership.md.
///
/// This IS tenant-scoped and carries the RLS boundary. `roleId` is specified by
/// the handoff but deferred: Role belongs to the authorization step and does not
/// exist yet, and inventing it here would pre-empt that design.
model TenantMembership {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  roleId         String?  @map("role_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  version        Int      @default(1)
  customFields   Json     @default("{}") @map("custom_fields")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // PLA-TEN-003 again: keyed on (tenantId, organizationId) so the database
  // refuses a membership pointing at another tenant's Organization.
  organization Organization @relation(fields: [tenantId, organizationId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)
  // Nullable on purpose: a membership with no Role grants nothing, so an
  // unassigned membership fails closed instead of defaulting to access.
  // Restrict, not SetNull: a composite key cannot null `tenantId`, and a Role
  // must not vanish from under a live membership — reassign first.
  role         Role?        @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([userId, organizationId])
  @@index([tenantId])
  apiKeys ExternalApiKey[]

  @@index([userId])
  @@map("tenant_membership")
}

/// Permission verbs (Authority: Spec PLA-AUT-003).
/// A closed set: a bespoke capability action is expressed as `ActionExecute`
/// against a named entity, so a new capability never needs a new verb.
enum PermissionVerb {
  Read
  Create
  Edit
  Delete
  ActionExecute
}

/// Permission scope levels (Authority: Spec PLA-AUT-002, refining Bible V2
/// Primitive 2 §13, which lists Global/Tenant/Site; the spec adds Organization,
/// which ADR-005 requires as a real nesting level inside a Tenant).
///
/// `Global` means cross-tenant platform administration. It is defined because the
/// specification defines it, but nothing here grants it: honouring it would mean
/// bypassing the RLS that enforces INV-001, and that security decision has not
/// been made. `resolvePermissions` refuses to return Global grants.
enum PermissionScope {
  Global
  Tenant
  Organization
  Location
}

/// A named bundle of permissions inside one Tenant (Authority: Spec PLA-AUT-001).
model Role {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  name         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  version      Int      @default(1)
  customFields Json     @default("{}") @map("custom_fields")

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions   Permission[]
  memberships   TenantMembership[]
  /// Compositions where this Role is the parent — it inherits from the child.
  approvalSteps ApprovalStep[]
  parentOf      RoleComposition[]  @relation("RoleCompositionParent")
  /// Compositions where this Role is the child — its permissions flow upward.
  childOf       RoleComposition[]  @relation("RoleCompositionChild")

  @@unique([tenantId, name])
  @@unique([tenantId, id], name: "role_tenant_scoped_id")
  @@index([tenantId])
  @@map("role")
}

/// Composite-role edge (Authority: Spec PLA-AUT-001; Bible Synthesis ADOPTED —
/// Keycloak composite roles). A parent Role inherits every permission held by its
/// child Roles, flattened at runtime.
///
/// The spec names this `RoleComposition`; the handoff calls it `RoleInheritance`.
/// The spec outranks the handoff.
model RoleComposition {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  parentRoleId String   @map("parent_role_id") @db.Uuid
  childRoleId  String   @map("child_role_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parentRole Role   @relation("RoleCompositionParent", fields: [tenantId, parentRoleId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)
  childRole  Role   @relation("RoleCompositionChild", fields: [tenantId, childRoleId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([parentRoleId, childRoleId])
  @@index([tenantId])
  @@map("role_composition")
}

/// A single grant: Verb + Entity + Scope (Authority: implementation handoff
/// 03-platform-foundation/authorization.md; Spec PLA-AUT-003).
///
/// `entity` is a free string rather than an enum, deliberately: a new capability
/// must introduce entities without altering the platform ontology.
model Permission {
  id        String          @id @default(uuid()) @db.Uuid
  tenantId  String          @map("tenant_id") @db.Uuid
  roleId    String          @map("role_id") @db.Uuid
  verb      PermissionVerb
  entity    String
  scope     PermissionScope
  createdAt DateTime        @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([roleId, verb, entity, scope])
  @@index([tenantId])
  @@index([roleId])
  @@map("permission")
}

/// Entity structural classes (Authority: Spec MET-ENT-001→003).
enum EntityClass {
  /// Permanent business record backed by a physical table.
  Persistent
  /// Session-scoped temporary state; emits no state events (MET-ENT-002).
  Transient
  /// Interface/mixin template; no table of its own (MET-ENT-003).
  Abstract
}

/// Custom field types (Authority: Spec PLA-EXT-002, which fixes exactly this set).
enum CustomFieldType {
  String
  Number
  Boolean
  Select
  Date
}

/// The entity registry (Authority: Spec MET-ENT-001→005).
///
/// GLOBAL, not tenant-scoped. An entity definition describes a *type*, is
/// identical for every tenant, and is written by migrations when a capability is
/// installed — it is platform metadata of the kind PLA-TEN-001 exempts from
/// tenant partitioning ("global system lists"). Tenant-specific shape lives in
/// `CustomFieldSchema` instead.
///
/// A capability ships its own tables and registers them here; the platform does
/// not generate tables at runtime. That is what lets a new capability introduce
/// entities without the platform ontology changing (foundation-ready B).
model EntityDefinition {
  /// Namespace-qualified unique key, e.g. `verity.work.work_order` (MET-ENT-004).
  key          String      @id
  /// Owning capability. Every entity has exactly one owner.
  capability   String
  class        EntityClass
  /// Physical table for a Persistent entity; null for Transient/Abstract.
  tableName    String?     @map("table_name")
  /// False only for platform-wide system reference data (MET-ENT-005).
  tenantScoped Boolean     @default(true) @map("tenant_scoped")
  createdAt    DateTime    @default(now()) @map("created_at")

  customFields     CustomFieldSchema[]
  states           StateDefinition[]
  fieldPermissions FieldPermission[]

  @@index([capability])
  @@map("entity_definition")
}

/// Tenant-declared extension fields (Authority: Spec PLA-EXT-002).
///
/// Tenant-scoped, unlike EntityDefinition: these are one tenant's additions to an
/// entity, stored in that entity's `custom_fields` JSONB column (PLA-EXT-001) so
/// the relational core schema stays intact and no migration is needed to add one.
model CustomFieldSchema {
  id            String          @id @default(uuid()) @db.Uuid
  tenantId      String          @map("tenant_id") @db.Uuid
  /// FK to EntityDefinition.key — the entity being extended.
  entityKey     String          @map("entity_key")
  fieldName     String          @map("field_name")
  fieldType     CustomFieldType @map("field_type")
  required      Boolean         @default(false)
  /// Only meaningful when fieldType is Select.
  selectOptions String[]        @default([]) @map("select_options")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entity EntityDefinition @relation(fields: [entityKey], references: [key], onDelete: Cascade)

  @@unique([tenantId, entityKey, fieldName])
  @@index([tenantId, entityKey])
  @@map("custom_field_schema")
}

/// Transactional event outbox (Authority: Spec MET-ACT-004, MET-EVE-001→002).
///
/// An Event is a fact: something happened. Rows are written inside the same
/// transaction as the mutation that produced them, which is what makes
/// MET-ACT-004's "events must never be emitted if the transaction rolls back"
/// structurally true rather than a convention a caller could forget.
///
/// Immutable: RLS grants INSERT and SELECT only, so a delivered event cannot be
/// rewritten or deleted by the application. Delivery marking is performed by the
/// dispatcher role.
model DomainEvent {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  /// Namespace-qualified event name, e.g. `verity.party.suspended`.
  name          String
  /// The entity the fact concerns (EntityDefinition.key).
  entityKey     String    @map("entity_key")
  entityId      String?   @map("entity_id") @db.Uuid
  /// The command that produced it, for traceability back to the action.
  commandKey    String?   @map("command_key")
  /// Actor at the time of the fact; null for platform-initiated events.
  actorUserId   String?   @map("actor_user_id") @db.Uuid
  payload       Json      @default("{}")
  /// Groups everything produced by one command execution (Task 38). Written by
  /// `executeCommand`; null only for a fact recorded outside a command.
  correlationId String?   @map("correlation_id") @db.Uuid
  /// Which kind of actor produced it: human, api, job, agent. Text, not an
  /// enum — the set will grow (Phase 9 distinguishes kinds of agent) and an
  /// enum change is a migration against an append-only table.
  source        String?   @map("source")
  occurredAt    DateTime  @default(now()) @map("occurred_at")
  /// Set by the dispatcher once delivered; null means pending.
  deliveredAt   DateTime? @map("delivered_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, occurredAt])
  @@index([deliveredAt])
  @@map("domain_event")
}

/// Platform state categories (Authority: Spec MET-STA-001, MET-STA-004).
///
/// MET-STA-001 calls the categories "fixed, platform-level enums" but illustrates
/// them with Work-domain values (`EN_ROUTE`, `SCHEDULING`). Those are the Work
/// capability's *states*, not platform categories — hardcoding them into the core
/// would be the same domain leakage the no-legacy policy forbids and would make
/// the platform field-service specific.
///
/// The fixed set below is therefore behavioural, not domain: it says what the
/// engine must do, which is exactly what MET-STA-004 needs when it evaluates SLA
/// clocks "strictly at the system StateCategory layer".
///
///   Draft     — not yet started; no SLA clock
///   Pending   — waiting on something external; clock paused
///   Active    — work is happening; clock running
///   Blocked   — halted by an exception; clock paused
///   Completed — terminal, succeeded; clock stopped
///   Cancelled — terminal, abandoned; clock stopped
///
/// IMPLEMENTATION DECISION: the specification mandates that categories exist and
/// fixes their engine meaning, but does not enumerate a domain-neutral set. This
/// set is inferred from MET-STA-004's clock semantics and needs ratification.
enum StateCategory {
  Draft
  Pending
  Active
  Blocked
  Completed
  Cancelled
}

/// One state in an entity's lifecycle (Authority: Spec MET-STA-001, MET-STA-003).
///
/// GLOBAL, like EntityDefinition: a lifecycle belongs to the capability that owns
/// the entity and is identical for every tenant. Tenants rename states via
/// TenantStatusLabel; they do not add or remove them.
model StateDefinition {
  id         String        @id @default(uuid()) @db.Uuid
  entityKey  String        @map("entity_key")
  /// Stable machine key, e.g. `in_progress`.
  key        String
  /// Mandatory category binding (MET-STA-003).
  category   StateCategory
  /// Exactly one initial state per entity.
  isInitial  Boolean       @default(false) @map("is_initial")
  /// Terminal states lock the entity (INV-002).
  isTerminal Boolean       @default(false) @map("is_terminal")

  entity          EntityDefinition       @relation(fields: [entityKey], references: [key], onDelete: Cascade)
  fromTransitions TransitionDefinition[] @relation("TransitionFrom")
  toTransitions   TransitionDefinition[] @relation("TransitionTo")
  labels          TenantStatusLabel[]

  @@unique([entityKey, key])
  @@index([entityKey])
  @@map("state_definition")
}

/// An allowed movement between two states (Authority: Spec MET-TRA-001).
///
/// The structural guard is this table: a transition that is not declared here
/// cannot happen, so `Completed -> Draft` is blocked by absence rather than by a
/// check somebody has to remember to write.
model TransitionDefinition {
  id          String  @id @default(uuid()) @db.Uuid
  entityKey   String  @map("entity_key")
  fromStateId String  @map("from_state_id") @db.Uuid
  toStateId   String  @map("to_state_id") @db.Uuid
  /// The Action permitted to trigger it; the authorization guard (MET-TRA-002)
  /// is the command pipeline's own check on this command.
  commandKey  String? @map("command_key")

  fromState StateDefinition @relation("TransitionFrom", fields: [fromStateId], references: [id], onDelete: Cascade)
  toState   StateDefinition @relation("TransitionTo", fields: [toStateId], references: [id], onDelete: Cascade)

  @@unique([fromStateId, toStateId])
  @@index([entityKey])
  @@map("transition_definition")
}

/// Tenant-facing label for a platform state (Authority: Spec MET-STA-002/003).
///
/// Tenant-scoped: "Awaiting Gate Pass" is one tenant's word for a state whose
/// category the engine still reasons about unchanged (MET-STA-004).
model TenantStatusLabel {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  stateId  String @map("state_id") @db.Uuid
  label    String

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  state  StateDefinition @relation(fields: [stateId], references: [id], onDelete: Cascade)

  @@unique([tenantId, stateId])
  @@index([tenantId])
  @@map("tenant_status_label")
}

/// Operational audit stream (Authority: Spec EXE-AUD-001, GOV-TER "Activity").
///
/// EXE-AUD-001 names the table `WorkOrderActivity` with a `work_order_id` FK.
/// That is domain leakage: the platform cannot own a table keyed to one
/// capability's entity, and GOV-TER already reserves `Activity` as the canonical
/// term for a change record. The generic form keys on (entityKey, entityId), so
/// every capability's changes land in one stream without the core knowing any of
/// them.
///
/// Retention is infinite (EXE-AUD-001: required for contract disputes and
/// historical SLAs), and rows are immutable at the database level (EXE-AUD-003).
model Activity {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  entityKey     String   @map("entity_key")
  entityId      String   @map("entity_id") @db.Uuid
  /// Null for platform-initiated changes with no human actor.
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  fieldChanged  String   @map("field_changed")
  oldValue      String?  @map("old_value")
  newValue      String?  @map("new_value")
  /// The command responsible, so a change traces back to the action.
  commandKey    String?  @map("command_key")
  /// Groups every row written by one command execution (Task 38), across the
  /// activity, domain_event and security_audit_event streams.
  correlationId String?  @map("correlation_id") @db.Uuid
  /// human | api | job | agent — the channel the mutation arrived through.
  source        String?  @map("source")
  occurredAt    DateTime @default(now()) @map("occurred_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, entityKey, entityId])
  @@index([tenantId, occurredAt])
  @@index([tenantId, correlationId])
  @@map("activity")
}

/// Security audit event types (Authority: Spec EXE-AUD-002).
enum SecurityEventType {
  AuthSuccess
  AuthFailed
  /// An authenticated principal was refused a privileged surface. Distinct from
  /// AuthFailed, which is a failure to prove identity — merging the two would
  /// make "someone is probing HQ" and "someone mistyped a password" the same
  /// signal (ADR-013 answer 11, D18).
  AuthorizationDenied
  PermissionEscalated
  PermissionRevoked
  RoleAssigned
  ConfigurationChanged
  ApiKeyGenerated
}

/// Security audit stream (Authority: Spec EXE-AUD-002).
///
/// Separate from Activity because its retention is compliance-driven rather than
/// infinite, and because mixing authentication and permission changes into the
/// operational stream makes both harder to reason about.
///
/// `tenantId` is required: an event that concerns no tenant cannot be shown to
/// one without leaking across the boundary. Pre-authentication failures, which
/// have no tenant yet, belong to platform operations and are out of scope until
/// the auth layer exists.
model SecurityAuditEvent {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  eventType     SecurityEventType @map("event_type")
  actorUserId   String?           @map("actor_user_id") @db.Uuid
  /// Recorded as text: it is evidence, not a queryable address type.
  ipAddress     String?           @map("ip_address")
  payload       Json              @default("{}")
  /// Ties a security event to the request that caused it (Task 38).
  correlationId String?           @map("correlation_id") @db.Uuid
  occurredAt    DateTime          @default(now()) @map("occurred_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, occurredAt])
  @@index([tenantId, eventType])
  @@map("security_audit_event")
}

/// Automation node categories (Authority: Spec MET-AUT-001).
enum WorkflowNodeType {
  /// Listens for a platform Event, schedule, or webhook and starts a run.
  Trigger
  /// Executes an integration or mutates an entity.
  Action
  /// Directs flow: conditionals, branching, joins.
  Logic
}

enum WorkflowRunStatus {
  Running
  Succeeded
  Failed
}

/// An orchestrated business process (Authority: Spec MET-WKF-001→003, MET-AUT-001).
///
/// Tenant-scoped and stored as data, not code. The engine knows how to walk a
/// DAG and how to run a *node type*; it knows nothing about any particular
/// workflow. That is what lets a new workflow be introduced without the engine
/// changing — foundation-ready condition C.
model WorkflowDefinition {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  /// Bumped when the graph changes; a run records the version it executed.
  version   Int      @default(1)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nodes  WorkflowNode[]
  edges  WorkflowEdge[]
  runs   WorkflowRun[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("workflow_definition")
}

/// One node in the graph (Authority: Spec MET-AUT-001).
///
/// `handlerKey` names a node type registered in code. The node's behaviour lives
/// there; `config` is its data. A capability adds capabilities by registering a
/// handler, never by editing the executor.
model WorkflowNode {
  id         String           @id @default(uuid()) @db.Uuid
  tenantId   String           @map("tenant_id") @db.Uuid
  workflowId String           @map("workflow_id") @db.Uuid
  key        String
  type       WorkflowNodeType
  /// Registered node-type key, e.g. `verity.core.emit_event`.
  handlerKey String           @map("handler_key")
  config     Json             @default("{}")

  workflow WorkflowDefinition @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  outgoing WorkflowEdge[]     @relation("EdgeFrom")
  incoming WorkflowEdge[]     @relation("EdgeTo")
  stepRuns WorkflowStepRun[]

  @@unique([workflowId, key])
  @@index([tenantId])
  @@map("workflow_node")
}

/// A directed edge, optionally conditional (Authority: Spec MET-WKF-002).
///
/// `condition` is a declarative predicate over the envelope, not code: routing
/// decisions are data so a tenant can change a threshold without a deploy.
model WorkflowEdge {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  workflowId String @map("workflow_id") @db.Uuid
  fromNodeId String @map("from_node_id") @db.Uuid
  toNodeId   String @map("to_node_id") @db.Uuid
  /// null means unconditional.
  condition  Json?

  workflow WorkflowDefinition @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  fromNode WorkflowNode       @relation("EdgeFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode   WorkflowNode       @relation("EdgeTo", fields: [toNodeId], references: [id], onDelete: Cascade)

  @@unique([fromNodeId, toNodeId])
  @@index([tenantId])
  @@map("workflow_edge")
}

/// One execution of a workflow.
model WorkflowRun {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  workflowId      String            @map("workflow_id") @db.Uuid
  workflowVersion Int               @map("workflow_version")
  status          WorkflowRunStatus @default(Running)
  /// Deduplication key: the same trigger fact must not start two runs.
  idempotencyKey  String?           @map("idempotency_key")
  triggerEventId  String?           @map("trigger_event_id") @db.Uuid
  input           Json              @default("{}")
  error           String?
  startedAt       DateTime          @default(now()) @map("started_at")
  finishedAt      DateTime?         @map("finished_at")

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow WorkflowDefinition @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  steps    WorkflowStepRun[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status])
  @@map("workflow_run")
}

/// One node execution within a run (Authority: Spec MET-WKF-001).
///
/// Each step is its own transaction boundary, and its output envelope is
/// recorded so a failed run can be inspected without re-running it.
model WorkflowStepRun {
  id         String            @id @default(uuid()) @db.Uuid
  tenantId   String            @map("tenant_id") @db.Uuid
  runId      String            @map("run_id") @db.Uuid
  nodeId     String            @map("node_id") @db.Uuid
  sequence   Int
  status     WorkflowRunStatus @default(Running)
  output     Json              @default("{}")
  error      String?
  startedAt  DateTime          @default(now()) @map("started_at")
  finishedAt DateTime?         @map("finished_at")

  run  WorkflowRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  node WorkflowNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([runId, sequence])
  @@map("workflow_step_run")
}

/// Encrypted third-party secrets (Authority: Spec MET-AUT-003).
///
/// Automations reference a credential by name; the ciphertext is decrypted only
/// at execution time inside the action node. The secret never appears in a
/// workflow's JSON configuration, so exporting or logging a workflow cannot leak
/// it.
model Credential {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  /// pgcrypto ciphertext. Never selected into application memory except by
  /// verity.credential_reveal() at execution time.
  secret    Bytes
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("credential")
}

enum ActivationStatus {
  Active
  Suspended
}

/// Configuration precedence scopes (Authority: Spec PLA-CFG-001).
/// Narrowest wins: User > Organization > Tenant > Global.
enum ConfigScope {
  Global
  Tenant
  Organization
  User
}

/// The capability registry (Authority: Spec PLA-CAP-001, PLA-VER-002).
///
/// GLOBAL, like EntityDefinition: a capability's identity, version and
/// dependencies are platform facts, written when the capability is installed.
/// Which tenants may use it is a separate, tenant-scoped question answered by
/// TenantActivation.
model CapabilityDefinition {
  id           String   @id
  name         String
  /// SemVer of the capability's logic (PLA-VER-002).
  version      String
  /// Capability ids this one requires (PLA-CAP-003).
  dependencies String[] @default([])
  /// EntityDefinition keys this capability owns.
  entityTypes  String[] @default([]) @map("entity_types")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  activations TenantActivation[]
  upgradeOperations CapabilityUpgradeOperation[]

  @@map("capability_definition")
}

enum CapabilityUpgradeState {
  Planned
  Preflighted
  Applying
  Verifying
  Completed
  Failed
  RolledBack
}

/// Durable per-tenant capability version-upgrade lifecycle (Authority: Task
/// 108 WP-11A, VCA-008). `TenantActivation.pinnedVersion` is the enforced
/// contract (ADR-021); this is the audited state machine that walks it
/// forward, one operation per attempt, so an upgrade failure can never
/// silently strand a tenant in a false "Active at the new version" state.
///
/// `reversible` is asserted by the operator at plan time, never inferred:
/// this codebase ships one deployed artifact per capability (ADR-021's
/// "honest single-artifact model"), so whether the OLD contract can still be
/// served after the code moved on is a judgement about the deployment, not
/// something the platform can verify from the version string alone.
model CapabilityUpgradeOperation {
  id               String                  @id @default(uuid()) @db.Uuid
  tenantId         String                  @map("tenant_id") @db.Uuid
  capabilityId     String                  @map("capability_id")
  kind             String                  @default("Upgrade")
  fromVersion      String?                 @map("from_version")
  toVersion        String                  @map("to_version")
  state            CapabilityUpgradeState  @default(Planned)
  reversible       Boolean                 @default(false)
  diff             Json                    @default("{}")
  error            String?
  approvedByUserId String?                 @map("approved_by_user_id") @db.Uuid
  correlationId    String?                 @map("correlation_id") @db.Uuid
  startedAt        DateTime                @default(now()) @map("started_at")
  completedAt      DateTime?               @map("completed_at")

  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  capability CapabilityDefinition @relation(fields: [capabilityId], references: [id], onDelete: Restrict)

  @@index([tenantId, capabilityId, startedAt])
  @@map("capability_upgrade_operation")
}

/// Per-tenant activation (Authority: Spec PLA-CAP-002, PLA-CAP-003).
///
/// An inactive capability is fully blocked for that tenant — not merely hidden
/// in the UI. Enforcement lives in the command and query pipelines, because a
/// capability that is invisible but still reachable by API is not deactivated.
model TenantActivation {
  id            String           @id @default(uuid()) @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  capabilityId  String           @map("capability_id")
  status        ActivationStatus @default(Active)
  activatedAt   DateTime         @default(now()) @map("activated_at")
  /// Version pinned at activation (PLA-VER-003), so a platform upgrade cannot
  /// silently change a tenant's behaviour.
  pinnedVersion String?          @map("pinned_version")

  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  capability CapabilityDefinition @relation(fields: [capabilityId], references: [id], onDelete: Restrict)

  @@unique([tenantId, capabilityId])
  @@index([tenantId])
  @@map("tenant_activation")
}

/// Industry Pack control plane (Authority: Task 108 WP-10, VCA-007; ADR-022 for
/// the signed manifest trust boundary this stores).
///
/// A pack release is GLOBAL, like CapabilityDefinition — the signed artifact's
/// identity is a platform fact, written once when the release is imported and
/// trusted. Which tenants run it, and what state that run is in, is answered by
/// PackInstance/PackOperation below.
model PackRelease {
  id            String   @id @default(uuid()) @db.Uuid
  key           String
  version       String
  /// `sha256:<hex>` of the canonicalized manifest (`packManifestDigest`).
  digest        String   @unique
  manifest      Json
  publisher     String
  keyId         String   @map("key_id")
  platformRange String   @map("platform_range")
  importedAt    DateTime @default(now()) @map("imported_at")

  desiredByInstances PackInstance[]  @relation("PackInstanceDesired")
  appliedByInstances PackInstance[]  @relation("PackInstanceApplied")
  operations         PackOperation[]

  @@unique([key, version])
  @@index([key])
  @@map("pack_release")
}

enum PackInstanceState {
  /// No approved apply has ever completed for this tenant/pack pair.
  Absent
  Applying
  Active
  Suspended
  Failed
  /// An upgrade failed past its reversible boundary; only restore or a forward
  /// fix may clear this state (WP-11A rollback contract).
  RollbackRequired
}

/// One tenant's relationship to one pack key (Authority: WP-10 data model).
model PackInstance {
  id               String            @id @default(uuid()) @db.Uuid
  tenantId         String            @map("tenant_id") @db.Uuid
  packKey          String            @map("pack_key")
  desiredReleaseId String?           @map("desired_release_id") @db.Uuid
  appliedReleaseId String?           @map("applied_release_id") @db.Uuid
  state            PackInstanceState @default(Absent)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  desiredRelease PackRelease?       @relation("PackInstanceDesired", fields: [desiredReleaseId], references: [id])
  appliedRelease PackRelease?       @relation("PackInstanceApplied", fields: [appliedReleaseId], references: [id])
  operations     PackOperation[]
  contributions  PackContribution[]
  events         PackEvent[]

  @@unique([tenantId, packKey])
  @@index([tenantId])
  @@map("pack_instance")
}

enum PackOperationKind {
  Preview
  Apply
  Reapply
  Upgrade
  Rollback
  Remove
}

enum PackOperationState {
  Planned
  Preflighted
  Applying
  Verifying
  Completed
  Failed
  RolledBack
}

/// Immutable plan/execution record for one lifecycle transition (Authority:
/// WP-10 §"Data model concepts" — `PackOperation`).
model PackOperation {
  id               String              @id @default(uuid()) @db.Uuid
  tenantId         String              @map("tenant_id") @db.Uuid
  instanceId       String              @map("instance_id") @db.Uuid
  releaseId        String              @map("release_id") @db.Uuid
  kind             PackOperationKind
  state            PackOperationState  @default(Planned)
  /// Digest of the deterministic preview diff this operation was approved
  /// against (WP-10 §Lifecycle "Approve"), so apply cannot silently apply a
  /// different plan than the one an operator reviewed.
  planHash         String              @map("plan_hash")
  diff             Json                @default("{}")
  error            String?
  approvedByUserId String?             @map("approved_by_user_id") @db.Uuid
  correlationId    String?             @map("correlation_id") @db.Uuid
  startedAt        DateTime            @default(now()) @map("started_at")
  completedAt      DateTime?           @map("completed_at")

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  instance PackInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  release  PackRelease  @relation(fields: [releaseId], references: [id], onDelete: Restrict)

  @@index([tenantId, instanceId])
  @@map("pack_operation")
}

/// Applied contribution provenance, by stable ID (Authority: WP-10
/// `PackContribution`). Dashboard/form/document/checklist/workflow/navigation
/// *execution* is WP-11B's registry; this table only records which pack owns
/// which stable contribution ID, for ownership and removal-safety checks.
model PackContribution {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  instanceId      String   @map("instance_id") @db.Uuid
  contributionId  String   @map("contribution_id")
  kind            String
  ownerCapability String?  @map("owner_capability")
  config          Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at")

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  instance PackInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@unique([tenantId, contributionId])
  @@index([tenantId, instanceId])
  @@map("pack_contribution")
}

/// Append-only pack lifecycle ledger (Authority: WP-10 §"Data model concepts").
/// Separate from Activity/SecurityAuditEvent because pack events are neither a
/// generic entity field change nor a security stream row — they are the audit
/// trail for a control-plane operation with its own retention shape.
model PackEvent {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  instanceId    String   @map("instance_id") @db.Uuid
  operationId   String?  @map("operation_id") @db.Uuid
  eventType     String   @map("event_type")
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  payload       Json     @default("{}")
  correlationId String?  @map("correlation_id") @db.Uuid
  occurredAt    DateTime @default(now()) @map("occurred_at")

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  instance PackInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([tenantId, instanceId, occurredAt])
  @@map("pack_event")
}

enum TemplateKind {
  Form
  Document
  Checklist
}

/// Versioned template registry (Authority: Task 108 WP-11B, VCA-009,
/// §"Dynamic forms and configuration" + §"Document and checklist templates").
/// One row per version — never edited in place, so an in-flight
/// `TemplateInstance` keeps an immutable reference to the exact version it
/// was created against (WP-11B §"immutable reference to the template
/// version used").
///
/// `schema` is interpreted per `kind`:
///   Form       — `{ fields: [{ key, label, type, required, options? }] }`,
///                `type` matching `CustomFieldType` so a form field and a
///                custom field never diverge in vocabulary.
///   Document   — `{ body: string, placeholders: string[] }`; `body` may
///                reference only keys in `placeholders`, substituted
///                literally at render — no expression language (WP-11B
///                §"no arbitrary expression or server execution").
///   Checklist  — `{ steps: [{ key, label }] }`.
model TemplateDefinition {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  /// Stable identity across versions — matches a `PackContribution.contributionId`
  /// when owned by a pack/extension, but is not required to (a tenant may
  /// also author its own templates directly).
  contributionId String       @map("contribution_id")
  kind           TemplateKind
  version        Int          @default(1)
  name           String
  schema         Json
  ownerCapability String?     @map("owner_capability")
  createdAt      DateTime     @default(now()) @map("created_at")

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  instances TemplateInstance[]

  @@unique([tenantId, contributionId, version])
  @@index([tenantId, contributionId])
  @@map("template_definition")
}

/// One rendered/submitted instance, pinned to the exact `TemplateDefinition`
/// version used (WP-11B §"immutable reference to the template version").
/// `status` and `data` shape follow `kind`:
///   Form/Document — `data` holds submitted field/placeholder values;
///                   `status` is `Draft` or `Submitted`.
///   Checklist     — `data` holds `{ steps: { [key]: { completed,
///                   completedByPartyId, completedAt, evidenceNote } } }`;
///                   `status` is `InProgress` or `Completed`.
model TemplateInstance {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  definitionId   String   @map("definition_id") @db.Uuid
  /// Optional anchor to the record this instance belongs to (e.g. a Work
  /// order's inspection checklist). Free string + uuid, like `Activity`'s
  /// `entityKey`/`entityId` — not a hard FK, since the anchored entity can be
  /// any capability's table.
  entityKey      String?  @map("entity_key")
  entityId       String?  @map("entity_id") @db.Uuid
  status         String   @default("Draft")
  data           Json     @default("{}")
  submittedByPartyId String? @map("submitted_by_party_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  definition TemplateDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)

  @@index([tenantId, definitionId])
  @@index([tenantId, entityKey, entityId])
  @@map("template_instance")
}

/// Replay ledger for browser OIDC authorization transactions. Stores only a
/// SHA-256 state digest; verifier, nonce, and return path remain in the signed,
/// short-lived HttpOnly browser cookie.
model OidcLoginTransaction {
  stateHash String    @id @map("state_hash")
  expiresAt DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("oidc_login_transaction")
}

/// Global scheduler lease. The endpoint acquires one row per cadence before
/// enumerating tenants, so two sidecars (or a retry racing a slow run) cannot
/// execute the same cadence concurrently.
model SchedulerLease {
  cadence     String   @id
  ownerToken  String   @map("owner_token") @db.Uuid
  lockedUntil DateTime @map("locked_until")
  updatedAt   DateTime @default(now()) @map("updated_at")

  @@map("scheduler_lease")
}

/// Durable operator evidence for every authenticated scheduler attempt.
/// Failed rows are the dead-letter inventory and may be replayed explicitly by
/// calling the same idempotent cadence with an incremented attempt number.
model SchedulerRun {
  id            String    @id @default(uuid()) @db.Uuid
  cadence       String
  status        String
  correlationId String    @map("correlation_id") @db.Uuid
  attempt       Int       @default(1)
  startedAt     DateTime  @default(now()) @map("started_at")
  finishedAt    DateTime? @map("finished_at")
  durationMs    Int?      @map("duration_ms")
  nextRunAt     DateTime  @map("next_run_at")
  tenantCount   Int?      @map("tenant_count")
  workCount     Int?      @map("work_count")
  details       Json      @default("{}")

  @@index([cadence, startedAt])
  @@index([cadence, status, finishedAt])
  @@map("scheduler_run")
}

/// Global fail-closed deployment markers written only by operator tooling.
/// The web role can read these for readiness but cannot clear quarantine.
model DeploymentState {
  key       String   @id
  status    String
  details   Json     @default("{}")
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("deployment_state")
}

/// A configuration value at one precedence scope (Authority: Spec PLA-CFG-001).
///
/// `scopeId` identifies the organization or user for the narrower scopes and is
/// null for Tenant and Global. Resolution walks narrowest to broadest and takes
/// the first hit.
model ConfigParameter {
  id        String      @id @default(uuid()) @db.Uuid
  /// Null only for Global scope, which belongs to no tenant.
  tenantId  String?     @map("tenant_id") @db.Uuid
  key       String
  value     Json
  scope     ConfigScope
  scopeId   String?     @map("scope_id") @db.Uuid
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key, scope, scopeId])
  @@index([tenantId, key])
  @@map("config_parameter")
}

enum OfflineCommandStatus {
  Pending
  Applied
  Rejected
}

/// Reasons a replayed command could not be applied (Authority: Bible V5 §2.C).
enum SyncConflictKind {
  /// Server-side state moved so preconditions no longer hold.
  StateConflict
  /// The target record was deleted while the client was offline.
  TargetDeleted
  /// The actor's permissions were revoked while they were offline.
  AuthorizationRevoked
  /// Optimistic concurrency lost against a newer server version.
  VersionConflict
}

/// The offline command inbox (Authority: Bible V5 §2.A, §2.B).
///
/// `commandId` is generated by the client, not the server, and carries the
/// uniqueness constraint. That is what makes replay exactly-once: a retry after
/// a network failure collides on insert and returns the stored result rather
/// than applying the mutation twice.
model OfflineCommand {
  id              String               @id @default(uuid()) @db.Uuid
  tenantId        String               @map("tenant_id") @db.Uuid
  /// Client-generated identity (Bible V5 §2.B.1).
  commandId       String               @map("command_id") @db.Uuid
  commandKey      String               @map("command_key")
  actorUserId     String               @map("actor_user_id") @db.Uuid
  payload         Json                 @default("{}")
  /// Replay order (Bible V5 §2.B.3) — the device's clock, not the server's.
  deviceTimestamp DateTime             @map("device_timestamp")
  status          OfflineCommandStatus @default(Pending)
  /// Cached result, returned verbatim on a duplicate submission.
  result          Json?
  error           String?
  receivedAt      DateTime             @default(now()) @map("received_at")
  appliedAt       DateTime?            @map("applied_at")

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  exceptions SyncException[]

  @@unique([tenantId, commandId])
  @@index([tenantId, status, deviceTimestamp])
  @@map("offline_command")
}

/// A replay that could not be applied and needs a human (Authority: Bible V5 §2.C).
///
/// Bible V5 requires an aborted replay to be flagged in the audit log and
/// enqueued for manual resolution rather than silently dropped — losing a
/// field worker's captured work is worse than surfacing a conflict.
model SyncException {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  offlineCommandId String           @map("offline_command_id") @db.Uuid
  kind             SyncConflictKind
  detail           String
  resolvedAt       DateTime?        @map("resolved_at")
  createdAt        DateTime         @default(now()) @map("created_at")

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  offlineCommand OfflineCommand @relation(fields: [offlineCommandId], references: [id], onDelete: Cascade)

  @@index([tenantId, resolvedAt])
  @@map("sync_exception")
}

/// A field whose visibility is restricted (Authority: Spec PLA-AUT-005).
///
/// GLOBAL capability metadata: which fields are sensitive is a property of the
/// entity, declared by its owning capability, not a per-tenant choice.
///
/// The presence of a row is what makes a field restricted. Reading it then
/// requires an ordinary Read grant on the field-qualified entity key
/// `<entityKey>#<fieldName>`, which reuses Verb+Entity+Scope exactly as it
/// stands. The specification's phrasing ("requires level 2 access") suggests a
/// numeric ladder; a ladder would be a second, parallel authorization model to
/// keep in sync with the first, so the existing grant mechanism is used instead.
model FieldPermission {
  id        String   @id @default(uuid()) @db.Uuid
  entityKey String   @map("entity_key")
  fieldName String   @map("field_name")
  createdAt DateTime @default(now()) @map("created_at")

  entity EntityDefinition @relation(fields: [entityKey], references: [key], onDelete: Cascade)

  @@unique([entityKey, fieldName])
  @@index([entityKey])
  @@map("field_permission")
}

// ===========================================================================
// CAPABILITY: Location  (verity.capability.location)
//
// Authority: ADR-004, which splits what a naive model would call "an address"
// into four distinct concepts and forbids folding them together:
//
//   Place    — real-world spatial identity (where something physically is)
//   Address  — the mailing representation (how you write to it)
//   Location — operational spatial context (where work happens)
//   Geofence — a spatial policy, not a place
//
// The split matters because a depot's postal address, the coordinates a
// technician navigates to, the operational site work is scheduled against, and
// the boundary that decides whether a check-in is valid are four different
// facts that change independently.
// ===========================================================================

/// Real-world spatial identity (ADR-004).
model Place {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  name         String
  /// WGS84. Stored as Decimal, not Float: coordinate arithmetic on binary
  /// floating point accumulates error, and a geofence decision is a boundary
  /// comparison where that error changes the answer.
  latitude     Decimal? @db.Decimal(9, 6)
  longitude    Decimal? @db.Decimal(9, 6)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  version      Int      @default(1)
  customFields Json     @default("{}") @map("custom_fields")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  addresses Address[]
  locations Location[]

  @@unique([tenantId, id], name: "place_tenant_scoped_id")
  @@index([tenantId])
  @@map("place")
}

/// Mailing representation (ADR-004). Deliberately separate from Place: a site
/// may have several postal addresses, or none, without changing where it is.
model Address {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  placeId      String?  @map("place_id") @db.Uuid
  line1        String
  line2        String?
  city         String?
  region       String?
  postalCode   String?  @map("postal_code")
  countryCode  String?  @map("country_code")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  version      Int      @default(1)
  customFields Json     @default("{}") @map("custom_fields")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  place  Place? @relation(fields: [tenantId, placeId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  @@index([tenantId])
  @@map("address")
}

/// Operational spatial context — the site work is scheduled against
/// (ADR-004, GOV-TER-017). This is the entity a Location-scoped permission
/// grant resolves to.
model Location {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  placeId        String?  @map("place_id") @db.Uuid
  name           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  version        Int      @default(1)
  customFields   Json     @default("{}") @map("custom_fields")

  tenant                   Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organization             Organization              @relation(fields: [tenantId, organizationId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)
  place                    Place?                    @relation(fields: [tenantId, placeId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  geofences                Geofence[]
  assignments              LocationAssignment[]
  assets                   Asset[]
  godownRacks              GodownRack[]
  stockLedger              StockLedgerEntry[]
  stockBalances            StockBalance[]
  tradingPurchaseOrders    TradingPurchaseOrder[]
  tradingSalesOrders       TradingSalesOrder[]
  tradingStockReservations TradingStockReservation[]
  tradingGoodsReceipts     TradingGoodsReceipt[]
  tradingGoodsIssues       TradingGoodsIssue[]

  // Capability: inventory (Task 73). Back-relations only, as above.
  inventoryStockBalances  InventoryStockBalance[]
  inventoryPurchaseOrders InventoryPurchaseOrder[]
  inventoryStockRequests  InventoryStockRequest[]
  inventoryStockMovements InventoryStockMovement[]

  // Capability: manufacturing (Task 118 minimal slice). Back-relations only.
  manufacturingOrders ManufacturingOrder[]

  // Capability: dinein (Colonel Kebabz multi-outlet). Back-relations only.
  diningZones  DiningZone[]
  diningTables DiningTable[]
  diningOrders DiningOrder[]
  menuAvailability MenuAvailability[]
  bills        Bill[]
  customers    Customer[]
  complaints   Complaint[]
  shifts       Shift[]
  expenses     Expense[]
  cashReconciliations DailyCashReconciliation[]
  cashMovements CashMovement[]

  @@unique([tenantId, id], name: "location_tenant_scoped_id")
  @@index([tenantId, organizationId])
  @@map("location")
}

/// A spatial policy attached to a Location (ADR-004: "Geofences are policies,
/// not Locations themselves").
model Geofence {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  locationId   String   @map("location_id") @db.Uuid
  name         String
  centreLat    Decimal  @map("centre_lat") @db.Decimal(9, 6)
  centreLng    Decimal  @map("centre_lng") @db.Decimal(9, 6)
  radiusMetres Int      @map("radius_metres")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  version      Int      @default(1)
  customFields Json     @default("{}") @map("custom_fields")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, locationId])
  @@map("geofence")
}

/// Binds a User to the Locations they work at.
///
/// This is what a `Location`-scoped permission grant resolves through: without
/// it the platform would have no way to answer "which sites are this actor's",
/// and a Location-scoped grant would reach nothing.
model LocationAssignment {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, locationId])
  @@index([tenantId, userId])
  @@map("location_assignment")
}

// ===========================================================================
// CAPABILITY: Asset  (verity.capability.asset)
//
// Authority: GOV-TER-009 (`Asset` — physical equipment/machinery), ADR-008
// (an Asset is one of the two things a Resource may be backed by).
//
// Demanded independently by Fleet Management, Medical Equipment Maintenance and
// Facilities. Note what is deliberately absent: no make, model, year, or any
// other equipment-specific column. Forbidden pattern #3 exists because VEDA put
// vehicle brand and model identifiers into a core table; those belong in
// custom_fields, where a fleet tenant and a hospital tenant can each describe
// their own equipment without the platform knowing either domain.
// ===========================================================================

model Asset {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  /// Where the asset currently is. Null for an asset in transit or unassigned.
  locationId   String?  @map("location_id") @db.Uuid
  name         String
  /// Tenant-facing identifier — a fleet number, a serial, an asset tag.
  reference    String?
  state        String   @default("in_service")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  version      Int      @default(1)
  customFields Json     @default("{}") @map("custom_fields")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location  Location?  @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  resources Resource[]

  @@unique([tenantId, id], name: "asset_tenant_scoped_id")
  @@unique([tenantId, reference])
  @@index([tenantId, locationId])
  @@map("asset")
}

// ===========================================================================
// CAPABILITY: Evidence  (verity.capability.evidence)
//
// Authority: Bible V2 (Evidence as immutable field data — GPS, photos,
// signatures), EXE-AUD-003 (append-only), ADR-004 (spatial capture is a Place
// question, and a geofence is the policy that judges it).
//
// Demanded independently by Security Operations, Field Service, Drone
// Inspection and Medical Equipment Maintenance. Evidence is the reason the
// audit stream is append-only at trigger level: a calibration certificate or a
// proof-of-attendance photograph that can be edited later is not evidence.
// ===========================================================================

enum EvidenceKind {
  Photo
  Signature
  GeoPoint
  Document
  Reading
}

model Evidence {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  /// What this evidence is about — any capability's entity.
  entityKey    String       @map("entity_key")
  entityId     String       @map("entity_id") @db.Uuid
  kind         EvidenceKind
  /// Platform-managed artefact. Preferred over `uri`: a StoredFile has a frozen
  /// checksum, so the bytes behind the reference cannot later change.
  fileId       String?      @map("file_id") @db.Uuid
  /// External reference, for an artefact the platform does not host.
  uri          String?
  /// Captured coordinates, when the device supplied them.
  latitude     Decimal?     @db.Decimal(9, 6)
  longitude    Decimal?     @db.Decimal(9, 6)
  /// Device clock at capture — not server time, which may be much later for
  /// evidence captured offline.
  capturedAt   DateTime     @map("captured_at")
  capturedById String?      @map("captured_by_id") @db.Uuid
  /// Geofence this capture was judged against, and the verdict at capture time.
  geofenceId   String?      @map("geofence_id") @db.Uuid
  withinFence  Boolean?     @map("within_fence")
  payload      Json         @default("{}")
  recordedAt   DateTime     @default(now()) @map("recorded_at")

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  file   StoredFile? @relation(fields: [fileId], references: [id], onDelete: Restrict)
  checkpointResults ManufacturingCheckpointResult[]
  manufacturingDispatches ManufacturingDispatch[]

  @@index([tenantId, entityKey, entityId])
  @@index([tenantId, capturedAt])
  @@map("evidence")
}

// ===========================================================================
// CAPABILITY: Scheduling  (verity.capability.scheduling)
//
// Authority: ADR-008, which fixed this shape so it would not have to be
// re-litigated: a Resource is a single schedulable unit backed by exactly one
// Party or Asset, and crews, pools and room sets are ResourceGroup
// compositions. Availability and conflict detection run against Resources only,
// so there is one implementation rather than two that must agree.
//
// Demanded independently by Staffing, Facilities, Field Service and Medical
// Equipment Maintenance.
// ===========================================================================

/// How a group resolves to its members when work is scheduled against it.
enum GroupSelection {
  /// Every member is required — a two-person crew where both must attend.
  AllOf
  /// Any one member satisfies it — a pool of interchangeable technicians.
  AnyOf
  /// A specific count drawn from the pool.
  NOf
}

/// A single schedulable unit (ADR-008).
///
/// Backed by exactly one Party or one Asset — never both, never neither. A
/// Resource backed by neither is unschedulable; one backed by both is
/// ambiguous. Enforced by a check constraint rather than by convention.
model Resource {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  partyId      String?  @map("party_id") @db.Uuid
  assetId      String?  @map("asset_id") @db.Uuid
  name         String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  version      Int      @default(1)
  customFields Json     @default("{}") @map("custom_fields")

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  party        Party?                @relation(fields: [partyId], references: [id], onDelete: Restrict)
  asset        Asset?                @relation(fields: [tenantId, assetId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  memberships  ResourceGroupMember[]
  availability AvailabilityWindow[]
  bookings     Booking[]

  @@unique([tenantId, id], name: "resource_tenant_scoped_id")
  @@index([tenantId])
  @@map("resource")
}

/// A composition of Resources — a crew, a pool, a room set (ADR-008).
///
/// A group has no calendar of its own; its availability is derived from its
/// members. That is what keeps conflict detection a single implementation.
model ResourceGroup {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  name          String
  selection     GroupSelection @default(AnyOf)
  /// Only meaningful for NOf.
  requiredCount Int?           @map("required_count")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  version       Int            @default(1)
  customFields  Json           @default("{}") @map("custom_fields")

  tenant  Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members ResourceGroupMember[]

  @@unique([tenantId, id], name: "resource_group_tenant_scoped_id")
  @@index([tenantId])
  @@map("resource_group")
}

model ResourceGroupMember {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  groupId    String   @map("group_id") @db.Uuid
  resourceId String   @map("resource_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group    ResourceGroup @relation(fields: [tenantId, groupId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)
  resource Resource      @relation(fields: [tenantId, resourceId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([groupId, resourceId])
  @@index([tenantId])
  @@map("resource_group_member")
}

/// A window in which a Resource is or is not available.
model AvailabilityWindow {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  resourceId String   @map("resource_id") @db.Uuid
  startsAt   DateTime @map("starts_at")
  endsAt     DateTime @map("ends_at")
  /// False marks an exception — leave, servicing, a closure.
  available  Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [tenantId, resourceId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, resourceId, startsAt])
  @@map("availability_window")
}

/// A Resource committed to a period of work.
///
/// `subjectEntityKey` / `subjectEntityId` point at whatever the booking is for,
/// so Scheduling never needs to know which capability asked.
model Booking {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  resourceId       String   @map("resource_id") @db.Uuid
  subjectEntityKey String   @map("subject_entity_key")
  subjectEntityId  String   @map("subject_entity_id") @db.Uuid
  startsAt         DateTime @map("starts_at")
  endsAt           DateTime @map("ends_at")
  cancelled        Boolean  @default(false)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  version          Int      @default(1)
  customFields     Json     @default("{}") @map("custom_fields")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [tenantId, resourceId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, resourceId, startsAt])
  @@map("booking")
}

// ===========================================================================
// CAPABILITY: Approval  (verity.capability.approval)
//
// Authority: foundation validation — demanded independently by Professional
// Services, Staffing, Finance and Procurement. A generic multi-step approval
// chain, so that four capabilities do not each grow their own.
// ===========================================================================

enum ApprovalDecision {
  Pending
  Approved
  Rejected
  Skipped
}

model ApprovalRequest {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  subjectEntityKey String           @map("subject_entity_key")
  subjectEntityId  String           @map("subject_entity_id") @db.Uuid
  requestedById    String           @map("requested_by_id") @db.Uuid
  state            String           @default("pending")
  outcome          ApprovalDecision @default(Pending)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  version          Int              @default(1)
  customFields     Json             @default("{}") @map("custom_fields")

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  steps  ApprovalStep[]

  @@index([tenantId, subjectEntityKey, subjectEntityId])
  @@map("approval_request")
}

/// One step in a chain. Steps are ordered and decided in sequence.
model ApprovalStep {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  requestId       String           @map("request_id") @db.Uuid
  sequence        Int
  /// The role permitted to decide this step. Who approves is a role, not a
  /// person, so a chain survives someone leaving.
  approverRoleId  String           @map("approver_role_id") @db.Uuid
  decision        ApprovalDecision @default(Pending)
  decidedByUserId String?          @map("decided_by_user_id") @db.Uuid
  decidedAt       DateTime?        @map("decided_at")
  comment         String?

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  request ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  role    Role            @relation(fields: [tenantId, approverRoleId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([requestId, sequence])
  @@index([tenantId])
  @@map("approval_step")
}

// ===========================================================================
// PLATFORM: Temporal model
//
// Authority: Bible V4 §5.B ("schedulers see time zones in local project
// contexts"), Bible V3 §1 (SLA clocks), EXE-SCH-001 (UTC storage with
// user-local translation).
//
// Every instant is stored in UTC. A timezone is a *rendering and reckoning*
// context, not a storage format: "9am local" means different instants in
// different places, and a business calendar cannot decide whether 08:30 is
// inside working hours without knowing whose clock is being read.
//
// The platform holds no default. Guessing a timezone silently misplaces every
// deadline by the offset, so an unconfigured tenant is explicitly UTC and the
// interface says so rather than pretending to know.
// ===========================================================================

/// Working-hours calendar used by SLA clocks (Bible V3 §1).
///
/// Tenant-scoped and optionally narrowed to an organization, because a
/// portfolio's branches genuinely keep different hours.
model BusinessCalendar {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  /// Null means the calendar applies tenant-wide.
  organizationId String?  @map("organization_id") @db.Uuid
  name           String
  /// IANA zone, e.g. "Europe/London". Never an offset: an offset cannot
  /// express daylight saving, so a fixed one is wrong for half the year.
  timeZone       String   @map("time_zone")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  version        Int      @default(1)

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hours    BusinessHours[]
  holidays BusinessHoliday[]
  policies SlaPolicy[]

  @@unique([tenantId, name])
  @@unique([tenantId, id], name: "business_calendar_tenant_scoped_id")
  @@index([tenantId])
  @@map("business_calendar")
}

/// One working window on one weekday, in the calendar's own timezone.
model BusinessHours {
  id          String @id @default(uuid()) @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  calendarId  String @map("calendar_id") @db.Uuid
  /// 0 = Sunday through 6 = Saturday, matching JavaScript's getDay().
  weekday     Int
  /// Minutes from local midnight. Stored as minutes rather than a time so a
  /// window can cross into a 25-hour DST day without ambiguity.
  startMinute Int    @map("start_minute")
  endMinute   Int    @map("end_minute")

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  calendar BusinessCalendar @relation(fields: [tenantId, calendarId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, calendarId, weekday])
  @@map("business_hours")
}

/// A non-working date. Stored as a local date, not an instant, because a
/// holiday is a day in a place rather than a moment in time.
model BusinessHoliday {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  calendarId String @map("calendar_id") @db.Uuid
  /// ISO local date, e.g. "2026-12-25".
  localDate  String @map("local_date")
  name       String

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  calendar BusinessCalendar @relation(fields: [tenantId, calendarId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([calendarId, localDate])
  @@index([tenantId])
  @@map("business_holiday")
}

// ===========================================================================
// PLATFORM: SLA substrate
//
// Authority: Bible V3 §1 [FACT] — the clock state machine is constitutional,
// MET-STA-004 (clocks evaluate at the StateCategory layer, ignoring label text).
//
// This is the reusable substrate only. It provides clocks, calendars, pause and
// breach semantics and an escalation hook. It defines no client's SLA policy and
// no domain workflow — a capability attaches a policy to its own entity and the
// platform runs the clock.
//
// The clock transitions are driven by StateCategory rather than by state keys,
// which is exactly why ADR-009 fixed a behavioural category set: Active runs the
// clock, Pending and Blocked pause it, Completed and Cancelled stop it, Draft
// has not started. A capability gets correct SLA behaviour by declaring its
// states honestly, without writing any clock code.
// ===========================================================================

enum SlaClockStatus {
  /// Target created, clock not yet started (Bible V3: INITIALIZE).
  NotStarted
  Running
  Paused
  /// Deadline passed while running.
  Breached
  /// Terminal; elapsed time frozen.
  Stopped
}

/// A reusable SLA policy owned by a capability's entity type.
model SlaPolicy {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  /// EntityDefinition.key this policy applies to.
  entityKey     String   @map("entity_key")
  name          String
  /// Working minutes allowed before breach.
  targetMinutes Int      @map("target_minutes")
  /// Null means elapsed wall-clock time; otherwise only working time counts.
  calendarId    String?  @map("calendar_id") @db.Uuid
  /// Higher wins when several policies match (Bible V3: contract SLA overrides
  /// tenant default; an explicit work-level deadline overrides both).
  precedence    Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  version       Int      @default(1)

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  calendar BusinessCalendar? @relation(fields: [tenantId, calendarId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  clocks   SlaClock[]

  @@unique([tenantId, name])
  @@unique([tenantId, id], name: "sla_policy_tenant_scoped_id")
  @@index([tenantId, entityKey])
  @@map("sla_policy")
}

/// A running clock against one record.
model SlaClock {
  id                 String         @id @default(uuid()) @db.Uuid
  tenantId           String         @map("tenant_id") @db.Uuid
  policyId           String         @map("policy_id") @db.Uuid
  entityKey          String         @map("entity_key")
  entityId           String         @map("entity_id") @db.Uuid
  status             SlaClockStatus @default(NotStarted)
  /// Working minutes consumed while running. Accumulated on pause and stop so
  /// the figure survives a restart and needs no replay to compute.
  elapsedMinutes     Int            @default(0) @map("elapsed_minutes")
  /// When the current running segment began; null unless Running.
  runningSince       DateTime?      @map("running_since")
  /// Computed when the clock starts or resumes. An explicit override wins
  /// (Bible V3 precedence rule 2).
  deadlineAt         DateTime?      @map("deadline_at")
  overrideDeadlineAt DateTime?      @map("override_deadline_at")
  breachedAt         DateTime?      @map("breached_at")
  stoppedAt          DateTime?      @map("stopped_at")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  version            Int            @default(1)

  tenant Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  policy SlaPolicy @relation(fields: [tenantId, policyId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([policyId, entityKey, entityId])
  @@index([tenantId, status])
  @@index([tenantId, deadlineAt])
  @@map("sla_clock")
}

// ===========================================================================
// PLATFORM: Files and documents
//
// Authority: PLA-CFG-002 (DocumentTemplate as a declarative template),
// EXE-AUD-003 (evidence artefacts must not be silently replaced), Bible V5 §1
// (tenant isolation applies to stored objects as much as to rows).
//
// The platform owns the *record* of a file — who uploaded it, what it is, which
// record it belongs to, whether it is still pending — and delegates the bytes to
// a storage driver. Keeping the record separate from the bytes is what lets
// authorization, audit and retention work uniformly regardless of where the
// object physically lives.
// ===========================================================================

enum StoredFileStatus {
  /// Record created, bytes not yet confirmed. A file is never readable in this
  /// state: an unconfirmed upload may be absent, partial, or someone else's.
  Pending
  Stored
  /// Failed a post-upload check. Kept, never served.
  Quarantined
}

model StoredFile {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  /// Opaque key in the storage backend. Namespaced by tenant so a driver
  /// misconfiguration cannot cross the boundary silently.
  storageKey   String           @map("storage_key")
  fileName     String           @map("file_name")
  mimeType     String           @map("mime_type")
  byteSize     Int              @map("byte_size")
  /// Content hash, recorded at confirmation. Two records with the same checksum
  /// are the same bytes, which is what makes an artefact reference verifiable.
  checksum     String?
  status       StoredFileStatus @default(Pending)
  uploadedById String?          @map("uploaded_by_id") @db.Uuid
  /// What the file is about, so authorization can be derived from the subject
  /// rather than duplicated onto the file.
  entityKey    String?          @map("entity_key")
  entityId     String?          @map("entity_id") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at")
  confirmedAt  DateTime?        @map("confirmed_at")

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  evidence Evidence[]

  @@unique([tenantId, storageKey])
  @@index([tenantId, entityKey, entityId])
  @@map("stored_file")
}

// ===========================================================================
// PLATFORM: Notifications
//
// Authority: PLA-CFG-002 (NotificationTemplate as a declarative template),
// MET-EVE-001→002 (events drive automations and notifications).
//
// A capability raises a notification; the platform decides how it reaches
// someone. Channels, preferences and templates are platform concerns because
// every capability needs them and none should implement its own.
//
// Deliberately not a messaging product: no threads, no read receipts beyond a
// timestamp, no delivery guarantees the platform cannot keep.
// ===========================================================================

enum NotificationChannel {
  InApp
  Email
  Push
  Webhook
}

enum NotificationStatus {
  Pending
  Sent
  Failed
  /// Suppressed by the recipient's preferences. Recorded rather than dropped,
  /// so "why did nobody get told" is answerable.
  Suppressed
}

/// A tenant-authored message template (PLA-CFG-002).
///
/// Placeholders are `{name}` and substitution is literal. A full expression
/// language would make a stored template executable, which is a step the
/// specification never asks for and a risk it does not weigh.
model NotificationTemplate {
  id        String              @id @default(uuid()) @db.Uuid
  tenantId  String              @map("tenant_id") @db.Uuid
  /// Stable key a capability refers to, e.g. `verity.approval.awaiting`.
  key       String
  channel   NotificationChannel
  subject   String
  body      String
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")
  version   Int                 @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key, channel])
  @@index([tenantId])
  @@map("notification_template")
}

/// Per-recipient channel preferences. Absence means the platform default.
model NotificationPreference {
  id       String              @id @default(uuid()) @db.Uuid
  tenantId String              @map("tenant_id") @db.Uuid
  userId   String              @map("user_id") @db.Uuid
  /// Notification key, or `*` for every notification on this channel.
  key      String              @default("*")
  channel  NotificationChannel
  enabled  Boolean             @default(true)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key, channel])
  @@index([tenantId, userId])
  @@map("notification_preference")
}

/// One notification to one recipient on one channel.
///
/// Written inside the raising command's transaction for the same reason events
/// are: a notification about work that rolled back is a lie.
model Notification {
  id          String              @id @default(uuid()) @db.Uuid
  tenantId    String              @map("tenant_id") @db.Uuid
  recipientId String              @map("recipient_id") @db.Uuid
  key         String
  channel     NotificationChannel
  status      NotificationStatus  @default(Pending)
  subject     String
  body        String
  /// What it concerns, so the interface can link to the record.
  entityKey   String?             @map("entity_key")
  entityId    String?             @map("entity_id") @db.Uuid
  readAt      DateTime?           @map("read_at")
  sentAt      DateTime?           @map("sent_at")
  failure     String?
  createdAt   DateTime            @default(now()) @map("created_at")

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipient User   @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([tenantId, recipientId, readAt])
  @@index([tenantId, status])
  @@map("notification")
}

// ===========================================================================
// CAPABILITY: Dine-in  (verity.capability.dinein)
//
// Kent's Restaurant, Defence Colony — the first real client requirement.
// Authority: KentsRestaurant.md §6, implementation/kents-gap-analysis.md.
//
// Capability-owned, which PLATFORM-FREEZE names as expected and additive: new
// tables under a capability's own name change nothing about tenancy, the
// command runtime, authorization or the shell. Every model below carries the
// base-entity shape (id, tenantId, createdAt, updatedAt, version, customFields)
// and is protected by the same RLS policy as every other tenant-scoped table.
//
// MONEY IS INTEGER MINOR UNITS (paise). Floating-point money drifts by the
// third addition, and a bill that disagrees with itself by a paisa is a bill
// nobody trusts. Currency comes from configuration; the arithmetic does not.
// ===========================================================================

/// A section of the menu — Starters, Breads, Desserts.
model MenuCategory {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  name         String
  sortOrder    Int      @default(0) @map("sort_order")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  version      Int      @default(1)
  customFields Json     @default("{}") @map("custom_fields")

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  MenuItem[]

  @@unique([tenantId, name])
  @@unique([tenantId, id], name: "menu_category_tenant_scoped_id")
  @@index([tenantId, sortOrder])
  @@map("menu_category")
}

/// Something orderable, with the price it is sold at today.
///
/// Never deleted — retired through `active`, because a bill from last month must
/// still render what was charged. Order lines snapshot name and price anyway;
/// this keeps the catalogue honest as well as the history.
model MenuItem {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  categoryId   String   @map("category_id") @db.Uuid
  name         String
  description  String?
  priceMinor   Int      @map("price_minor")
  /// What the item costs the kitchen. Restricted by FieldPermission so margin
  /// never reaches a shared floor tablet.
  costMinor    Int?     @map("cost_minor")
  active       Boolean  @default(true)
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  version      Int      @default(1)
  customFields Json     @default("{}") @map("custom_fields")

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category MenuCategory      @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  variants MenuItemVariant[]
  modifiers MenuModifier[]
  availability MenuAvailability[]
  lines    OrderLine[]
  recipe   Recipe?

  @@unique([tenantId, id], name: "menu_item_tenant_scoped_id")
  @@index([tenantId, categoryId, sortOrder])
  @@map("menu_item")
}

/// A scoped availability rule for a menu item (Task 125 items 3.2, 3.3). No rule means
/// available wherever active; any rule means available only where one matches. Null
/// outlet/channel/window means "any". Minutes are since local midnight, in the
/// outlet's own zone; a window that ends before it starts wraps past midnight.
model MenuAvailability {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  itemId       String   @map("item_id") @db.Uuid
  locationId   String?  @map("location_id") @db.Uuid
  channel      String?
  fromMinute   Int?     @map("from_minute")
  toMinute     Int?     @map("to_minute")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  version      Int      @default(1)
  customFields Json     @default("{}") @map("custom_fields")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item     MenuItem  @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction, map: "menu_availability_item_fkey")
  location Location? @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction, map: "menu_availability_location_fkey")

  @@index([tenantId, itemId])
  @@map("menu_availability")
}

/// A portion of an item — Half, Full — priced as a delta from the item.
model MenuItemVariant {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  itemId          String   @map("item_id") @db.Uuid
  name            String
  priceDeltaMinor Int      @default(0) @map("price_delta_minor")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  version         Int      @default(1)
  customFields    Json     @default("{}") @map("custom_fields")

  tenant Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item   MenuItem @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantId, itemId, name])
  @@unique([tenantId, id], name: "menu_variant_tenant_scoped_id")
  @@map("menu_variant")
}

/// An add-on asked for on one item (Task 125 item 3.1): extra cheese +Rs 30, extra
/// spicy at no charge. Independent options per item, priced zero or more; the
/// order line snapshots the chosen ones, so editing this never rewrites a bill.
model MenuModifier {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  itemId          String   @map("item_id") @db.Uuid
  name            String
  priceDeltaMinor Int      @default(0) @map("price_delta_minor")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")
  version         Int      @default(1)
  customFields    Json     @default("{}") @map("custom_fields")

  tenant Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item   MenuItem @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantId, itemId, name])
  @@unique([tenantId, id], name: "menu_modifier_tenant_scoped_id")
  @@map("menu_modifier")
}

/// A part of the floor — Ground, Mezzanine, Terrace.
///
/// Scoped to a Location (Task: Colonel Kebabz multi-outlet). A zone belongs to
/// exactly one outlet; a chain with three outlets has three "Ground Floor"
/// zones, not one shared across sites.
model DiningZone {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  locationId   String   @map("location_id") @db.Uuid
  name         String
  floorLabel   String?  @map("floor_label")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  version      Int      @default(1)
  customFields Json     @default("{}") @map("custom_fields")

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location      @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction, map: "dining_zone_location_fkey")
  tables   DiningTable[]

  @@unique([tenantId, locationId, name])
  @@unique([tenantId, id], name: "dining_zone_tenant_scoped_id")
  @@index([tenantId, locationId])
  @@map("dining_zone")
}

/// A physical table, where it sits on the floor plan, and what it is doing.
///
/// Not a Resource and not an Asset (ADR-008 considered and rejected in
/// KentsRestaurant.md §6 M2): occupancy is discrete state, not calendar
/// scheduling, and double-seating is prevented by the occupy precondition
/// rather than by an overlap trigger.
model DiningTable {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  zoneId       String   @map("zone_id") @db.Uuid
  /// Denormalized from the zone at creation, so floor/queue queries filter by
  /// location without a join. A table never moves outlets, so this never drifts.
  locationId   String   @map("location_id") @db.Uuid
  label        String
  seats        Int      @default(2)
  shape        String?
  /// Floor-plan canvas coordinates. Real numbers a manager dragged, not a
  /// generic diagram abstraction.
  posX         Int      @default(0) @map("pos_x")
  posY         Int      @default(0) @map("pos_y")
  state        String   @default("available")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  version      Int      @default(1)
  customFields Json     @default("{}") @map("custom_fields")

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  zone     DiningZone    @relation(fields: [tenantId, zoneId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  location Location      @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction, map: "dining_table_location_fkey")
  orders   DiningOrder[]

  @@unique([tenantId, locationId, label])
  @@unique([tenantId, id], name: "dining_table_tenant_scoped_id")
  @@index([tenantId, state])
  @@index([tenantId, locationId])
  @@map("dining_table")
}

/// One table's service, from cart to settled.
///
/// This is the domain's Work instance (Bible V2 WORK): a unit of service
/// execution moving through states under commands. Called an order because that
/// is what a restaurant calls it — never a ticket, job card or event run.
model DiningOrder {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  /// Null only for orders with no table (takeaway, delivery, phone…). A
  /// database CHECK (`dining_order_dine_in_has_table`) requires it for dine_in.
  tableId       String?   @map("table_id") @db.Uuid
  /// Where the order came from — closed set `ORDER_CHANNELS` owned by the
  /// dinein capability (PRD §9: "order source must be stored").
  channel       String    @default("dine_in")
  /// Delivery platform name (Zomato, Swiggy…) and its own order number, for
  /// settlement reconciliation (PRD §47). Set only on `delivery_platform`.
  platform         String? @map("platform")
  platformOrderRef String? @map("platform_order_ref")
  /// Denormalized from the table (or chosen outlet) at creation. An order never moves outlets.
  locationId    String    @map("location_id") @db.Uuid
  /// Resolved from the session, never from a payload (PLA-TEN-006).
  takenByUserId String    @map("taken_by_user_id") @db.Uuid
  covers        Int       @default(1)
  state         String    @default("draft")
  /// Plain fields for the occasional B2B invoice. Deliberately NOT a Party — a
  /// walk-in diner has no login and must not mint a platform identity
  /// (ADR-001, ADR-007).
  customerName  String?   @map("customer_name")
  customerPhone String?   @map("customer_phone")
  placedAt      DateTime? @map("placed_at")
  servedAt      DateTime? @map("served_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  version       Int       @default(1)
  customFields  Json      @default("{}") @map("custom_fields")

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  table    DiningTable? @relation(fields: [tenantId, tableId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  location Location    @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction, map: "dining_order_location_fkey")
  lines    OrderLine[]
  bill     Bill?

  @@unique([tenantId, id], name: "dining_order_tenant_scoped_id")
  @@index([tenantId, state])
  @@index([tenantId, tableId, state])
  @@index([tenantId, locationId])
  @@map("dining_order")
}

/// One line on an order, with its own progress through the kitchen.
///
/// A twelve-item order is not done when one dish is, which is why the line —
/// not the order — is what the kitchen advances.
///
/// Name and price are SNAPSHOTS. Menu edits are forward-looking; a bill from
/// last month must render exactly what was charged even after the item is
/// renamed, repriced or retired. Same principle as Evidence immutability.
model OrderLine {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  orderId             String   @map("order_id") @db.Uuid
  itemId              String   @map("item_id") @db.Uuid
  variantId           String?  @map("variant_id") @db.Uuid
  itemNameSnapshot    String   @map("item_name_snapshot")
  variantNameSnapshot String?  @map("variant_name_snapshot")
  unitPriceMinor      Int      @map("unit_price_minor")
  qty                 Int      @default(1)
  lineNote            String?  @map("line_note")
  state               String   @default("queued")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  version             Int      @default(1)
  customFields        Json     @default("{}") @map("custom_fields")

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  DiningOrder @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)
  item   MenuItem    @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  /// The add-ons chosen: a snapshot, already included in `unitPriceMinor`. A line
  /// with a different set of add-ons is a different line, so same-item combining
  /// compares these too.
  addOns OrderLineModifier[]

  @@unique([tenantId, id], name: "order_line_tenant_scoped_id")
  @@index([tenantId, orderId])
  @@index([tenantId, state])
  @@map("order_line")
}

/// One add-on taken on an order line, as it was when ordered (name and price). Rows
/// are written with the line and never edited; the menu changing does not touch them.
model OrderLineModifier {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  orderLineId     String   @map("order_line_id") @db.Uuid
  name            String
  priceDeltaMinor Int      @default(0) @map("price_delta_minor")
  createdAt       DateTime @default(now()) @map("created_at")

  tenant Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  line   OrderLine @relation(fields: [tenantId, orderLineId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, orderLineId])
  @@map("order_line_modifier")
}

/// The guest's bill for one order.
///
/// Amounts are computed once, server-side, at generation — including the tax
/// breakdown, which is stored rather than recomputed on render, so a reprint a
/// year later shows the rate that actually applied.
model Bill {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  orderId           String    @unique @map("order_id") @db.Uuid
  /// Denormalized from the order at generation. A bill never moves outlets.
  locationId        String    @map("location_id") @db.Uuid
  subtotalMinor     Int       @map("subtotal_minor")
  discountMinor     Int       @default(0) @map("discount_minor")
  /// The tax that applied, in columns rather than a JSON blob.
  ///
  /// An Indian restaurant bill for an intra-state supply carries exactly two
  /// components, so two pairs of columns model it completely. The rate is stored
  /// beside the amount because PRN-001 requires the math be visible on the bill,
  /// and because a reprint a year later must show the rate that actually
  /// applied rather than today's.
  ///
  /// Rates are BASIS POINTS: 2.5% is 250. Integer money deserves integer rates,
  /// and a float rate would reintroduce on the tax line exactly the drift the
  /// paise columns exist to avoid.
  cgstRateBp        Int       @default(0) @map("cgst_rate_bp")
  cgstMinor         Int       @default(0) @map("cgst_minor")
  sgstRateBp        Int       @default(0) @map("sgst_rate_bp")
  sgstMinor         Int       @default(0) @map("sgst_minor")
  taxableMinor      Int       @default(0) @map("taxable_minor")
  totalMinor        Int       @map("total_minor")
  roundingMinor     Int       @default(0) @map("rounding_minor")
  state             String    @default("open")
  generatedByUserId String    @map("generated_by_user_id") @db.Uuid
  settledAt         DateTime? @map("settled_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  version           Int       @default(1)
  customFields      Json      @default("{}") @map("custom_fields")

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order    DiningOrder @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  location Location    @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction, map: "bill_location_fkey")
  payments Payment[]
  refunds  BillRefund[]

  // One bill per order in v1. The pair is unique as well as the id, because the
  // relation is defined on the tenant-scoped composite key and Prisma needs the
  // defining side of a one-to-one to be unique on exactly those columns.
  @@unique([tenantId, orderId], name: "bill_tenant_scoped_order")
  @@unique([tenantId, id], name: "bill_tenant_scoped_id")
  @@index([tenantId, locationId])
  @@index([tenantId, state])
  @@map("bill")
}

/// Money received against a bill. Several rows settle a split payment.
model Payment {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  billId           String   @map("bill_id") @db.Uuid
  method           String
  amountMinor      Int      @map("amount_minor")
  /// UPI transaction id or card reference. Record-and-print only: no terminal
  /// integration, no gateway (GOV-SCO-006).
  reference        String?
  receivedByUserId String   @map("received_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  version          Int      @default(1)
  customFields     Json     @default("{}") @map("custom_fields")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bill   Bill   @relation(fields: [tenantId, billId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantId, id], name: "payment_tenant_scoped_id")
  @@index([tenantId, billId])
  @@map("payment")
}

/// Money returned to a guest after a bill was settled. A refund is a fact, so it
/// is append-only: a settled bill and its payments are never edited, and the
/// refund sits beside them (INV-002). Reports and the cash drawer subtract it.
model BillRefund {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  billId           String   @map("bill_id") @db.Uuid
  amountMinor      Int      @map("amount_minor")
  /// How the money went back. Never `delivery_platform`: the platform refunds
  /// its own customers, and recording one here would invent drawer movement.
  method           String
  reason           String
  refundedByUserId String   @map("refunded_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bill   Bill   @relation(fields: [tenantId, billId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, billId])
  @@index([tenantId, createdAt])
  @@map("bill_refund")
}

// ===========================================================================
// CAPABILITY: Plywood trading — `verity.capability.plywood`
//
// Built for a plywood, laminate, MDF and board trading business (plywood.md).
// Stage 1 of the sequence in implementation/plywood-gap-analysis.md §6: the
// catalogue and the floor — the things every later stage references.
//
// Godowns are `Location` records, not a new primitive. A rack is a position
// inside one, which is a genuinely new fact and therefore a capability-owned
// table.
// ===========================================================================

/// A manufacturer whose boards this business trades — Century, Greenply, Merino.
model TradingBrand {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  name         String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  version      Int      @default(1)
  customFields Json     @default("{}") @map("custom_fields")

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products TradingProduct[]

  @@unique([tenantId, name])
  @@unique([tenantId, id], name: "trading_brand_tenant_scoped_id")
  @@map("trading_brand")
}

/// A specific item this business buys and sells: a brand, a name, an HSN
/// code. Generic across any trading vertical — ADR-018 split this out of
/// `plywood`'s original `PlywoodProduct`, which also carried board
/// dimensions/grade. Those stayed capability-private on `PlywoodProductDetail`
/// (1:1, below); a future auto-parts capability adds its own detail table the
/// same way, on this same base.
model TradingProduct {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  brandId           String   @map("brand_id") @db.Uuid
  name              String
  /// HSN code. Legally required on a GST tax invoice; stored as issued by the
  /// client, validated for shape only. The platform does not own a tax code
  /// table and does not invent one.
  ///
  /// Nullable. A trader does not learn the HSN at the moment they first need
  /// the row -- it arrives with the supplier's invoice, days later -- and a
  /// catalogue that refuses the product until then pushes the whole business
  /// into a spreadsheet. `raiseSalesInvoice` falls back to the tenant's
  /// default rate for a line without one, and `closeChecklist` already lists
  /// every invoice with a missing HSN, so the gap stays visible instead of
  /// blocking the counter.
  hsnCode           String?  @map("hsn_code")
  /// Set on a generated variant, pointing at the TEMPLATE it was generated
  /// from. Null on an ordinary product and on the template itself.
  ///
  /// A laminate is chosen as a shade and a texture of a design, and each
  /// combination is a separate thing in the godown with its own stock. The
  /// template holds what they share -- brand, size, HSN, thickness -- and
  /// exists so that adding a sixth shade later regenerates against one row
  /// rather than twenty-five.
  parentProductId   String?  @map("parent_product_id") @db.Uuid
  /// PHYSICAL or SERVICE. A plain string with the same reasoning as `kind`/
  /// `state` elsewhere in this capability — validated at the command layer,
  /// not a Postgres enum, consistent with every other closed-set field here.
  type              String   @default("PHYSICAL")
  /// Below this on-hand quantity the low-stock sweep raises a notification.
  reorderLevelUnits Int      @default(0) @map("reorder_level_units")
  /// What this is counted in — "sheets", "pieces", "litres". A trading-wide
  /// display concern, not a plywood one; a future capability sets its own.
  unitLabel         String   @default("units") @map("unit_label")
  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  version           Int      @default(1)
  customFields      Json     @default("{}") @map("custom_fields")

  tenant             Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brand              TradingBrand               @relation(fields: [tenantId, brandId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  movements          StockLedgerEntry[]
  balances           StockBalance[]
  supplierPrices     TradingSupplierPrice[]
  customerPrices     TradingCustomerPrice[]
  purchaseOrderLines TradingPurchaseOrderLine[]
  salesOrderLines    TradingSalesOrderLine[]
  stockReservations  TradingStockReservation[]
  invoiceLines       TradingInvoiceLine[]
  goodsReceiptLines  TradingGoodsReceiptLine[]
  goodsIssueLines    TradingGoodsIssueLine[]
  plywoodDetail      PlywoodProductDetail?
  parent             TradingProduct?            @relation("ProductVariants", fields: [tenantId, parentProductId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  variants           TradingProduct[]           @relation("ProductVariants")

  @@unique([tenantId, id], name: "trading_product_tenant_scoped_id")
  @@index([tenantId, parentProductId])
  @@index([tenantId, brandId, name])
  @@index([tenantId, active])
  @@map("trading_product")
}

/// Plywood's own board-dimension/grade extension of `TradingProduct`, 1:1 via
/// `productId`. ADR-018: this is the capability-owned-extension pattern —
/// plywood adds its taxonomy without forking the shared `TradingProduct`
/// table, and a future auto-parts capability adds `AutoPartsProductDetail`
/// the same way rather than widening this one.
///
/// Dimensions are integers in fixed units rather than decimals, for the same
/// reason money is stored in paise — 18.0 mm and 8 ft x 4 ft are exact facts
/// and a float would make them approximately exact.
model PlywoodProductDetail {
  productId        String  @id @map("product_id") @db.Uuid
  tenantId         String  @map("tenant_id") @db.Uuid
  /// Tenths of a millimetre. 180 is 18.0 mm. Not basis points: a thickness is
  /// not a rate, and the two units are kept apart deliberately.
  /// Nullable: a SERVICE product (sawing, estimating) and most hardware items
  /// have no sheet dimensions at all. `plywood_product_detail_dimensions_positive`
  /// allows NULL but still refuses zero or negative when a value is given.
  thicknessTenthMm Int?    @map("thickness_tenth_mm")
  /// BOARD, PLYWOOD, LAMINATE, LOUVRE or OTHER. What the trade calls this
  /// thing, and — because each family is quoted in its own unit — what decides
  /// how its size is read. A plain string, validated at the command layer
  /// (`ProductCategory` in index.ts) and by a CHECK constraint, consistent with
  /// every other closed set in this file.
  category         String  @default("OTHER")
  /// MM, FT or IN. The unit `widthTenth` and `heightTenth` are counted in.
  /// Stored rather than derived from `category`, because it is a fact about
  /// what was recorded — boards entered before the trade's own units were
  /// modelled hold genuine millimetres, and rewriting them would be a lie.
  sizeUnit         String  @default("MM") @map("size_unit")
  /// Tenths of `sizeUnit`. 80 is 8.0 ft; 24400 is 2440.0 mm. Tenths for the
  /// same reason thickness is: 8 ft is an exact fact and is not 2438.4 mm.
  widthTenth       Int?    @map("width_tenth")
  heightTenth      Int?    @map("height_tenth")
  /// BWR, MR, Marine. A free string: grades are the client's vocabulary and an
  /// enum here would need a platform migration the first time a supplier
  /// invents one.
  ///
  /// Nullable. A grade is a structural-plywood fact -- it says how the glue
  /// behaves in water. A decorative laminate has no grade at all, and the
  /// column was forcing the catalogue to invent one for every laminate row.
  grade            String?
  sheetWeightGrams Int?    @map("sheet_weight_grams")
  /// The shade and texture this variant is. Both null on an ordinary product
  /// and on the template a variant was generated from; both set on a
  /// generated variant. Nullable rather than a separate table per variant
  /// because a laminate IS its shade and texture -- the pair is a property of
  /// the product, not a row hanging off it.
  shadeId          String? @map("shade_id") @db.Uuid
  textureId        String? @map("texture_id") @db.Uuid

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product TradingProduct  @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)
  shade   PlywoodShade?   @relation(fields: [tenantId, shadeId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  texture PlywoodTexture? @relation(fields: [tenantId, textureId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([tenantId, productId])
  @@index([tenantId, shadeId])
  @@index([tenantId, textureId])
  @@map("plywood_product_detail")
}

/// A laminate shade -- the colour/design number printed on the sheet ("1234",
/// "Walnut Natural"). A tenant-owned list, not a platform taxonomy: every
/// laminate house numbers its own range and no two agree.
///
/// Kept as a row rather than a free string on the product because the whole
/// point of the variant matrix is choosing FROM a list. A free string would
/// spell the same shade three ways across twenty-five generated rows, and
/// nothing would ever group them again.
model PlywoodShade {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  /// The design number or name as the client says it. Unique per tenant so
  /// the same shade cannot be added twice under two spellings of one name.
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  details PlywoodProductDetail[]

  @@unique([tenantId, id], name: "plywood_shade_tenant_scoped_id")
  @@unique([tenantId, name])
  @@map("plywood_shade")
}

/// A laminate surface finish -- Matte, Glossy, Suede, Textured. Same shape and
/// same reasoning as [PlywoodShade]: the client's own list, chosen from rather
/// than typed, so the matrix that generates variants has something to iterate.
model PlywoodTexture {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  details PlywoodProductDetail[]

  @@unique([tenantId, id], name: "plywood_texture_tenant_scoped_id")
  @@unique([tenantId, name])
  @@map("plywood_texture")
}

/// A rack, bay or stack position inside a godown.
///
/// The godown itself is a `Location` (ADR-004). This table records only the
/// subdivision inside it, which no existing primitive carries.
model GodownRack {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  locationId   String   @map("location_id") @db.Uuid
  rackLabel    String   @map("rack_label")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  version      Int      @default(1)
  customFields Json     @default("{}") @map("custom_fields")

  tenant                   Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location                 Location                  @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)
  movements                StockLedgerEntry[]
  tradingGoodsReceiptLines TradingGoodsReceiptLine[]
  tradingGoodsIssueLines   TradingGoodsIssueLine[]

  @@unique([tenantId, locationId, rackLabel])
  @@unique([tenantId, id], name: "godown_rack_tenant_scoped_id")
  @@index([tenantId, locationId])
  @@map("godown_rack")
}

// ---------------------------------------------------------------------------
// Plywood stage 2 — the stock ledger
//
// Two tables that say the same thing at two speeds. The ledger is the truth and
// is append-only, enforced by trigger. The balance is a maintained summary whose
// invariant — qty equals the sum of the movements — is asserted by a test that
// replays the ledger, so it cannot silently diverge from what it summarises.
// ---------------------------------------------------------------------------

/// One movement of stock. Never edited, never deleted; a correction is a new
/// entry in the opposite direction with a reason.
model StockLedgerEntry {
  id            String  @id @default(uuid()) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  productId     String  @map("product_id") @db.Uuid
  locationId    String  @map("location_id") @db.Uuid
  rackId        String? @map("rack_id") @db.Uuid
  /// Why the stock moved. The direction is carried by the signed quantity; this
  /// is the reason, and a check constraint keeps the two consistent.
  kind          String
  /// Signed. Positive is into the godown, negative is out of it. Signed rather
  /// than a positive magnitude plus a direction flag, because a sum over this
  /// column is then the balance with no case analysis anywhere.
  qtyDeltaUnits Int     @map("qty_delta_units")
  /// Cost per unit for this movement. On an inward movement it is what was
  /// paid; on an outward movement it is the weighted average standing at that
  /// moment, recorded so a past sale's margin stays a stored fact rather than a
  /// recomputation that later purchases would move.
  unitCostPaise Int     @map("unit_cost_paise")
  /// Mandatory for an adjustment. A stock count that moved 40 sheets without a
  /// reason is the entry nobody can explain six months later.
  reason        String?

  /// WHAT CAUSED THIS MOVEMENT (audit P0-04, slice 3).
  ///
  /// `goods_receipt`, `goods_issue`, `adjustment`, `damage`, `customer_return`,
  /// `transfer`. Together with `sourceId` it is what lets a reader open a
  /// quantity and see the business event behind it — the specification's §13,
  /// the movement ledger that explains why a number is what it is.
  ///
  /// Nullable because movements recorded before slice 3 genuinely have no
  /// source document. Backfilling a plausible one would be inventing evidence.
  sourceType   String? @map("source_type")
  sourceId     String? @map("source_id") @db.Uuid
  /// The human document number, denormalised so the ledger reads without a
  /// join and still reads after the document is archived.
  sourceNumber String? @map("source_number")

  byUserId   String   @map("by_user_id") @db.Uuid
  occurredAt DateTime @default(now()) @map("occurred_at")

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product  TradingProduct @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  location Location       @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  rack     GodownRack?    @relation(fields: [tenantId, rackId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  @@index([tenantId, productId, locationId, occurredAt])
  @@index([tenantId, occurredAt])
  @@index([tenantId, sourceType, sourceId])
  @@map("stock_ledger_entry")
}

/// On-hand quantity and weighted average cost for one board in one godown.
///
/// Maintained inside the same transaction as every movement, under a row lock.
/// Derived data, deliberately stored: a weighted average IS a running figure,
/// and recomputing it would mean replaying every movement on every read.
model StockBalance {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  locationId       String   @map("location_id") @db.Uuid
  qtyUnits         Int      @default(0) @map("qty_units")
  /// P1: weighted average cost. Not FIFO, and the valuation screen says so.
  avgUnitCostPaise Int      @default(0) @map("avg_unit_cost_paise")
  updatedAt        DateTime @updatedAt @map("updated_at")
  version          Int      @default(1)

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product  TradingProduct @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)
  location Location       @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantId, productId, locationId])
  @@index([tenantId, locationId])
  @@map("stock_balance")
}

// ---------------------------------------------------------------------------
// Plywood stages 3 and 4 — trading partners and orders
//
// Symmetric on purpose: a purchase and a sale are the same shape pointing in
// opposite directions. Modelling them as one abstraction with a direction flag
// would collapse two different sets of rules — credit limits, receipts,
// reservations — into a discriminated union nobody can read.
// ---------------------------------------------------------------------------

/// Someone this business buys from.
model TradingSupplier {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  displayName      String   @map("display_name")
  gstin            String?
  phone            String?
  email            String?
  /// Two-digit GST state code. Present so the invoice command can decide
  /// CGST + SGST against IGST by comparing it with the tenant's own (P4).
  stateCode        String?  @map("state_code")
  active           Boolean  @default(true)
  /// The same business, on the selling side.
  ///
  /// A plywood merchant routinely buys from and sells to the same firm — a mill
  /// that also takes offcuts, a dealer who both supplies and orders. They are
  /// one relationship and one conversation about money, and the two roles were
  /// two unrelated rows with two unrelated balances.
  ///
  /// A LINK, not a merge. Buying and selling stay separate documents with
  /// separate tax treatment, separate credit limits and separate ledgers,
  /// because they are separate obligations and netting them by default would
  /// hide a debt behind a receivable. What the link buys is that the two are
  /// shown together and their net position can be stated when someone asks for
  /// it.
  linkedCustomerId String?  @map("linked_customer_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  version          Int      @default(1)
  customFields     Json     @default("{}") @map("custom_fields")

  tenant               Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  linkedCustomer       TradingCustomer?       @relation("PlywoodSameBusiness", fields: [tenantId, linkedCustomerId], references: [tenantId, id], onDelete: SetNull, onUpdate: NoAction)
  pricing              TradingSupplierPrice[]
  orders               TradingPurchaseOrder[]
  tradingInvoices      TradingInvoice[]
  tradingLedgerEntries TradingLedgerEntry[]
  tradingPayments      TradingPayment[]

  @@unique([tenantId, id], name: "trading_supplier_tenant_scoped_id")
  @@unique([tenantId, linkedCustomerId])
  @@index([tenantId, displayName])
  @@map("trading_supplier")
}

/// A negotiated cost for one board from one supplier.
model TradingSupplierPrice {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  supplierId          String   @map("supplier_id") @db.Uuid
  productId           String   @map("product_id") @db.Uuid
  negotiatedCostPaise Int      @map("negotiated_cost_paise")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  version             Int      @default(1)

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier TradingSupplier @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)
  product  TradingProduct  @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantId, supplierId, productId])
  @@map("trading_supplier_price")
}

/// Someone this business sells to — dealer, contractor, walk-in trade.
model TradingCustomer {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  displayName      String   @map("display_name")
  gstin            String?
  phone            String?
  email            String?
  stateCode        String?  @map("state_code")
  /// Zero means cash only: every order needs approval. There is deliberately no
  /// "unlimited" value — unlimited credit is a decision someone should make per
  /// order rather than configure once and forget.
  creditLimitPaise Int      @default(0) @map("credit_limit_paise")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  version          Int      @default(1)
  customFields     Json     @default("{}") @map("custom_fields")

  tenant               Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// The same business, on the buying side. See the note on TradingSupplier.
  linkedSupplier       TradingSupplier?       @relation("PlywoodSameBusiness")
  pricing              TradingCustomerPrice[]
  orders               TradingSalesOrder[]
  tradingInvoices      TradingInvoice[]
  tradingLedgerEntries TradingLedgerEntry[]
  tradingPayments      TradingPayment[]

  @@unique([tenantId, id], name: "trading_customer_tenant_scoped_id")
  @@index([tenantId, displayName])
  @@map("trading_customer")
}

/// A customer-specific price for one board.
model TradingCustomerPrice {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  customerId       String   @map("customer_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  customPricePaise Int      @map("custom_price_paise")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  version          Int      @default(1)

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer TradingCustomer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)
  product  TradingProduct  @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantId, customerId, productId])
  @@map("trading_customer_price")
}

/// An order placed with a supplier.
model TradingPurchaseOrder {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  supplierId     String   @map("supplier_id") @db.Uuid
  /// Where the goods are expected. Known at ordering rather than at receipt,
  /// because it is what the supplier was told.
  locationId     String   @map("location_id") @db.Uuid
  reference      String?
  state          String   @default("draft")
  /// Whether this purchase attracts GST. On by default, because the ordinary
  /// registered supplier charges it and defaulting the other way would lose a
  /// claimable input credit silently. Turned off for an unregistered or
  /// composition supplier: the bill raised from this order then records no
  /// tax and claims no input credit, rather than recording a tax that was
  /// never charged and can never be reconciled against the portal.
  ///
  /// On the order, not the bill: whether the supplier charges tax is known
  /// when the order is placed, and it changes the total the business commits
  /// to. Editable while the order is still draft.
  gstApplicable  Boolean  @default(true) @map("gst_applicable")
  totalCostPaise Int      @default(0) @map("total_cost_paise")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  version        Int      @default(1)
  customFields   Json     @default("{}") @map("custom_fields")

  tenant          Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier        TradingSupplier            @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  location        Location                   @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  lines           TradingPurchaseOrderLine[]
  tradingInvoices TradingInvoice[]
  goodsReceipts   TradingGoodsReceipt[]

  @@unique([tenantId, id], name: "trading_purchase_order_tenant_scoped_id")
  @@index([tenantId, state])
  @@map("trading_purchase_order")
}

/// One board on a purchase order.
///
/// A table, not a JSON column. Ordered against received per line is exactly what
/// a partial receipt turns on, and what is still owed on a given order must be
/// answerable without loading every purchase order.
model TradingPurchaseOrderLine {
  id                  String  @id @default(uuid()) @db.Uuid
  tenantId            String  @map("tenant_id") @db.Uuid
  purchaseOrderId     String  @map("purchase_order_id") @db.Uuid
  productId           String  @map("product_id") @db.Uuid
  /// Snapshots. A catalogue edit must never rewrite a placed order.
  productNameSnapshot String  @map("product_name_snapshot")
  hsnCodeSnapshot     String? @map("hsn_code_snapshot")
  qtyOrdered          Int     @map("qty_ordered")
  qtyReceived         Int     @default(0) @map("qty_received")
  /// NET of any discount — what this business actually agreed to pay per unit.
  /// Everything downstream (stock valuation, the payable, the purchase
  /// register) reads this one field, so a discount cannot be applied twice or
  /// forgotten by a reader that predates it.
  unitCostPaise       Int     @map("unit_cost_paise")
  /// The pre-discount figure, kept only so the order can show what was struck
  /// off. Null when nothing was. Task 71 item 9.
  listUnitCostPaise   Int?    @map("list_unit_cost_paise")
  /// Basis points off the list price. 1250 is 12.5%. Stored as the rate that
  /// was agreed, alongside the money it produced, because recomputing money
  /// from a rate at read time lets a later edit restate a placed order.
  discountBps         Int     @default(0) @map("discount_bps")

  tenant        Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrder TradingPurchaseOrder      @relation(fields: [tenantId, purchaseOrderId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)
  product       TradingProduct            @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  receiptLines  TradingGoodsReceiptLine[]

  @@unique([tenantId, id], name: "trading_purchase_order_line_tenant_scoped_id")
  @@unique([tenantId, purchaseOrderId, productId])
  @@map("trading_purchase_order_line")
}

/// An order taken from a customer.
model TradingSalesOrder {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  /// Paid across the counter, or owed.
  ///
  /// Replaces the credit-approval gate. `prepaid` settles itself when the
  /// invoice is raised; `credit` leaves the balance on Who owes what, which is
  /// where a merchant looks for it. The customer's credit limit still records
  /// exposure and headroom — it simply no longer blocks an order.
  paymentTerms    String   @default("credit") @map("payment_terms")
  /// This supply carries no GST, and why.
  ///
  /// Not a discount and not a switch to make a total look better: an exempt or
  /// nil-rated supply is a real category, and the REASON is required because a
  /// zero-tax invoice with no stated ground is indistinguishable from an
  /// under-declared one. It is snapshotted onto the invoice and listed on the
  /// tax exceptions page, so exempting a sale makes it more visible, not less.
  taxExempt       Boolean  @default(false) @map("tax_exempt")
  taxExemptReason String?  @map("tax_exempt_reason")
  customerId      String   @map("customer_id") @db.Uuid
  /// Which godown fulfils it. Reservations are held there.
  locationId      String   @map("location_id") @db.Uuid
  reference       String?
  state           String   @default("draft")
  totalPricePaise Int      @default(0) @map("total_price_paise")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  version         Int      @default(1)
  customFields    Json     @default("{}") @map("custom_fields")

  tenant          Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer        TradingCustomer           @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  location        Location                  @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  lines           TradingSalesOrderLine[]
  reservations    TradingStockReservation[]
  tradingInvoices TradingInvoice[]
  goodsIssues     TradingGoodsIssue[]

  @@unique([tenantId, id], name: "trading_sales_order_tenant_scoped_id")
  @@index([tenantId, state])
  @@map("trading_sales_order")
}

/// One board on a sales order.
model TradingSalesOrderLine {
  id                  String  @id @default(uuid()) @db.Uuid
  tenantId            String  @map("tenant_id") @db.Uuid
  salesOrderId        String  @map("sales_order_id") @db.Uuid
  productId           String  @map("product_id") @db.Uuid
  productNameSnapshot String  @map("product_name_snapshot")
  hsnCodeSnapshot     String? @map("hsn_code_snapshot")
  qtyOrdered          Int     @map("qty_ordered")
  qtyShipped          Int     @default(0) @map("qty_shipped")
  /// NET of any discount. See the note on the purchase line: one field carries
  /// the money, so no reader can miss the discount.
  unitPricePaise      Int     @map("unit_price_paise")
  listUnitPricePaise  Int?    @map("list_unit_price_paise")
  discountBps         Int     @default(0) @map("discount_bps")

  tenant     Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salesOrder TradingSalesOrder       @relation(fields: [tenantId, salesOrderId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)
  product    TradingProduct          @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  issueLines TradingGoodsIssueLine[]

  @@unique([tenantId, id], name: "trading_sales_order_line_tenant_scoped_id")
  @@unique([tenantId, salesOrderId, productId])
  @@map("trading_sales_order_line")
}

/// Stock held for an order but not yet moved — P5.
///
/// A reservation is not a movement: nothing leaves the godown, so it does not
/// belong in an append-only movement ledger. Available is on hand minus active
/// reservations. Released on dispatch or on cancellation.
model TradingStockReservation {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  productId     String    @map("product_id") @db.Uuid
  locationId    String    @map("location_id") @db.Uuid
  salesOrderId  String    @map("sales_order_id") @db.Uuid
  qtyUnits      Int       @map("qty_units")
  /// Null while the hold is live. Set rather than deleted, so why a board could
  /// not be sold last Tuesday still has an answer.
  releasedAt    DateTime? @map("released_at")
  releaseReason String?   @map("release_reason")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  version       Int       @default(1)

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product    TradingProduct    @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  location   Location          @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  salesOrder TradingSalesOrder @relation(fields: [tenantId, salesOrderId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, productId, locationId, releasedAt])
  @@index([tenantId, salesOrderId])
  @@map("trading_stock_reservation")
}

// ---------------------------------------------------------------------------
// Plywood stage 5 — logistics
//
// Answers the owner's two questions: where is my material right now, and what
// has been sent to which customer and was it delivered.
//
// LR scans and signed delivery receipts are `Evidence` rows pointing at a
// shipment — Evidence already references any capability's entity by key and id,
// so no column here holds a document. That is the reuse `plywood.md` predicted,
// and it is simpler than the `lrEvidenceId` / `deliveryEvidenceId` pair the
// design document proposed.
// ---------------------------------------------------------------------------

/// A carrier. A record, not a user (P6) — no transporter signs in.
// Plywood stage 5 was logistics: transporters, shipments, lorry receipts and
// delivery confirmation. Removed in slice 2 (taskplans/45 §D-01).
//
// The specification the client agreed has no Logistics module, and keeping one
// would leave two doors out of a godown — a shipment and a goods issue — which
// is precisely what makes a stock ledger unprovable (audit P0-04). Material now
// leaves through a Goods Issue document and through nothing else.

// ---------------------------------------------------------------------------
// Plywood — goods movement documents (slice 3)
//
// Authority: taskplans/archive/45_plywood_workflow_program.md §5;
// PLYWOOD_TARGET_WORKFLOW_GAP_AUDIT.md P0-04.
//
// Receipt used to be a field on a purchase order line that an action
// incremented, plus a stock movement with nothing pointing back at it. Nobody
// could open a receipt, prove who handled a line, print it, match it to a
// supplier invoice, or partially reverse it — and "enter once and propagate"
// cannot be audited when the propagation leaves no document behind.
// ---------------------------------------------------------------------------

/// Goods physically arrived. Immutable once posted.
model TradingGoodsReceipt {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  purchaseOrderId String @map("purchase_order_id") @db.Uuid
  locationId      String @map("location_id") @db.Uuid

  /// "GRN/26-27/0001". Gapless within a financial year, for the same reason an
  /// invoice number is: a receipt is the document a supplier dispute turns on.
  receiptNumber String @map("receipt_number")
  financialYear String @map("financial_year")

  /// The supplier's own delivery note, as written on the paper that came with
  /// the lorry. Their reference, recorded as given.
  supplierChallanNumber String? @map("supplier_challan_number")

  receivedAt DateTime @default(now()) @map("received_at")
  receivedBy String   @map("received_by") @db.Uuid
  notes      String?

  createdAt DateTime @default(now()) @map("created_at")

  tenant        Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrder TradingPurchaseOrder      @relation(fields: [tenantId, purchaseOrderId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  location      Location                  @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  lines         TradingGoodsReceiptLine[]

  @@unique([tenantId, receiptNumber])
  @@unique([tenantId, id], name: "trading_goods_receipt_tenant_scoped_id")
  @@index([tenantId, purchaseOrderId])
  @@index([tenantId, receivedAt])
  @@map("trading_goods_receipt")
}

model TradingGoodsReceiptLine {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  receiptId String @map("receipt_id") @db.Uuid

  purchaseOrderLineId String  @map("purchase_order_line_id") @db.Uuid
  productId           String  @map("product_id") @db.Uuid
  productNameSnapshot String  @map("product_name_snapshot")
  rackId              String? @map("rack_id") @db.Uuid

  qtyReceived   Int @map("qty_received")
  /// The cost this receipt landed at, snapshotted. The order's price can be
  /// renegotiated later; what this stock cost cannot change afterwards.
  unitCostPaise Int @map("unit_cost_paise")

  tenant    Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  receipt   TradingGoodsReceipt      @relation(fields: [tenantId, receiptId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)
  orderLine TradingPurchaseOrderLine @relation(fields: [tenantId, purchaseOrderLineId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  product   TradingProduct           @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  rack      GodownRack?              @relation(fields: [tenantId, rackId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([tenantId, id], name: "trading_goods_receipt_line_tenant_scoped_id")
  @@index([tenantId, receiptId])
  @@map("trading_goods_receipt_line")
}

/// Goods physically left the godown. Immutable once posted.
///
/// Authority: taskplans/archive/45_plywood_workflow_program.md §5;
/// PLYWOOD_TARGET_WORKFLOW_GAP_AUDIT.md P0-04.
///
/// The counterpart to a Goods Receipt, and the ONLY door out of a godown now
/// that Logistics is gone. Dispatch used to be a state change that moved every
/// remaining line at once, released every hold and completed the order; a
/// partial issue was impossible and nothing recorded who handed the material
/// over.
model TradingGoodsIssue {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  salesOrderId String @map("sales_order_id") @db.Uuid
  locationId   String @map("location_id") @db.Uuid

  /// "GI/26-27/0001". Gapless for the same reason a receipt's number is.
  issueNumber   String @map("issue_number")
  financialYear String @map("financial_year")

  issuedAt    DateTime @default(now()) @map("issued_at")
  issuedBy    String   @map("issued_by") @db.Uuid
  /// Who took the material away. A name written on a gate pass, not a party.
  collectedBy String?  @map("collected_by")
  notes       String?

  createdAt DateTime @default(now()) @map("created_at")

  tenant     Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salesOrder TradingSalesOrder       @relation(fields: [tenantId, salesOrderId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  location   Location                @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  lines      TradingGoodsIssueLine[]

  @@unique([tenantId, issueNumber])
  @@unique([tenantId, id], name: "trading_goods_issue_tenant_scoped_id")
  @@index([tenantId, salesOrderId])
  @@index([tenantId, issuedAt])
  @@map("trading_goods_issue")
}

model TradingGoodsIssueLine {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  issueId  String @map("issue_id") @db.Uuid

  salesOrderLineId    String  @map("sales_order_line_id") @db.Uuid
  productId           String  @map("product_id") @db.Uuid
  productNameSnapshot String  @map("product_name_snapshot")
  rackId              String? @map("rack_id") @db.Uuid

  qtyIssued     Int @map("qty_issued")
  /// The weighted average standing when the material left. Snapshotted so a
  /// past sale's margin is a stored fact rather than a figure later purchases
  /// would move.
  unitCostPaise Int @map("unit_cost_paise")

  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  issue     TradingGoodsIssue     @relation(fields: [tenantId, issueId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)
  orderLine TradingSalesOrderLine @relation(fields: [tenantId, salesOrderLineId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  product   TradingProduct        @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  rack      GodownRack?           @relation(fields: [tenantId, rackId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([tenantId, id], name: "trading_goods_issue_line_tenant_scoped_id")
  @@index([tenantId, issueId])
  @@map("trading_goods_issue_line")
}

// ---------------------------------------------------------------------------
// Plywood — business identity (slice 2)
//
// Authority: taskplans/archive/45_plywood_workflow_program.md §D-03 and §4.4;
// PLYWOOD_TARGET_WORKFLOW_GAP_AUDIT.md P0-09.
//
// Legally required document identity used to live nowhere. The invoice page
// read the live tenant name and a raw configuration key holding a state code,
// which means two things that must never be true of a tax document: the
// business's own legal identity was not recorded anywhere as data, and an
// invoice raised last year would silently change if the business renamed
// itself this year.
// ---------------------------------------------------------------------------

/// Who this business legally is. One per tenant.
model TradingBusinessProfile {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @unique @map("tenant_id") @db.Uuid

  /// The name on the tax document. Distinct from `Tenant.name`, which is a
  /// label an operator typed and may change for convenience.
  legalName String  @map("legal_name")
  /// What the business is called on the sign outside, when it differs.
  tradeName String? @map("trade_name")
  pan       String? @db.VarChar(10)

  registeredAddress String? @map("registered_address")

  /// April in India. Stored rather than assumed, because the invoice series and
  /// every period boundary derive from it.
  financialYearStartMonth Int    @default(4) @map("financial_year_start_month")
  currencyCode            String @default("INR") @map("currency_code")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  version   Int      @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id], name: "trading_business_profile_tenant_scoped_id")
  @@map("trading_business_profile")
}

/// A GST registration. One today (§D-03); the shape allows more without redesign.
///
/// Tax rules, invoice series and returns are keyed by REGISTRATION, not by
/// tenant, from this first migration. Adding a second state later is then data
/// rather than a schema change — which is the whole reason to model it this way
/// while deliberately supporting only one.
model TradingGstRegistration {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// 15 characters: 2 state + 10 PAN + 1 entity + 1 'Z' + 1 checksum.
  gstin            String @db.VarChar(15)
  /// The state this registration is held in. Decides CGST+SGST against IGST.
  stateCode        String @map("state_code") @db.VarChar(2)
  /// regular | composition. Changes which returns are due.
  registrationType String @default("regular") @map("registration_type")

  /// "NK/26-27/". The series every invoice raised under this registration uses.
  invoiceSeriesPrefix String @map("invoice_series_prefix")

  effectiveFrom DateTime  @default(now()) @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  active        Boolean   @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  version   Int      @default(1)

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taxRules TradingTaxRule[]

  @@unique([tenantId, gstin])
  @@unique([tenantId, id], name: "trading_gst_registration_tenant_scoped_id")
  @@index([tenantId, active])
  @@map("trading_gst_registration")
}

// ---------------------------------------------------------------------------
// Plywood stage 6 — finance
//
// P2: invoice numbers come from a counter row locked inside the invoice
// transaction, not from a PostgreSQL sequence. Sequences are non-transactional
// by design, so a rolled-back invoice burns its number and leaves a gap — and
// under GST a tax invoice series must be sequential and gapless within a
// financial year. That is a legal constraint, not a preference.
//
// P3: a party's balance is DERIVED from the append-only ledger. There is no
// cached balance column on a customer or a supplier, and no running balance on a
// ledger entry. When a cache and a ledger disagree — and eventually they do —
// nobody can say which is right.
//
// P4: place of supply decides CGST + SGST against IGST, from the tenant's state
// code and the party's. The rule lives in one function and is visible.
// ---------------------------------------------------------------------------

/// The gapless counter for one invoice series in one financial year.
model TradingInvoiceSeries {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  /// "SALES", "PURCHASE" — the client's own series names.
  seriesKey     String   @map("series_key")
  /// "2026-27". Indian financial years run April to March, so a calendar year
  /// would split a series across two of them.
  financialYear String   @map("financial_year")
  /// The number the NEXT invoice will take. Read and incremented under a row
  /// lock inside the same transaction as the invoice, so a rollback returns it.
  nextNumber    Int      @default(1) @map("next_number")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  version       Int      @default(1)

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices TradingInvoice[]

  @@unique([tenantId, seriesKey, financialYear])
  @@unique([tenantId, id], name: "trading_invoice_series_tenant_scoped_id")
  @@map("trading_invoice_series")
}

/// A tax invoice, raised against a sale or a purchase.
model TradingInvoice {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  seriesId String @map("series_id") @db.Uuid

  /// Exactly one party and exactly one order, both typed and check-constrained.
  customerId      String? @map("customer_id") @db.Uuid
  supplierId      String? @map("supplier_id") @db.Uuid
  salesOrderId    String? @map("sales_order_id") @db.Uuid
  purchaseOrderId String? @map("purchase_order_id") @db.Uuid

  /// "SALES/2026-27/0001". Assembled once and stored, because the parts that
  /// compose it can be renamed and a raised invoice number never changes.
  invoiceNumber  String @map("invoice_number")
  sequenceNumber Int    @map("sequence_number")
  financialYear  String @map("financial_year")

  /// The party's state code at the moment the invoice was raised. Snapshotted
  /// rather than read through the customer, because a customer who later moves
  /// state must not retrospectively change how an old invoice was taxed.
  placeOfSupplyStateCode String @map("place_of_supply_state_code")
  supplyStateCode        String @map("supply_state_code")

  /// The seller's own identity, as it stood when the document was raised
  /// (P0-09). Snapshotted for the same reason the party's state code is: a
  /// business that renames itself, or re-registers, must not restate an
  /// invoice it has already given to a customer and reported to the portal.
  sellerLegalNameSnapshot String? @map("seller_legal_name_snapshot")
  sellerGstinSnapshot     String? @map("seller_gstin_snapshot")

  /// Basis points, snapshotted with the invoice. 2.5% is 250. A rate change next
  /// quarter must not restate a filed invoice.
  cgstRateBp Int @default(0) @map("cgst_rate_bp")
  sgstRateBp Int @default(0) @map("sgst_rate_bp")
  igstRateBp Int @default(0) @map("igst_rate_bp")

  taxablePaise Int @map("taxable_paise")
  cgstPaise    Int @default(0) @map("cgst_paise")
  sgstPaise    Int @default(0) @map("sgst_paise")
  igstPaise    Int @default(0) @map("igst_paise")
  totalPaise   Int @map("total_paise")

  /// Why this document carries no tax, when it carries none. Snapshotted from
  /// the order: the ground for an exemption is part of the document, and a
  /// reader asked about it a year later cannot go and look at an order that may
  /// since have been amended.
  taxExemptReason String? @map("tax_exempt_reason")

  issuedAt     DateTime @default(now()) @map("issued_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  version      Int      @default(1)
  customFields Json     @default("{}") @map("custom_fields")

  /// A purchase bill this system raised itself at goods receipt, from the
  /// order's own prices and the effective HSN rules, is PROVISIONAL until the
  /// supplier's document arrives. That is not a column: `trading_invoice` is
  /// immutable by trigger, so a flag on it could never be cleared. Provisional
  /// therefore means "no confirmation row", and confirming appends one.

  tenant        Tenant                           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  series        TradingInvoiceSeries             @relation(fields: [tenantId, seriesId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  customer      TradingCustomer?                 @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  supplier      TradingSupplier?                 @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  salesOrder    TradingSalesOrder?               @relation(fields: [tenantId, salesOrderId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  purchaseOrder TradingPurchaseOrder?            @relation(fields: [tenantId, purchaseOrderId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  lines         TradingInvoiceLine[]
  payments      TradingPayment[]
  allocations   TradingPaymentAllocation[]
  confirmation  TradingPurchaseBillConfirmation?
  ledgerEntries TradingLedgerEntry[]
  notes         TradingInvoiceNote[]

  @@unique([tenantId, invoiceNumber])
  @@unique([tenantId, id], name: "trading_invoice_tenant_scoped_id")
  @@index([tenantId, issuedAt])
  @@map("trading_invoice")
}

/// One line on an invoice, snapshotted whole.
model TradingInvoiceLine {
  id                  String  @id @default(uuid()) @db.Uuid
  tenantId            String  @map("tenant_id") @db.Uuid
  invoiceId           String  @map("invoice_id") @db.Uuid
  productId           String  @map("product_id") @db.Uuid
  productNameSnapshot String  @map("product_name_snapshot")
  hsnCodeSnapshot     String? @map("hsn_code_snapshot")
  qtyUnits            Int     @map("qty_units")
  unitPricePaise      Int     @map("unit_price_paise")
  lineTotalPaise      Int     @map("line_total_paise")

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice TradingInvoice @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)
  product TradingProduct @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([tenantId, id], name: "trading_invoice_line_tenant_scoped_id")
  @@index([tenantId, invoiceId])
  @@map("trading_invoice_line")
}

/// Money received against a sales invoice, or paid against a purchase one.
model TradingPayment {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  /// Nullable since Task 71. A payment is made to or received from a PARTY;
  /// which of their invoices it settles is an allocation, and a single cheque
  /// routinely settles three. This stays for the case where a payment genuinely
  /// names one document, and is set on single-allocation payments so existing
  /// per-invoice reads keep working unchanged.
  invoiceId   String?  @map("invoice_id") @db.Uuid
  /// The party. Exactly one, typed rather than a partyType/partyId pair, for
  /// the same reason the ledger entry is: a pair carries no foreign key.
  customerId  String?  @map("customer_id") @db.Uuid
  supplierId  String?  @map("supplier_id") @db.Uuid
  /// `in` — money received by this business. `out` — money it paid.
  /// Not derived from which party is set: a refund to a customer is money out
  /// against a customer, and a supplier credit refunded is money in against a
  /// supplier. Deriving it would make those two unrecordable.
  direction   String   @default("in")
  method      String
  amountPaise Int      @map("amount_paise")
  /// UTR, UPI transaction id, cheque number. Record-and-print only: no gateway
  /// and no terminal (GOV-SCO-006).
  reference   String?
  receivedAt  DateTime @default(now()) @map("received_at")
  byUserId    String   @map("by_user_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  version     Int      @default(1)

  tenant        Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice       TradingInvoice?            @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  customer      TradingCustomer?           @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  supplier      TradingSupplier?           @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  ledgerEntries TradingLedgerEntry[]
  allocations   TradingPaymentAllocation[]

  @@unique([tenantId, id], name: "trading_payment_tenant_scoped_id")
  @@index([tenantId, invoiceId])
  @@index([tenantId, customerId])
  @@index([tenantId, supplierId])
  @@map("trading_payment")
}

/// How much of one payment settled one invoice.
///
/// A cheque covering three bills is one payment and three allocations. Without
/// this table that cheque has to be entered three times, which is what made the
/// finance desk feel like double-entry homework rather than a record of what
/// happened (Task 71 item 11).
model TradingPaymentAllocation {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  paymentId   String   @map("payment_id") @db.Uuid
  invoiceId   String   @map("invoice_id") @db.Uuid
  amountPaise Int      @map("amount_paise")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment TradingPayment @relation(fields: [tenantId, paymentId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)
  invoice TradingInvoice @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([tenantId, id], name: "trading_payment_allocation_tenant_scoped_id")
  @@unique([tenantId, paymentId, invoiceId])
  @@index([tenantId, invoiceId])
  @@map("trading_payment_allocation")
}

/// The supplier's own document, arriving after the bill was already raised.
///
/// A purchase bill is raised automatically at goods receipt so the payable
/// exists the moment the goods do (Task 71 item 7). Its figures come from the
/// order and its tax split is COMPUTED — correct enough to owe money against,
/// never good enough to file as input credit, because a computed split is this
/// business's opinion of what the supplier charged rather than what they
/// actually did.
///
/// Confirming does not edit the invoice: `trading_invoice` is immutable by
/// trigger and that rule is not being weakened for convenience. The supplier's
/// number and figures are recorded here, a difference in money is corrected the
/// way every other posted difference is — a debit or credit note — and
/// "provisional" is simply the absence of this row.
model TradingPurchaseBillConfirmation {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @map("tenant_id") @db.Uuid
  invoiceId             String   @unique @map("invoice_id") @db.Uuid
  /// THEIR number, not ours. Ours is on the invoice and never changes.
  supplierInvoiceNumber String   @map("supplier_invoice_number")
  supplierInvoiceDate   DateTime @map("supplier_invoice_date")
  /// What the supplier's paper actually says, transcribed. Kept even when it
  /// equals the computed figures, because "they agreed" is itself a fact.
  taxablePaise          Int      @map("taxable_paise")
  cgstPaise             Int      @default(0) @map("cgst_paise")
  sgstPaise             Int      @default(0) @map("sgst_paise")
  igstPaise             Int      @default(0) @map("igst_paise")
  totalPaise            Int      @map("total_paise")
  confirmedAt           DateTime @default(now()) @map("confirmed_at")
  confirmedBy           String   @map("confirmed_by") @db.Uuid

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice TradingInvoice @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantId, invoiceId])
  @@unique([tenantId, id], name: "trading_purchase_bill_confirmation_tenant_scoped_id")
  @@map("trading_purchase_bill_confirmation")
}

/// One movement of money against a party. Append-only, enforced by trigger.
///
/// A balance is the sum of these (P3). There is no cached total anywhere, and no
/// running balance on the row: both would be a second source of truth that can
/// disagree with the first.
/// An accounting period, and whether it is still open to posting.
///
/// Authority: taskplans/archive/45_plywood_workflow_program.md §5, §8;
/// PLYWOOD_TARGET_WORKFLOW_GAP_AUDIT.md P0-08; specification §76, §77.
///
/// Without this, backdated stock, invoices, payments and corrections can alter
/// a month that has already been reviewed, reported and filed — and nothing
/// records that they did. A close is the moment a business says "this is what
/// happened", and it is only meaningful if the answer stops changing.
model TradingAccountingPeriod {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// "2026-08". A calendar month: the GST return period, which is what the
  /// close is actually for.
  periodKey String @map("period_key")

  /// Inclusive start, exclusive end. Stored rather than derived from the key
  /// so a query is a comparison instead of string arithmetic.
  startsAt DateTime @map("starts_at")
  endsAt   DateTime @map("ends_at")

  /// `open` | `closed`. A period is created open on first posting into it.
  state String @default("open")

  closedAt       DateTime? @map("closed_at")
  closedBy       String?   @map("closed_by") @db.Uuid
  /// Why it was reopened, and by whom. Required by the command: reopening a
  /// filed period without a stated reason is the audit finding.
  reopenedAt     DateTime? @map("reopened_at")
  reopenedBy     String?   @map("reopened_by") @db.Uuid
  reopenedReason String?   @map("reopened_reason")

  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, periodKey])
  @@unique([tenantId, id], name: "trading_accounting_period_tenant_scoped_id")
  @@index([tenantId, state])
  @@map("trading_accounting_period")
}

/// The tax that applies to an HSN code, under one registration, from a date.
///
/// Authority: taskplans/archive/45_plywood_workflow_program.md §4.4 and §D-03;
/// PLYWOOD_TARGET_WORKFLOW_GAP_AUDIT.md P0-07.
///
/// WHAT THIS REPLACES
/// Three global configuration keys holding CGST, SGST and IGST rates for the
/// whole business. Two things were wrong with that and both are the same shape:
/// a plywood sheet and a hardware fitting do not carry the same rate, and a
/// rate that changes by notification in November must not restate an invoice
/// raised in October.
///
/// Effective-dated and keyed by registration, so "the rate on the day of
/// supply, for that HSN, under that registration" is a lookup rather than an
/// assumption.
model TradingTaxRule {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  registrationId String @map("registration_id") @db.Uuid

  /// 4, 6 or 8 digits. Matched most-specific-first, so an 8-digit rule for one
  /// board beats the 4-digit rule for its chapter.
  hsnCode String @map("hsn_code")

  /// Basis points. 9% is 900. A percentage stored as a float is a rounding
  /// error waiting for a filing.
  cgstRateBp Int @default(0) @map("cgst_rate_bp")
  sgstRateBp Int @default(0) @map("sgst_rate_bp")
  igstRateBp Int @default(0) @map("igst_rate_bp")

  effectiveFrom DateTime  @map("effective_from")
  /// Null means "still in force". A superseding rule closes the one before it.
  effectiveTo   DateTime? @map("effective_to")

  /// The notification or circular this rate came from. An auditor asks.
  authority String?

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String   @map("created_by") @db.Uuid

  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  registration TradingGstRegistration @relation(fields: [tenantId, registrationId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([tenantId, id], name: "trading_tax_rule_tenant_scoped_id")
  @@index([tenantId, registrationId, hsnCode, effectiveFrom])
  @@map("trading_tax_rule")
}

/// A credit or debit note against a posted invoice.
///
/// Authority: taskplans/archive/45_plywood_workflow_program.md §5 (invoice state
/// machine) and §4.5; specification §67;
/// PLYWOOD_TARGET_WORKFLOW_GAP_AUDIT.md P0-05.
///
/// A posted invoice is immutable — the trigger refuses UPDATE for every role.
/// That is only a workable rule if there is a way to correct one, and this is
/// it. A note does not amend the invoice; it is a second document that points
/// at it, and both stand in the record afterwards. The original invoice is
/// what the customer holds and what was reported; the note is what changed.
model TradingInvoiceNote {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  invoiceId String @map("invoice_id") @db.Uuid

  /// `credit` reduces what the party owes; `debit` increases it. Named from
  /// this business's point of view, matching TradingLedgerEntry.
  noteType String @map("note_type")

  /// "CN/26-27/0001". Gapless within its own series, like every other
  /// document a tax authority may ask to see.
  noteNumber    String @map("note_number")
  financialYear String @map("financial_year")

  /// Split like an invoice, because a note carries tax and a note without a
  /// tax split cannot be reported.
  taxablePaise Int @map("taxable_paise")
  cgstPaise    Int @default(0) @map("cgst_paise")
  sgstPaise    Int @default(0) @map("sgst_paise")
  igstPaise    Int @default(0) @map("igst_paise")
  totalPaise   Int @map("total_paise")

  /// Why. Not optional: a note with no reason is the entry nobody can explain,
  /// and a tax officer asking about one is asking exactly this.
  reason String

  issuedAt DateTime @default(now()) @map("issued_at")
  issuedBy String   @map("issued_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice TradingInvoice @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([tenantId, noteNumber])
  @@unique([tenantId, id], name: "trading_invoice_note_tenant_scoped_id")
  @@index([tenantId, invoiceId])
  @@index([tenantId, issuedAt])
  @@map("trading_invoice_note")
}

model TradingLedgerEntry {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// Typed, exactly one. Not a partyType plus partyId pair — that carries no
  /// foreign key, so nothing stops an entry pointing at a deleted party.
  customerId String? @map("customer_id") @db.Uuid
  supplierId String? @map("supplier_id") @db.Uuid

  /// `debit` increases what the party owes this business; `credit` reduces it.
  /// Named from this business's point of view, consistently, because a ledger
  /// that flips perspective between customers and suppliers is unreadable.
  entryType   String @map("entry_type")
  amountPaise Int    @map("amount_paise")

  invoiceId String? @map("invoice_id") @db.Uuid
  paymentId String? @map("payment_id") @db.Uuid
  narration String?

  occurredAt DateTime @default(now()) @map("occurred_at")

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer TradingCustomer? @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  supplier TradingSupplier? @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  invoice  TradingInvoice?  @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  payment  TradingPayment?  @relation(fields: [tenantId, paymentId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  @@index([tenantId, customerId, occurredAt])
  @@index([tenantId, supplierId, occurredAt])
  @@map("trading_ledger_entry")
}

/// What the GST portal reported for a period, as imported.
///
/// NOT a ledger. Nothing posts from this table: what the business owes is what
/// its suppliers billed it, and the portal is a second opinion used to find
/// disagreements (§59). Letting an outside file change the books would be the
/// defect this shape exists to avoid.
model TradingGstPortalRecord {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  periodKey     String   @map("period_key")
  supplierGstin String   @map("supplier_gstin") @db.VarChar(15)
  supplierName  String?  @map("supplier_name")
  /// The SUPPLIER's number, which is what the portal keys on. Ours is a
  /// different number and conflating them matches nothing.
  invoiceNumber String   @map("invoice_number")
  invoiceDate   DateTime @map("invoice_date")
  taxablePaise  Int      @map("taxable_paise")
  cgstPaise     Int      @default(0) @map("cgst_paise")
  sgstPaise     Int      @default(0) @map("sgst_paise")
  igstPaise     Int      @default(0) @map("igst_paise")
  totalPaise    Int      @map("total_paise")
  importedAt    DateTime @default(now()) @map("imported_at")
  importedBy    String   @map("imported_by") @db.Uuid
  sourceRef     String?  @map("source_ref")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, periodKey, supplierGstin, invoiceNumber])
  @@unique([tenantId, id], name: "trading_gst_portal_record_tenant_scoped_id")
  @@index([tenantId, periodKey])
  @@map("trading_gst_portal_record")
}

// ===========================================================================
// CAPABILITY: ACCOUNTING (Task 72) — MVP scope only.
//
// Chart of accounts and double-entry journal/GL, per Task 72's own scope.
// NOT built here: fiscal-year period close, budgets, dimensions, or the
// statement reports (P&L, balance sheet, cash flow) — those stay
// `taskplans/72_erpclaw_capability_accounting.md`'s open follow-on, tracked
// there rather than silently claimed done.
//
// Money is integer minor units (paise), same convention as plywood/dinein
// above — this is not a new pattern, it is the existing one applied here.
// ===========================================================================

/// One entry in the chart of accounts. Never deleted — a posted JournalLine
/// references it forever, so the account is deactivated instead (same shape
/// as `TradingBrand.active`, `Asset.state`).
model Account {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  /// Short human code, e.g. "1000" — sorts the chart the way an accountant
  /// already expects, distinct from `name` which is the description.
  code         String
  name         String
  /// Closed set, not a Postgres enum: matches the platform's own preference
  /// (state `category`, `PolicyChannel`) for a small closed string set that a
  /// capability owns rather than a database-level enum a migration must alter.
  type         String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  version      Int      @default(1)
  customFields Json     @default("{}") @map("custom_fields")

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines  JournalLine[]

  @@unique([tenantId, code])
  @@unique([tenantId, id], name: "account_tenant_scoped_id")
  @@index([tenantId, type])
  @@map("account")
}

/// A posted journal entry. APPEND-ONLY (INV-002's pattern, extended per Task
/// 72's own critical requirement: "corrections are reversal/amendment
/// entries, never in-place edits"). No `active`, no `version` that increments
/// on edit — nothing here is ever edited. A wrong entry is corrected by
/// posting `reversalOfId` pointing back at it, never by touching the
/// original row. The `postJournalEntry` command enforces balance (sum of
/// debits equals sum of credits) before this row and its lines commit.
model JournalEntry {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  memo         String?
  postedAt     DateTime @default(now()) @map("posted_at")
  /// Set only on a reversal entry, pointing at the entry it reverses. Not a
  /// state transition — a JournalEntry has no state machine, it either exists
  /// (posted) or is reversed by a SEPARATE, later entry that still leaves the
  /// original readable and unchanged, which is the whole point.
  reversalOfId String?  @map("reversal_of_id") @db.Uuid
  postedById   String   @map("posted_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reversalOf JournalEntry?  @relation("JournalEntryReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy JournalEntry[] @relation("JournalEntryReversal")
  lines      JournalLine[]

  @@unique([tenantId, id], name: "journal_entry_tenant_scoped_id")
  @@index([tenantId, postedAt])
  @@map("journal_entry")
}

/// One debit or credit leg of a JournalEntry. APPEND-ONLY, same reasoning as
/// JournalEntry — see there. Exactly one of `debitMinor`/`creditMinor` is
/// non-zero per line; enforced by the command, not a CHECK constraint, since
/// the command already has to compute the entry-level balance anyway and a
/// second enforcement point would be a second place this rule could drift.
model JournalLine {
  id             String @id @default(uuid()) @db.Uuid
  tenantId       String @map("tenant_id") @db.Uuid
  journalEntryId String @map("journal_entry_id") @db.Uuid
  accountId      String @map("account_id") @db.Uuid
  debitMinor     Int    @default(0) @map("debit_minor")
  creditMinor    Int    @default(0) @map("credit_minor")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([tenantId, accountId])
  @@index([tenantId, journalEntryId])
  @@map("journal_line")
}

// ===========================================================================
// CAPABILITY: INVENTORY (Task 73) — MVP scope only.
//
// Item master, warehouse-scoped stock balances, and an append-only movement
// ledger — the same shape plywood's `stock.ts` already proves at
// client-private scale, generalized per Task 73's own scope. Warehouses
// reuse the platform `Location` primitive (ADR-004) rather than a parallel
// concept, per that taskplan's own "Verity fit" note.
//
// NOT built here: units-of-measure conversions, batch/serial tracking,
// reservations/pick lists, revaluation, item alternatives/price lists — all
// remain Task 73's own open scope, not silently claimed done.
// ===========================================================================

/// "Inventory" prefix throughout this capability's models — `StockBalance`
/// and `Item` as bare names already belong to plywood's own schema above,
/// and this is deliberately a SEPARATE, generic module (Task 73's own scope:
/// "not a fork of plywood's model"), not a rename of it.
model InventoryItemGroup {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  version   Int      @default(1)

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  InventoryItem[]

  @@unique([tenantId, name])
  @@map("inventory_item_group")
}

/// Never deleted — a posted InventoryStockMovement references it forever, so
/// a mis-entered item is deactivated (same shape as `TradingProduct.active`).
model InventoryItem {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  itemGroupId  String?  @map("item_group_id") @db.Uuid
  sku          String
  name         String
  unitLabel    String   @default("units") @map("unit_label")
  reorderLevel Int      @default(0) @map("reorder_level")
  /// Moving-average unit cost in paise, updated only by a Receipt movement
  /// that supplies `unitCostPaise` (`recordStockMovement`). Null until the
  /// first costed receipt. Extends Task 73's original quantity-only scope —
  /// decision 2026-09-10 (Colonel Kebabz phase plan): a recipe needs one
  /// ingredient ledger for both quantity and cost, so procurement (GRN) and
  /// consumption (recipe) post to the same InventoryItem rather than forking
  /// cost into `trading`'s separate ledger.
  avgUnitCostPaise Int?  @map("avg_unit_cost_paise")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  version      Int      @default(1)
  customFields Json     @default("{}") @map("custom_fields")

  tenant            Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  itemGroup         InventoryItemGroup?      @relation(fields: [itemGroupId], references: [id], onDelete: SetNull)
  balances          InventoryStockBalance[]
  purchaseOrderLines InventoryPurchaseOrderLine[]
  stockRequests      InventoryStockRequest[]
  movements         InventoryStockMovement[]
  recipeIngredients RecipeIngredient[]
  manufacturingOrderOutputs    ManufacturingOrder[]     @relation("ManufacturingOrderOutput")
  manufacturingOrderComponents ManufacturingOrderLine[] @relation("ManufacturingOrderComponent")
  manufacturingBomOutputs      ManufacturingBom[]       @relation("ManufacturingBomOutput")
  manufacturingBomComponents   ManufacturingBomLine[]   @relation("ManufacturingBomComponent")
  manufacturingReservations    ManufacturingReservation[]

  @@unique([tenantId, sku])
  @@unique([tenantId, id], name: "inventory_item_tenant_scoped_id")
  @@map("inventory_item")
}

/// Current on-hand quantity per item per location. Only ever changed
/// alongside an `InventoryStockMovement` row, in the same command/
/// transaction — never written to directly, per Task 73's own critical
/// requirement ("direct stock ledger writes are never a user-facing
/// workflow").
model InventoryStockBalance {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  itemId     String @map("item_id") @db.Uuid
  locationId String @map("location_id") @db.Uuid
  qty        Int    @default(0)

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item     InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  location Location      @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([tenantId, itemId, locationId])
  @@map("inventory_stock_balance")
}

/// APPEND-ONLY, same reasoning as `JournalEntry`/`JournalLine` above: a stock
/// movement is a historical fact. A wrong movement is corrected by posting an
/// offsetting `Adjustment` movement, never by editing this row.
model InventoryStockMovement {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  itemId     String   @map("item_id") @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  /// Closed set owned by the capability (`MOVEMENT_KINDS`), same reasoning as
  /// `Account.type` above: Receipt | Issue | Adjustment | Transfer.
  kind       String
  /// Signed: positive increases the balance, negative decreases it. One sign
  /// convention for every kind rather than "Issue always subtracts," which
  /// would make a return-of-issued-goods a special case instead of a normal
  /// positive Receipt-shaped movement.
  qty        Int
  /// Unit cost in paise for a Receipt movement — the value that folds into
  /// `InventoryItem.avgUnitCostPaise`'s moving average. Null on non-Receipt
  /// kinds and on a Receipt with no known cost (e.g. a manual stock-count
  /// correction). See `InventoryItem.avgUnitCostPaise` for why this field
  /// exists at all.
  unitCostPaise Int?  @map("unit_cost_paise")
  reference  String?
  movedById  String   @map("moved_by_id") @db.Uuid
  movedAt    DateTime @default(now()) @map("moved_at")

  tenant        Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item          InventoryItem           @relation(fields: [itemId], references: [id], onDelete: Restrict)
  location      Location                @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  wastageRecord InventoryWastageRecord?

  @@index([tenantId, itemId])
  @@index([tenantId, locationId, movedAt])
  @@map("inventory_stock_movement")
}

/// Wastage detail for one Adjustment movement (PRD §20). Item, quantity,
/// outlet, staff, and date/time already live on the InventoryStockMovement
/// this row attaches to (kind=Adjustment, negative qty) — this table adds
/// only what's genuinely new: reason, a value snapshot, notes, and an
/// optional Evidence photo. `valuePaise` is a SNAPSHOT (qty x the item's
/// avgUnitCostPaise at recording time), never re-derived later — a wastage
/// report a year on should show what it cost then, not what the ingredient
/// costs now. Approval-if-required (the PRD's own phrase) is not built:
/// no threshold has been decided yet — see phase-plan's open decisions.
model InventoryWastageRecord {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  movementId String   @unique @map("movement_id") @db.Uuid
  /// Closed set owned by the capability (`WASTAGE_REASONS`) — PRD §20's own
  /// list, same reasoning as MovementKind above.
  reason     String
  valuePaise Int      @map("value_paise")
  notes      String?
  evidenceId String?  @map("evidence_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  tenant   Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  movement InventoryStockMovement @relation(fields: [movementId], references: [id], onDelete: Cascade)

  @@map("inventory_wastage_record")
}

// ===========================================================================
// CAPABILITY: Inventory procurement (Colonel Kebabz parity, procurement.md §7;
// decision 2026-10-06: inventory-native, trading's purchase flow untouched).
// A purchase order buys `InventoryItem`s for one outlet; receiving goods posts
// Receipt movements to the same ledger a count or a sale uses, so there is one
// stock ledger. Money is paise, like the rest of inventory. A goods receipt is
// a historical fact (append-only); the order's received/rejected totals are the
// running summary of its receipts.
// ===========================================================================

model InventoryVendor {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  name             String
  gstin            String?
  phone            String?
  paymentTermsDays Int      @default(0) @map("payment_terms_days")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant         Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrders InventoryPurchaseOrder[]
  payments       InventoryVendorPayment[]

  @@unique([tenantId, name])
  @@map("inventory_vendor")
}

model InventoryPurchaseOrder {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  /// Per-tenant running number; shown as PO-0001.
  seq          Int
  vendorId     String    @map("vendor_id") @db.Uuid
  locationId   String    @map("location_id") @db.Uuid
  /// Closed set owned by the capability (`PO_STATUSES`), CHECKed in the database.
  status       String    @default("Draft")
  expectedDate DateTime? @map("expected_date") @db.Date
  notes        String?
  totalPaise   Int       @map("total_paise")
  createdById  String    @map("created_by_id") @db.Uuid
  approvedById String?   @map("approved_by_id") @db.Uuid
  approvedAt   DateTime? @map("approved_at")
  cancelReason String?   @map("cancel_reason")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant   Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendor   InventoryVendor              @relation(fields: [vendorId], references: [id])
  location Location                     @relation(fields: [locationId], references: [id])
  lines    InventoryPurchaseOrderLine[]
  receipts InventoryGoodsReceipt[]

  @@unique([tenantId, seq])
  @@index([tenantId, status])
  @@map("inventory_purchase_order")
}

model InventoryPurchaseOrderLine {
  id             String @id @default(uuid()) @db.Uuid
  tenantId       String @map("tenant_id") @db.Uuid
  orderId        String @map("order_id") @db.Uuid
  itemId         String @map("item_id") @db.Uuid
  qty            Int
  unitPricePaise Int    @map("unit_price_paise")
  /// Accepted into stock so far. A rejected quantity is not received: the line
  /// stays open for the replacement.
  receivedQty    Int    @default(0) @map("received_qty")
  rejectedQty    Int    @default(0) @map("rejected_qty")

  tenant       Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order        InventoryPurchaseOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item         InventoryItem               @relation(fields: [itemId], references: [id])
  receiptLines InventoryGoodsReceiptLine[]

  @@index([orderId])
  @@map("inventory_purchase_order_line")
}

model InventoryGoodsReceipt {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  orderId      String   @map("order_id") @db.Uuid
  receivedById String   @map("received_by_id") @db.Uuid
  /// The supplier's invoice or delivery note number, as written on the paper.
  invoiceRef   String?  @map("invoice_ref")
  receivedAt   DateTime @default(now()) @map("received_at")

  tenant Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  InventoryPurchaseOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lines  InventoryGoodsReceiptLine[]

  @@index([orderId])
  @@map("inventory_goods_receipt")
}

model InventoryGoodsReceiptLine {
  id             String  @id @default(uuid()) @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  receiptId      String  @map("receipt_id") @db.Uuid
  orderLineId    String  @map("order_line_id") @db.Uuid
  acceptedQty    Int     @map("accepted_qty")
  rejectedQty    Int     @default(0) @map("rejected_qty")
  rejectReason   String? @map("reject_reason")
  /// The price actually charged, which can differ from the order.
  unitPricePaise Int     @map("unit_price_paise")

  tenant    Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  receipt   InventoryGoodsReceipt      @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  orderLine InventoryPurchaseOrderLine @relation(fields: [orderLineId], references: [id])

  @@index([receiptId])
  @@map("inventory_goods_receipt_line")
}

/// An outlet asking for an item; approval sends it from a chosen outlet.
model InventoryStockRequest {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  itemId         String    @map("item_id") @db.Uuid
  toLocationId   String    @map("to_location_id") @db.Uuid
  qty            Int
  reason         String?
  /// Requested | Approved | Rejected (CHECKed in the database).
  status         String    @default("Requested")
  requestedById  String    @map("requested_by_id") @db.Uuid
  decidedById    String?   @map("decided_by_id") @db.Uuid
  decidedAt      DateTime? @map("decided_at")
  fromLocationId String?   @map("from_location_id") @db.Uuid
  decisionNote   String?   @map("decision_note")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item       InventoryItem @relation(fields: [itemId], references: [id])
  toLocation Location      @relation(fields: [toLocationId], references: [id])

  @@index([tenantId, status])
  @@map("inventory_stock_request")
}

/// Money paid to a vendor. Append-only; what is owed is derived.
model InventoryVendorPayment {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  vendorId    String   @map("vendor_id") @db.Uuid
  amountPaise Int      @map("amount_paise")
  method      String
  reference   String?
  paidById    String   @map("paid_by_id") @db.Uuid
  paidAt      DateTime @default(now()) @map("paid_at")

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendor InventoryVendor @relation(fields: [vendorId], references: [id])

  @@index([vendorId])
  @@map("inventory_vendor_payment")
}

// ===========================================================================
// CAPABILITY: Manufacturing (Task 118 minimal slice) — ManufacturingOrder
// only. Composes existing platform primitives rather than reimplementing
// them: `Location` for where consumption/production happens, `InventoryItem`
// for both components and output, `InventoryStockMovement`/
// `InventoryStockBalance` for the actual stock ledger (this capability never
// keeps its own qty-on-hand column — see `manufacturing/index.ts`'s
// source-of-truth note). NOT YET BUILT, deliberately deferred per
// `taskplans/118_manufacturing_capability_odoo_gap_and_ux_completeness.md`:
// lot/serial, work-center capacity/cost, BOM cost roll-up, QC evidence
// wiring, putaway rules, backorders, `recipe` generalization. This does not
// reuse `Recipe`/`RecipeIngredient` (Colonel Kebabz, keyed 1:1 to
// `MenuItem`) — wrong fit, forcing a manufacturing order to fake a
// `menuItemId`. Lines are their own snapshot per order instead.
// ===========================================================================

/// One production run: consume `lines`' components, produce `outputQty` of
/// `outputItem`. Draft -> InProgress -> Completed | Cancelled (ADR-009).
model ManufacturingOrder {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  /// What this order produces. Distinct from every line's `componentItemId` —
  /// enforced in the command, not just by convention.
  outputItemId String @map("output_item_id") @db.Uuid
  outputQty    Int    @map("output_qty")
  /// Tenant-facing label, same free-text-but-kept posture as
  /// `TradingPurchaseOrder.reference` — no generator in this minimal slice.
  reference    String?
  state        String   @default("draft")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  version      Int      @default(1)
  customFields Json     @default("{}") @map("custom_fields")
  /// The BOM this order was made from, when it was. Traceability only: the
  /// lines are a snapshot, so the BOM changing later never touches this order.
  bomId        String?  @map("bom_id") @db.Uuid
  /// The consolidation batch this order belongs to, while it does.
  batchId      String?  @map("batch_id") @db.Uuid

  operations ManufacturingOperation[]
  passports  ManufacturingPassport[]
  dispatches ManufacturingDispatch[]
  reservations ManufacturingReservation[]
  batch      ManufacturingBatch?      @relation(fields: [batchId], references: [id], onDelete: SetNull)
  bom        ManufacturingBom?        @relation(fields: [bomId], references: [id], onDelete: Restrict)
  tenant     Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location   Location                 @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  outputItem InventoryItem            @relation("ManufacturingOrderOutput", fields: [outputItemId], references: [id], onDelete: Restrict)
  lines      ManufacturingOrderLine[]

  @@index([tenantId, state])
  @@map("manufacturing_order")
}

/// A component this order consumes, snapshotted at creation — never edited
/// after the order leaves `draft` (same posture as a trading order line's
/// product snapshot). `qtyRequired` is the TOTAL for the whole order, not a
/// per-unit rate — this slice does not scale lines by `outputQty`.
model ManufacturingOrderLine {
  id                   String @id @default(uuid()) @db.Uuid
  tenantId             String @map("tenant_id") @db.Uuid
  manufacturingOrderId String @map("manufacturing_order_id") @db.Uuid
  componentItemId      String @map("component_item_id") @db.Uuid
  qtyRequired          Int    @map("qty_required")

  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  manufacturingOrder ManufacturingOrder @relation(fields: [manufacturingOrderId], references: [id], onDelete: Cascade)
  componentItem      InventoryItem      @relation("ManufacturingOrderComponent", fields: [componentItemId], references: [id], onDelete: Restrict)

  @@unique([manufacturingOrderId, componentItemId])
  @@map("manufacturing_order_line")
}

/// A reusable Bill of Materials template (Task 118, first design partner Carxen:
/// custom car seat covers, many vehicle variants sharing one component recipe).
///
/// Per-UNIT quantities: an order from this BOM scales each line by the order's
/// `outputQty`. An order SNAPSHOTS the scaled lines when it is created, so a BOM
/// changing later never rewrites an order already made. Vehicle-specific
/// attributes (make, model, year, seat type) live in `customFields`, never as
/// columns (PLA-EXT-001). Archived (`active = false`), never deleted: an order's
/// `bomId` must keep pointing at what it was made from.
model ManufacturingBom {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  /// Tenant-facing, unique per tenant. A new revision takes a new code.
  code         String
  name         String
  outputItemId String   @map("output_item_id") @db.Uuid
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  version      Int      @default(1)
  customFields Json     @default("{}") @map("custom_fields")

  tenant     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outputItem InventoryItem         @relation("ManufacturingBomOutput", fields: [outputItemId], references: [id], onDelete: Restrict)
  lines      ManufacturingBomLine[]
  orders     ManufacturingOrder[]

  @@unique([tenantId, code])
  @@index([tenantId, active])
  @@map("manufacturing_bom")
}

model ManufacturingBomLine {
  id              String @id @default(uuid()) @db.Uuid
  tenantId        String @map("tenant_id") @db.Uuid
  bomId           String @map("bom_id") @db.Uuid
  componentItemId String @map("component_item_id") @db.Uuid
  /// Consumed to make ONE unit of the BOM's output.
  qtyPerUnit      Int    @map("qty_per_unit")

  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bom           ManufacturingBom @relation(fields: [bomId], references: [id], onDelete: Cascade)
  componentItem InventoryItem    @relation("ManufacturingBomComponent", fields: [componentItemId], references: [id], onDelete: Restrict)

  @@unique([bomId, componentItemId])
  @@map("manufacturing_bom_line")
}

/// A reusable production route: an ordered list of stages (Task 118, from
/// Carxen's factory floor: CAD, Cutting, Stitching, QC, Packing). The stages are
/// the TENANT'S DATA, never an enum: a department chain is exactly the kind of
/// thing the platform must not hard-code (CLAUDE.md forbidden pattern 2).
model ManufacturingRoute {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  version   Int      @default(1)

  tenant Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stages ManufacturingRouteStage[]

  @@unique([tenantId, code])
  @@map("manufacturing_route")
}

model ManufacturingRouteStage {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  routeId  String @map("route_id") @db.Uuid
  sequence Int
  /// Stable machine key (`cutting`), unique within the route. The label is presentation.
  stageKey String @map("stage_key")
  label    String
  /// The stage's QC checklist template: [{key, label, requireEvidence, requireRemarks}].
  /// Copied onto each operation when an order is planned, so editing a route later
  /// never changes the checklist an order already carries.
  checkpoints Json @default("[]")

  tenant Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  route  ManufacturingRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([routeId, sequence])
  @@unique([routeId, stageKey])
  @@map("manufacturing_route_stage")
}

/// One stage of one order (Task 118). Append-only in spirit: a QC send-back never
/// edits history, it CANCELS the open operations and appends fresh ones with
/// `reworkOfId` pointing at what is being redone (ADR-009: correct by new fact).
/// An operation is actionable when it is `pending` and every lower-sequence
/// operation of the order is completed or cancelled.
model ManufacturingOperation {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  orderId       String    @map("order_id") @db.Uuid
  sequence      Int
  stageKey      String    @map("stage_key")
  label         String
  /// pending | in_progress | on_hold | completed | cancelled (ADR-009 categories:
  /// Pending, Active, Blocked, Completed, Cancelled).
  state         String    @default("pending")
  /// The most recent reason: why it is on hold, or why it was sent back.
  note          String?
  /// Snapshot of the stage's checklist at planning time (see the route stage).
  checkpoints   Json      @default("[]")
  reworkOfId    String?   @map("rework_of_id") @db.Uuid
  startedAt     DateTime? @map("started_at")
  startedById   String?   @map("started_by_id") @db.Uuid
  completedAt   DateTime? @map("completed_at")
  completedById String?   @map("completed_by_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  version       Int       @default(1)

  tenant   Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order    ManufacturingOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reworkOf ManufacturingOperation? @relation("OperationRework", fields: [reworkOfId], references: [id], onDelete: Restrict)
  reworks  ManufacturingOperation[] @relation("OperationRework")
  results  ManufacturingCheckpointResult[]

  @@unique([orderId, sequence])
  @@index([tenantId, state, stageKey])
  @@map("manufacturing_operation")
}

/// A published, revocable verification passport for one COMPLETED order (ADR-030).
///
/// Public by deliberate act, never by default. The public page reads ONLY this
/// table's frozen `snapshot`, through one SECURITY DEFINER function keyed by the
/// token hash; it never reads live order or QC data, so a later change cannot
/// silently alter what a printed code says. A rework or recall is a revocation
/// plus a new issue. The token is shown once at issue and only its hash is kept.
model ManufacturingPassport {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  orderId     String    @map("order_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  /// The minimal public projection (tenant name, product, reference, passed checks).
  snapshot    Json
  issuedById  String?   @map("issued_by_id") @db.Uuid
  issuedAt    DateTime  @default(now()) @map("issued_at")
  revokedAt   DateTime? @map("revoked_at")
  revokedById String?   @map("revoked_by_id") @db.Uuid

  tenant Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  ManufacturingOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, orderId])
  @@map("manufacturing_passport")
}

/// One QC finding for one checkpoint of one operation. APPEND-ONLY (a database
/// trigger refuses UPDATE, and DELETE for the application role): a failed check
/// is a fact, and a later passing re-inspection is a NEW row. The latest row per
/// checkpoint is the current verdict; the earlier ones are the history that shows
/// an item was inspected, failed and fixed. `evidenceId` points at a captured
/// `Evidence` row, which is itself immutable.
model ManufacturingCheckpointResult {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  operationId   String   @map("operation_id") @db.Uuid
  checkpointKey String   @map("checkpoint_key")
  /// pass | fail
  result        String
  remarks       String?
  evidenceId    String?  @map("evidence_id") @db.Uuid
  recordedById  String?  @map("recorded_by_id") @db.Uuid
  recordedAt    DateTime @default(now()) @map("recorded_at")

  tenant    Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  operation ManufacturingOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  evidence  Evidence?              @relation(fields: [evidenceId], references: [id], onDelete: Restrict)

  @@index([operationId, checkpointKey, recordedAt])
  @@map("manufacturing_checkpoint_result")
}

// ===========================================================================
// CAPABILITY: Recipe (Colonel Kebabz Phase 1) — PRD §14-16: Recipe
// Management, Recipe BOM, Food Cost.
//
// One MenuItem has at most one Recipe (BOM), which lists InventoryItem
// ingredients and quantities. This is the load-bearing abstraction the
// phase plan names: MenuItem (what's sold) -> Recipe/BOM (what's consumed)
// -> InventoryItem (what's stocked) -> InventoryStockMovement (the ledger).
// `dinein.settle_bill` calls into this capability to post the theoretical
// consumption for each served line once a bill settles (order completed).
// ===========================================================================

/// A menu item's Bill of Materials. 1:1 with MenuItem — a variant-specific
/// recipe is out of this slice's scope (PRD gives no per-variant example).
model Recipe {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  menuItemId String   @map("menu_item_id") @db.Uuid
  /// Portions this BOM produces in one batch — ingredient quantities scale
  /// by (order qty / yieldQty). Almost always 1 (one recipe = one portion).
  yieldQty   Int      @default(1) @map("yield_qty")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  version    Int      @default(1)

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  menuItem    MenuItem           @relation(fields: [tenantId, menuItemId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)
  ingredients RecipeIngredient[]

  @@unique([tenantId, menuItemId])
  @@unique([tenantId, id], name: "recipe_tenant_scoped_id")
  @@map("recipe")
}

/// One BOM line — an ingredient quantity per Recipe.
model RecipeIngredient {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  recipeId        String   @map("recipe_id") @db.Uuid
  inventoryItemId String   @map("inventory_item_id") @db.Uuid
  /// Decimal, not Int — ingredient quantities are fractional (8g spices,
  /// 12ml oil per the PRD's own example), unlike InventoryStockMovement's
  /// whole-unit ledger.
  qty             Decimal  @db.Decimal(12, 3)
  unitLabel       String   @map("unit_label")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  version         Int      @default(1)

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipe        Recipe        @relation(fields: [tenantId, recipeId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)
  inventoryItem InventoryItem @relation(fields: [tenantId, inventoryItemId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([tenantId, recipeId, inventoryItemId])
  @@unique([tenantId, id], name: "recipe_ingredient_tenant_scoped_id")
  @@map("recipe_ingredient")
}

// ===========================================================================
// CAPABILITY: CRM (Colonel Kebabz Phase 2, lean V1) — PRD §28-30: Customer
// CRM, Customer 360, Segmentation.
//
// A walk-in diner is not a Party (ADR-001, ADR-007) — Customer is a new,
// tenant-scoped, capability-private identity concept matched by phone
// number, never the platform's Party. Spend/visit/AOV/last-order are
// deliberately NOT columns here — computed at query time from
// DiningOrder/Bill joined on phone, so there is one ledger for that data,
// not a cached copy that can drift. Segmentation (VIP/Frequent/At
// Risk/...) is query filters over those same derived numbers, not a stored
// segment table. Lean V1 scope decision 2026-09-10: no loyalty, coupons,
// campaigns, reviews, or complaints in this capability — each is its own
// later slice.
// ===========================================================================

model Customer {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  phone               String
  name                String?
  email               String?
  birthday            DateTime? @db.Date
  marketingConsent    Boolean   @default(false) @map("marketing_consent")
  preferredLocationId String?   @map("preferred_location_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  version             Int       @default(1)

  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  preferredLocation Location?           @relation(fields: [tenantId, preferredLocationId], references: [tenantId, id], onDelete: SetNull, onUpdate: NoAction)
  loyaltyEntries    LoyaltyPointEntry[]
  complaints        Complaint[]

  @@unique([tenantId, phone])
  @@map("customer")
}

/// A saved guest filter (Task 125 item 5.2). Membership is computed live from
/// settled bills; nothing here lists guests. At least one filter is set.
model CustomerSegment {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  name               String
  minVisits          Int?     @map("min_visits")
  minSpendMinor      Int?     @map("min_spend_minor")
  daysSinceLastOrder Int?     @map("days_since_last_order")
  createdByUserId    String   @map("created_by_user_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@map("customer_segment")
}

/// Append-only points ledger (PRD §31, lean V1: points only — no tiers,
/// birthday/anniversary automation, or visit rewards, per the 2026-09-10
/// scope correction). Positive = earned, negative = redeemed. Balance is
/// SUM(points), never a stored running total — same ledger reasoning as
/// InventoryStockMovement.
model LoyaltyPointEntry {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  points     Int
  /// Closed set owned by the capability: "earn" | "redeem" | "adjustment".
  reason     String
  billId     String?  @map("bill_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId])
  @@map("loyalty_point_entry")
}

/// PRD §32, lean V1: percent/flat discount codes only — no Buy-X-Get-Y,
/// item/category-scoped, first-order, returning-customer, outlet-specific,
/// or time-specific offer types (all deferred per the 2026-09-10 scope
/// correction). `value` is basis points for Percent, paise for Flat — same
/// integer-money convention as everywhere else in this schema.
model Coupon {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  code               String
  /// Closed set owned by the capability: "Percent" | "Flat".
  discountType       String    @map("discount_type")
  value              Int
  minOrderValueMinor Int?      @map("min_order_value_minor")
  usageLimit         Int?      @map("usage_limit")
  usedCount          Int       @default(0) @map("used_count")
  active             Boolean   @default(true)
  expiresAt          DateTime? @map("expires_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  version            Int       @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@map("coupon")
}

/// PRD §36-37: Complaint Management + Service Recovery, lean V1. `status`
/// is a plain closed-set string (New|Assigned|InProgress|AwaitingCustomer|
/// Resolved|Closed) validated in code, NOT wired into the platform's full
/// StateDefinition/transition machinery — a complaint ticket doesn't need
/// SLA clocks or guarded transitions for this cycle; deliberately lighter
/// than dinein's order/table state machine. Service recovery
/// (compensation) lives on the same row rather than a separate entity —
/// PRD §37 frames it as "how this complaint was resolved," not an
/// independent workflow.
model Complaint {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  locationId        String    @map("location_id") @db.Uuid
  customerId        String?   @map("customer_id") @db.Uuid
  orderId           String?   @map("order_id") @db.Uuid
  category          String
  /// Closed set owned by the capability: "Low" | "Medium" | "High" | "Critical".
  severity          String
  description       String
  assignedToUserId  String?   @map("assigned_to_user_id") @db.Uuid
  status            String    @default("New")
  resolution        String?
  /// Closed set: "Coupon" | "Refund" | "Replacement" | "Complimentary" |
  /// "LoyaltyPoints" | null (no compensation issued).
  compensationType  String?   @map("compensation_type")
  /// Paise for Coupon/Refund/Complimentary, point count for LoyaltyPoints.
  compensationValue Int?      @map("compensation_value")
  closedAt          DateTime? @map("closed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  version           Int       @default(1)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location  @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, locationId])
  @@map("complaint")
}

// ===========================================================================
// CAPABILITY: Finance (Colonel Kebabz Phase 4, lean V1) — PRD §44-46, 48-49:
// Expense Management, Cash Management, Payment Management (already covered
// by dinein.salesSummary's own byMethod breakdown — zero new schema for
// §46), Finance Dashboard, Outlet P&L.
//
// §47 (Delivery Platform Reconciliation) is NOT built — blocked on a real
// Zomato/Swiggy integration decision (external credentials, API contract),
// same posture as every other external-dependency item this project flags.
// ===========================================================================

/// PRD §44. `category`/`paymentMethod` are closed sets owned by the
/// capability (EXPENSE_CATEGORIES / the payment-method vocabulary
/// dinein.recordPayment already uses). Binary approve/reject, not a chain
/// — same lean posture as coupon/wastage this session; `approval`'s
/// multi-step chain is reusable later if a real threshold is decided.
model Expense {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  locationId   String    @map("location_id") @db.Uuid
  category     String
  vendor       String?
  amountMinor  Int       @map("amount_minor")
  paymentMethod String   @map("payment_method")
  expenseDate  DateTime  @map("expense_date") @db.Date
  receiptEvidenceId String? @map("receipt_evidence_id") @db.Uuid
  status       String    @default("Pending")
  recordedById String    @map("recorded_by_id") @db.Uuid
  approvedById String?   @map("approved_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  version      Int       @default(1)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  @@index([tenantId, locationId, expenseDate])
  @@map("expense")
}

/// Money in or out of the till that is not a sale, refund or approved expense
/// (Task 125 item 4.1). Append-only; corrected by an opposite entry.
model CashMovement {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  locationId       String   @map("location_id") @db.Uuid
  movementDate     DateTime @map("movement_date") @db.Date
  /// 'in' or 'out'; `kind` must match (a check constraint holds the pairing).
  direction        String
  kind             String
  amountMinor      Int      @map("amount_minor")
  reason           String
  recordedByUserId String   @map("recorded_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  @@index([tenantId, locationId, movementDate])
  @@map("cash_movement")
}

/// PRD §45: Opening Cash + Cash Sales - Cash Expenses - Withdrawals =
/// Expected Cash, compared with actual. `openingCashMinor`/
/// `cashWithdrawnMinor`/`actualCashMinor` are the only genuinely NEW inputs
/// — cash sales and cash expenses are derived at query time from existing
/// Bill/Payment and Expense data, never duplicated here.
model DailyCashReconciliation {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  locationId        String   @map("location_id") @db.Uuid
  date              DateTime @db.Date
  openingCashMinor  Int      @map("opening_cash_minor")
  cashWithdrawnMinor Int     @default(0) @map("cash_withdrawn_minor")
  actualCashMinor   Int?     @map("actual_cash_minor")
  varianceNote      String?  @map("variance_note")
  recordedById      String   @map("recorded_by_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  version           Int      @default(1)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([tenantId, locationId, date])
  @@map("daily_cash_reconciliation")
}

// ===========================================================================
// CAPABILITY: Attendance (Colonel Kebabz Phase 3, lean V1) — PRD §39-40, 42:
// Attendance, Shift Management, Payroll Inputs.
//
// A sibling to `hr`, not a fork of it — Task 78's own header comment
// explicitly scopes `hr` to "people operations before payroll" and excludes
// attendance/shifts/payroll. Payroll inputs (§42) are derived at query time
// from AttendanceRecord (days worked, hours, late/absent/leave counts) —
// never a stored payroll entity; Verity supplies payroll-READY data, not a
// payroll engine, per the PRD's own framing. Lean V1 drops: overtime as a
// distinct tracked figure, late deductions, incentives, advances, and
// shift-gap detection (needs a shift-template concept nothing asks for
// yet) — all per the 2026-09-10 scope correction.
// ===========================================================================

/// One row per employee per day. `status` is a closed set owned by the
/// capability (`ATTENDANCE_STATUSES`). Upserted by (tenantId, employeeId,
/// date) — a second check-in the same day corrects the same row, it does
/// not create a duplicate attendance fact for that day.
model AttendanceRecord {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  employeeId String    @map("employee_id") @db.Uuid
  date       DateTime  @db.Date
  status     String
  checkInAt  DateTime? @map("check_in_at")
  checkOutAt DateTime? @map("check_out_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  version    Int       @default(1)

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, employeeId, date])
  @@map("attendance_record")
}

/// A shift assignment — free-text `label` (Morning/Evening/Night are the
/// client's own vocabulary, not a platform enum) with plain HH:MM start/end.
model Shift {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  date       DateTime @db.Date
  label      String
  startTime  String   @map("start_time")
  endTime    String   @map("end_time")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  version    Int      @default(1)

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location   @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  employee HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, locationId, date])
  @@map("shift")
}

// ===========================================================================
// CAPABILITY: HR (Task 78) — MVP scope only.
//
// "People operations before payroll" — Task 78's own framing. An Employee is
// additional HR-specific attributes on an EXISTING Party, never a second
// identity record (INV-003, ADR-008: HR sits above scheduling, does not
// redefine Resource/Party). Leave decisions are a separate, append-only
// table rather than a mutable status column on LeaveApplication, per Task
// 78's own critical requirement ("no in-place status edits").
//
// NOT built here: designations/lifecycle events/documents, attendance,
// holiday lists, shift types, expense claims — all remain Task 78's own
// open scope.
// ===========================================================================

model HrDepartment {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  version   Int      @default(1)

  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees HrEmployee[]

  @@unique([tenantId, name])
  @@map("hr_department")
}

/// The Party is the identity (INV-003); this row is what HR knows about them
/// that a bare `TenantMembership` does not. Never deleted — deactivated, so
/// leave history stays attributable.
model HrEmployee {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  partyId       String    @map("party_id") @db.Uuid
  departmentId  String?   @map("department_id") @db.Uuid
  designation   String?
  dateOfJoining DateTime? @map("date_of_joining")
  /// Readable and editable only with `verity.hr.compensation` (DECISIONS.md #3).
  monthlySalaryMinor Int? @map("monthly_salary_minor")
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  version       Int       @default(1)
  customFields  Json      @default("{}") @map("custom_fields")

  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  party             Party                @relation(fields: [partyId], references: [id], onDelete: Restrict)
  department        HrDepartment?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  leaveApps         HrLeaveApplication[]
  attendanceRecords AttendanceRecord[]
  shifts            Shift[]

  @@unique([tenantId, partyId])
  @@map("hr_employee")
}

model HrLeaveType {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  name        String
  daysPerYear Int     @map("days_per_year")
  active      Boolean @default(true)

  tenant Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  apps   HrLeaveApplication[]

  @@unique([tenantId, name])
  @@map("hr_leave_type")
}

/// Immutable once applied — a correction is a new application plus, if the
/// first was already decided, a decision reversal is a fresh
/// `HrLeaveDecision` row, never an edit of either.
model HrLeaveApplication {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  employeeId  String   @map("employee_id") @db.Uuid
  leaveTypeId String   @map("leave_type_id") @db.Uuid
  fromDate    DateTime @map("from_date")
  toDate      DateTime @map("to_date")
  reason      String?
  appliedAt   DateTime @default(now()) @map("applied_at")

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee  HrEmployee        @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  leaveType HrLeaveType       @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  decisions HrLeaveDecision[]

  @@index([tenantId, employeeId])
  @@map("hr_leave_application")
}

/// APPEND-ONLY. One application may accumulate more than one decision row
/// over time (e.g. approved, later revoked by a second decision) — the
/// current status is "the latest row," never a field that gets overwritten.
model HrLeaveDecision {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  leaveApplicationId String   @map("leave_application_id") @db.Uuid
  /// Closed set owned by the capability: Approved | Rejected | Revoked.
  decision           String
  decidedById        String   @map("decided_by_id") @db.Uuid
  note               String?
  decidedAt          DateTime @default(now()) @map("decided_at")

  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leaveApplication HrLeaveApplication @relation(fields: [leaveApplicationId], references: [id], onDelete: Cascade)

  @@index([tenantId, leaveApplicationId])
  @@map("hr_leave_decision")
}

// ===========================================================================
// CAPABILITY: BILLING (Task 77) — MVP scope only.
//
// Metered/recurring billing, deliberately separate from one-off sales
// invoicing (Task 74, not built) per Task 77's own scope. A Meter bills a
// Party directly (unified identity, same reasoning as HrEmployee above) —
// no generic Customer entity exists yet to route through instead.
//
// NOT built here: rate tiers / time-of-use / demand pricing (flat
// rate-per-unit only), prepaid credit, a tracked BillingRun with per-target
// resume/retry (Task 91's `runCommandBatch` is the natural fit for that —
// call `generateInvoiceForMeter` once per meter through it rather than this
// capability reinventing batch-progress tracking), adjustments. The
// database's own unique constraint on (tenantId, meterId, billingPeriodId)
// is what actually satisfies "a billing period cannot be invoiced twice" —
// simpler and harder to get wrong than an application-level check.
// ===========================================================================

model BillingMeter {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  partyId          String   @map("party_id") @db.Uuid
  name             String
  ratePerUnitMinor Int      @map("rate_per_unit_minor")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  version          Int      @default(1)

  tenant   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  party    Party                 @relation(fields: [partyId], references: [id], onDelete: Restrict)
  readings BillingMeterReading[]
  invoices BillingInvoice[]

  @@index([tenantId, partyId])
  @@map("billing_meter")
}

/// APPEND-ONLY — a meter reading is a historical fact, corrected by a later
/// reading, never by editing this row.
model BillingMeterReading {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  meterId      String   @map("meter_id") @db.Uuid
  readingUnits Int      @map("reading_units")
  readAt       DateTime @default(now()) @map("read_at")
  recordedById String   @map("recorded_by_id") @db.Uuid

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  meter  BillingMeter @relation(fields: [meterId], references: [id], onDelete: Restrict)

  @@index([tenantId, meterId, readAt])
  @@map("billing_meter_reading")
}

model BillingPeriod {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  periodStart DateTime  @map("period_start")
  periodEnd   DateTime  @map("period_end")
  closedAt    DateTime? @map("closed_at")

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices BillingInvoice[]

  @@map("billing_period")
}

/// APPEND-ONLY, one per (meter, period) by unique constraint — the
/// enforcement of "cannot be invoiced twice," not an application check.
model BillingInvoice {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  meterId         String   @map("meter_id") @db.Uuid
  billingPeriodId String   @map("billing_period_id") @db.Uuid
  usageUnits      Int      @map("usage_units")
  amountMinor     Int      @map("amount_minor")
  generatedAt     DateTime @default(now()) @map("generated_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  meter         BillingMeter  @relation(fields: [meterId], references: [id], onDelete: Restrict)
  billingPeriod BillingPeriod @relation(fields: [billingPeriodId], references: [id], onDelete: Restrict)

  @@unique([tenantId, meterId, billingPeriodId])
  @@map("billing_invoice")
}

// ===========================================================================
// PLYWOOD METRIC SNAPSHOTS (Task 100) — the missing prerequisite the
// dashboard-direction writeup didn't name.
//
// `charts.tsx`'s own rule: "no sample data, no smoothing, no projected
// series". A sparkline needs a real time series; every Overview number
// today is a live aggregate, not retained history. This table is that
// history, captured once daily by a scheduled job
// (`verity.plywood.capture_metric_snapshot`) reusing the exact same SQL
// expressions `ownerConsole` already uses for stock value/receivables/
// payables (source-of-truth discipline, Task 82's skill) — just at
// whole-tenant scope, since a scheduled job has no actor to scope by
// godown, and a business snapshot should track the whole business anyway.
//
// Deliberately capability-private (plywood), not a platform primitive —
// same "one client's need means platform primitive" discipline as every
// other capability this session, applied to Task 100's own reasoning
// about not adopting shadcn/a chart library ahead of real need either.
// ===========================================================================

model TradingMetricSnapshot {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  /// One row per tenant per calendar day (business timezone) — the unique
  /// constraint below is what makes daily capture idempotent under retry.
  snapshotDate     DateTime @map("snapshot_date") @db.Date
  salesTodayPaise  Int      @map("sales_today_paise")
  stockValuePaise  Int      @map("stock_value_paise")
  receivablesPaise Int      @map("receivables_paise")
  payablesPaise    Int      @map("payables_paise")
  capturedAt       DateTime @default(now()) @map("captured_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, snapshotDate])
  @@map("trading_metric_snapshot")
}

// Global pre-authentication counters. Runtime access is function-only; see
// 20260908000000_shared_request_quotas for RLS and restricted SQL privileges.
model RequestQuota {
  keyHash  String   @map("key_hash")
  kind     String
  resetsAt DateTime @map("resets_at") @db.Timestamptz(6)
  attempts Int

  @@id([keyHash, kind])
  @@index([resetsAt], map: "request_quota_expiry")
  @@map("request_quota")
}

// ===========================================================================
// CAPABILITY: OUTREACH — `verity.capability.outreach` (Task 105, P0 scope)
//
// Authority: `taskplans/105_pa_oms_outreach_capability.md`, grounded in
// `clients/pa-oms/PlotArmour_Outreach_Team_Management_System_Master_Context.md`
// (build brief) and `clients/pa-oms/handbook-outreach.html` (operating
// constitution — the higher-ranked authority for exact field/state values,
// per the handbook's own Ch. 00 source-of-truth hierarchy).
//
// PlotArmour Studio's own internal client-acquisition operating system —
// NOT a generalized CRM primitive, and NOT the same domain as
// `verity.capability.crm` (Colonel Kebabz's restaurant-guest 360, phone-
// matched, no employee hierarchy). Runs on its own new tenant.
//
// `OutreachTeam` is capability-private (ADR-005 reserves `Organization` for
// a tenant's own nested business-unit hierarchy; this is a lead-gen pod,
// same category as `HrDepartment`). No member-count cap in code — the
// Internship Agreement's "4-5 Junior Outreach Officers" is organizational
// guidance, not a technical maximum (Team 1 runs 7 live).
//
// `OutreachLead`'s `state` column is a platform state-machine key
// (`verity.outreach.lead`, seeded in this capability's own migration) per
// handbook Ch. 22's 13 linear stages + 5 terminal/negative statuses.
// Reactivating a terminal lead never reopens it (INV-002) — it spawns a new
// `OutreachLead` row via `reactivatedFromLeadId`, preserving handbook Ch. 02's
// 90-day-window origination-credit rule.
//
// Three named attribution roles (handbook Ch. 02), not one flat "owner":
// `leadOriginatorId` (immutable once set), `opportunityOwnerId`
// (reassignable — 14-day-no-activity makes it eligible), `closerId` (set
// only at Closed Won). All three are bare Party-id columns with no Prisma
// relation object and no DB foreign key, matching `HrLeaveDecision
// .decidedById`'s existing precedent for "the person who did X" fields.
//
// NOT built in this pass (P0 only, taskplan's own Scope section): lead
// quality scoring, duplicate detection, vertical/channel intelligence,
// experiments, AI assistance, email integration, a standalone compensation-
// view UI, promotion support, onboarding-flow UI.
// ===========================================================================

/// Capability-private outreach pod. `leaderId` is the Senior Outreach
/// Officer (bare Party id, no relation object — see module note above).
model OutreachTeam {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name       String
  leaderId   String   @map("leader_id") @db.Uuid
  coLeaderId String?  @map("co_leader_id") @db.Uuid
  active     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  version   Int      @default(1)

  tenant            Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships       OutreachTeamMembership[]
  leads             OutreachLead[]
  weeklyAssessments OutreachTeamWeeklyAssessment[]
  assignments       OutreachAssignment[]
  opportunities     OutreachOpportunity[]

  @@unique([tenantId, name])
  @@map("outreach_team")
}

/// Junior Outreach Officer roster for a team. No maximum size enforced —
/// see module note above.
model OutreachTeamMembership {
  id       String   @id @default(uuid()) @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  teamId   String   @map("team_id") @db.Uuid
  partyId  String   @map("party_id") @db.Uuid
  active   Boolean  @default(true)
  joinedAt DateTime @default(now()) @map("joined_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  team   OutreachTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([tenantId, teamId, partyId])
  @@map("outreach_team_membership")
}

/// A prospect company record. `state` is a `verity.outreach.lead` state-
/// machine key (ADR-009 `StateCategory` binding lives in `state_definition`,
/// seeded by this capability's migration) — never branch business logic on
/// the raw key, only on its category.
model OutreachLead {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  teamId   String @map("team_id") @db.Uuid

  companyName String  @map("company_name")
  website     String?
  /// Legacy free-text vertical, kept for leads created before Task 106
  /// Phase A. New leads should carry `domainId` instead — see the module
  /// doc's "DO NOT store industry only as arbitrary text" rule (master
  /// prompt §6). Not backfilled: a leftover value here with no `domainId`
  /// reads as "Unspecified" in vertical intelligence, same as before.
  industry    String?
  domainId    String? @map("domain_id") @db.Uuid
  /// Closed set owned by the capability: Agency | Verity | Both | Undetermined.
  track       String  @default("Undetermined")
  whyRelevant String? @map("why_relevant")

  /// The real prospect-research sheet's own columns (2026-09-13), added so
  /// nothing from the actual workbook is lost by moving to Verity: city/
  /// country, what the business does, the specific service opportunity
  /// (distinct from `whyRelevant`'s timing/trigger reasoning), the outreach
  /// angle to open with, and a 1-10 fit score.
  location         String?
  whatTheyDo       String? @map("what_they_do")
  potentialNeed    String? @map("potential_need")
  salesHypothesis  String? @map("sales_hypothesis")
  /// 1-10, matches the sheet's "Score" column.
  qualityScore     Int?    @map("quality_score")

  contactName        String? @map("contact_name")
  contactDesignation String? @map("contact_designation")
  contactEmail       String? @map("contact_email")
  contactPhone       String? @map("contact_phone")
  linkedinUrl        String? @map("linkedin_url")

  /// `verity.outreach.lead` state-machine key.
  state String @default("research")

  /// Handbook Ch. 02's three attribution roles. Bare Party ids, no relation
  /// object or DB FK — see module note above.
  leadOriginatorId   String  @map("lead_originator_id") @db.Uuid
  opportunityOwnerId String  @map("opportunity_owner_id") @db.Uuid
  closerId           String? @map("closer_id") @db.Uuid

  /// Drives the 14-day reassignment-eligibility rule (handbook Ch. 02) —
  /// updated whenever an `OutreachActivity` is logged against this lead.
  lastActivityAt DateTime? @map("last_activity_at")
  nextActionNote String?   @map("next_action_note")
  nextActionAt   DateTime? @map("next_action_at")

  /// Closed set owned by the capability (handbook Ch. 20's 9-value
  /// taxonomy): NoFit | NoBudget | NoTiming | NotInterested | WrongPerson |
  /// RevisitLater | LostToCompetitor | LostOnPrice | LostOnScopeTrust.
  /// Only meaningful once `state` is one of the 5 terminal/negative states.
  rejectionReason String? @map("rejection_reason")

  /// Handbook Ch. 02's closing edge cases: converts only once CUMULATIVE
  /// receipts clear the threshold, never on the first partial payment.
  advanceThresholdMinor Int? @map("advance_threshold_minor")
  advanceReceivedMinor  Int  @default(0) @map("advance_received_minor")
  closedAt              DateTime? @map("closed_at")

  /// INV-002: a terminal lead is never reopened. Reactivating it (handbook
  /// Ch. 02's 90-day origination-credit window) spawns a new row instead.
  reactivatedFromLeadId String? @map("reactivated_from_lead_id") @db.Uuid

  /// Escalation (2026-09-13 hierarchical-architecture doc §38-39: typed,
  /// Junior -> Senior -> Core, not straight to Core). Flagged by whoever
  /// owns the lead when it needs a Team Leader's (or, unresolved, Founders'
  /// Office's) attention — not a state, since escalation can happen from
  /// any active stage without otherwise changing the pipeline.
  escalated         Boolean   @default(false)
  escalationNote    String?   @map("escalation_note")
  /// Closed set: Commercial | Technical | ClientIssue | Attribution | TeamIssue | Other.
  escalationType    String?   @map("escalation_type")
  /// Closed set: Normal | High | Critical.
  escalationUrgency String?   @map("escalation_urgency")
  escalatedById     String?   @map("escalated_by_id") @db.Uuid
  escalatedAt       DateTime? @map("escalated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  version   Int      @default(1)

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  team       OutreachTeam        @relation(fields: [teamId], references: [id], onDelete: Restrict)
  domain     OutreachDomain?     @relation(fields: [domainId], references: [id], onDelete: SetNull)
  activities OutreachActivity[]
  contacts   OutreachContact[]
  research   OutreachResearchEntry[]
  tasks      OutreachTask[]
  meetings   OutreachMeeting[]
  coachingNotes OutreachCoachingNote[]
  aiInsights    OutreachAiInsight[]
  attributionRecords OutreachAttributionRecord[]
  escalationRecords  OutreachEscalation[]
  opportunity        OutreachOpportunity[]
  proposals          OutreachProposal[]
  closedClient       OutreachClosedClient[]

  @@index([tenantId, teamId, state])
  @@index([tenantId, opportunityOwnerId])
  @@index([tenantId, nextActionAt])
  @@index([tenantId, domainId])
  @@map("outreach_lead")
}

/// APPEND-ONLY outreach/activity log — the timeline (master-context spec
/// §31-33). One row per meaningful contact, response, or milestone.
model OutreachActivity {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  leadId        String   @map("lead_id") @db.Uuid
  actorPartyId  String   @map("actor_party_id") @db.Uuid
  /// Closed set: LinkedIn | Email | WhatsApp | Call | Referral | Meeting | Other.
  channel       String
  /// Closed set: FirstOutreach | FollowUp | Response | MeetingBooked |
  /// MeetingCompleted | ProposalSent | Other.
  activityType  String   @map("activity_type")
  message       String?
  response      String?
  occurredAt    DateTime @default(now()) @map("occurred_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   OutreachLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([tenantId, leadId, occurredAt])
  @@map("outreach_activity")
}

/// A named contact person at a prospect company (Task 106 Phase 3, spec
/// §24-25). Separate from `OutreachLead` (the company) and NOT a `Party` —
/// same ADR-001 reasoning as `OutreachLead` itself: a prospect's contact
/// person is not a platform identity until/unless they become one (e.g. a
/// client user after conversion). One lead may have multiple contacts.
model OutreachContact {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  leadId   String  @map("lead_id") @db.Uuid

  fullName    String  @map("full_name")
  designation String?
  department  String?
  email       String?
  phone       String?
  linkedinUrl String? @map("linkedin_url")

  /// Closed set: DecisionMaker | Influencer | Champion | Gatekeeper | Unknown.
  classification String  @default("Unknown")
  notes          String?

  lastContactedAt   DateTime? @map("last_contacted_at")
  createdByPartyId  String    @map("created_by_party_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  version   Int      @default(1)

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   OutreachLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([tenantId, leadId])
  @@map("outreach_contact")
}

/// APPEND-ONLY research timeline entry (Task 106 Phase 4, spec §26-29). A
/// note, a URL, or a reference to an uploaded `StoredFile` — never all
/// three; the platform's file-authorization pattern derives access from
/// `StoredFile.entityKey`/`entityId` (set to this lead), not a duplicated
/// permission on the file itself.
model OutreachResearchEntry {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  leadId   String @map("lead_id") @db.Uuid

  /// Closed set: Note | Url | Pdf | Docx | Spreadsheet | Presentation |
  /// Image | Screenshot | Other.
  type      String
  title     String
  content   String?
  sourceUrl String? @map("source_url")
  /// Set only when `type` references an uploaded file. No DB-level FK to
  /// `stored_file` (cross-schema-role platform table, same reasoning as
  /// `OutreachActivity`'s bare Party ids) — resolved by id at read time.
  fileId    String? @map("file_id") @db.Uuid

  createdByPartyId String   @map("created_by_party_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   OutreachLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([tenantId, leadId, createdAt])
  @@map("outreach_research_entry")
}

/// A work item (Task 106 Phase 5, spec §53-55). Capability-private — not a
/// platform primitive (none exists: grepped the schema, no `model.*Task`
/// before this). May stand alone or reference a prospect.
model OutreachTask {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  teamId   String  @map("team_id") @db.Uuid
  leadId   String? @map("lead_id") @db.Uuid

  title       String
  description String?
  /// Closed set: Low | Medium | High | Urgent.
  priority String    @default("Medium")
  dueAt    DateTime? @map("due_at")

  /// Closed set: Todo | InProgress | Blocked | Done | Cancelled.
  status String @default("Todo")
  /// Closed set: TeamLeaderAssigned | SelfCreated | SystemGenerated (spec
  /// §54) — lets management see initiative separately from assigned load.
  origin String

  assignedToPartyId String  @map("assigned_to_party_id") @db.Uuid
  assignedByPartyId String  @map("assigned_by_party_id") @db.Uuid

  completedAt DateTime? @map("completed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  version   Int      @default(1)

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   OutreachLead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([tenantId, teamId, status])
  @@index([tenantId, assignedToPartyId, status])
  @@map("outreach_task")
}

/// A scheduled or completed meeting against a prospect (spec §62).
model OutreachMeeting {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  leadId   String @map("lead_id") @db.Uuid

  organizerPartyId String   @map("organizer_party_id") @db.Uuid
  scheduledAt      DateTime @map("scheduled_at")
  purpose          String?
  locationOrUrl    String?  @map("location_or_url")
  prepNotes        String?  @map("prep_notes")
  outcomeNotes     String?  @map("outcome_notes")

  /// Closed set: Scheduled | Completed | Cancelled | NoShow.
  status String @default("Scheduled")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  version   Int      @default(1)

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   OutreachLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([tenantId, leadId, scheduledAt])
  @@index([tenantId, organizerPartyId, scheduledAt])
  @@map("outreach_meeting")
}

/// Flat target row — company/team/individual x daily/weekly (master-context
/// spec §11-12). Progress is always computed live from `OutreachActivity`/
/// `OutreachLead` counts, never hand-typed (Task 93's `onboardingChecklist`
/// precedent) and never stored on this row.
model OutreachTarget {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// Closed set: Company | Team | Individual.
  scope   String
  teamId  String? @map("team_id") @db.Uuid
  partyId String? @map("party_id") @db.Uuid

  /// Closed set: Daily | Weekly.
  period String
  /// Closed set: QualifiedProspects | Outreach | FollowUps | Responses |
  /// Meetings | Proposals | Closed.
  metric      String
  targetValue Int    @map("target_value")

  periodStart DateTime @map("period_start") @db.Date
  periodEnd   DateTime @map("period_end") @db.Date

  /// Task 106 Phase 3 (spec §72-73's audit-trail gap): setting a new target
  /// for the same scope/team/party/period/metric/periodStart supersedes the
  /// prior one (`active` flips false) rather than silently rewriting it —
  /// old rows stay queryable, the field-level diff goes through the
  /// platform's existing `recordActivity` audit log (no parallel history
  /// table). `changeReason` is optional context on the NEW row, not the old.
  active       Boolean @default(true)
  changeReason String? @map("change_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  version   Int      @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, scope, teamId, partyId, periodStart])
  @@map("outreach_target")
}

/// Junior's daily check-in (master-context spec §20-23). Numeric activity
/// is NEVER stored here — it is queried live from `OutreachActivity`/
/// `OutreachLead` at read time (spec §21's own automatic-vs-manual rule).
/// This row holds only what a person must type by hand.
model OutreachCheckIn {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  partyId       String   @map("party_id") @db.Uuid
  checkInDate   DateTime @map("check_in_date") @db.Date
  summary       String
  bestLeadId    String?  @map("best_lead_id") @db.Uuid
  learning      String?
  blocker       String?
  tomorrowPlan  String?  @map("tomorrow_plan")
  submittedAt   DateTime @default(now()) @map("submitted_at")

  /// Task 106 Phase 5 (spec §64-71): the two questions the original 5-field
  /// shape didn't ask. `mostImportantDevelopment` is distinct from
  /// `summary` (what happened, in full, vs. the one thing that mattered);
  /// `needsAttention` is what the Junior is explicitly flagging up.
  mostImportantDevelopment String? @map("most_important_development")
  needsAttention           String? @map("needs_attention")

  tenant Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reviews OutreachCheckInReview[]

  @@unique([tenantId, partyId, checkInDate])
  @@map("outreach_check_in")
}

/// APPEND-ONLY review of a daily check-in (spec §68's Submitted → Reviewed
/// → NeedsClarification workflow). A separate row, never an UPDATE to
/// `OutreachCheckIn` — that table has a hard append-only trigger (see its
/// migration), matching handbook Ch. 02's "never rewrite the Junior's own
/// text" rule literally rather than trusting application code to honor it.
/// "Current" review status is the latest row for a given `checkInId`.
model OutreachCheckInReview {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  checkInId         String   @map("check_in_id") @db.Uuid
  reviewedByPartyId String   @map("reviewed_by_party_id") @db.Uuid
  /// Closed set: Reviewed | NeedsClarification (never "Submitted" — that's
  /// the check-in's own implicit starting state, not a review outcome).
  reviewStatus   String   @map("review_status")
  leaderFeedback String?  @map("leader_feedback")
  reviewedAt     DateTime @default(now()) @map("reviewed_at")

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  checkIn OutreachCheckIn @relation(fields: [checkInId], references: [id], onDelete: Cascade)

  @@index([tenantId, checkInId, reviewedAt])
  @@map("outreach_check_in_review")
}

/// APPEND-ONLY coaching note (Task 106 Phase 6, spec §79). Feedback is
/// never edited after the fact — a correction is a new note, same
/// reasoning as every other append-only table here. `visibility` splits
/// what the Junior themselves may read from Leader-only management notes.
model OutreachCoachingNote {
  id             String @id @default(uuid()) @db.Uuid
  tenantId       String @map("tenant_id") @db.Uuid
  teamId         String @map("team_id") @db.Uuid
  leadId         String? @map("lead_id") @db.Uuid
  aboutPartyId   String @map("about_party_id") @db.Uuid
  authorPartyId  String @map("author_party_id") @db.Uuid
  content        String
  /// Closed set: JuniorVisible | LeaderPrivate.
  visibility     String @default("JuniorVisible")
  createdAt      DateTime @default(now()) @map("created_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   OutreachLead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([tenantId, teamId, aboutPartyId, createdAt])
  @@map("outreach_coaching_note")
}

/// Junior's weekly reflection (master-context spec §24). Aggregation is a
/// live query, same discipline as the daily check-in above.
model OutreachWeeklyReport {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @map("tenant_id") @db.Uuid
  partyId               String   @map("party_id") @db.Uuid
  weekStart             DateTime @map("week_start") @db.Date
  whatWorked            String?  @map("what_worked")
  whatDidntWork         String?  @map("what_didnt_work")
  strongestOpportunityId String? @map("strongest_opportunity_id") @db.Uuid
  biggestLearning       String?  @map("biggest_learning")
  nextWeekChange        String?  @map("next_week_change")
  nextWeekTargetValue   Int?     @map("next_week_target_value")
  submittedAt           DateTime @default(now()) @map("submitted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, partyId, weekStart])
  @@map("outreach_weekly_report")
}

/// Senior's weekly team roll-up + written assessment (master-context spec
/// §25) — submitted to Company Core. Member/pipeline numbers are live
/// queries; only the assessment text and the roll-up's identity is stored.
model OutreachTeamWeeklyAssessment {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @map("tenant_id") @db.Uuid
  teamId                String   @map("team_id") @db.Uuid
  weekStart             DateTime @map("week_start") @db.Date
  strongestPerformerId  String?  @map("strongest_performer_id") @db.Uuid
  strongestProspectId   String?  @map("strongest_prospect_id") @db.Uuid
  strongestVertical     String?  @map("strongest_vertical")
  biggestProblem        String?  @map("biggest_problem")
  biggestLearning       String?  @map("biggest_learning")
  nextWeekPriority      String?  @map("next_week_priority")
  submittedAt           DateTime @default(now()) @map("submitted_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  team   OutreachTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([tenantId, teamId, weekStart])
  @@map("outreach_team_weekly_assessment")
}

/// Company-wide direction (master-context spec §10-11) — a dated text/target
/// record a Founder posts, cascading to team/individual targets. Narrower
/// than `WorkflowDefinition`, closer to `NotificationTemplate`'s shape.
/// APPEND-ONLY: a new direction supersedes the old one; it never edits it
/// (ADR-009 — a wrong fact is corrected by a new fact, not an edit).
model OutreachDirection {
  id                       String   @id @default(uuid()) @db.Uuid
  tenantId                 String   @map("tenant_id") @db.Uuid
  weekLabel                String   @map("week_label")
  priorityVertical         String?  @map("priority_vertical")
  /// Closed set: Agency | Verity | Both | Undetermined — same as OutreachLead.track.
  primaryTrack             String   @default("Undetermined") @map("primary_track")
  companyProspectingTarget Int?     @map("company_prospecting_target")
  strategicNote            String?  @map("strategic_note")
  /// Task 106 Phase 7 (spec §91, master-context §10's own example): the
  /// direction fields the first cut left out. `priorityIndustries` is a
  /// list, not a joined string, so vertical intelligence can match a
  /// lead's `industry` against it without parsing product copy.
  priorityIndustries       String[] @default([]) @map("priority_industries")
  secondaryOpportunity     String?  @map("secondary_opportunity")
  geographicFocus          String?  @map("geographic_focus")
  targetCompanyProfile     String?  @map("target_company_profile")
  /// No `status`/`closedAt` column by design: the table is append-only
  /// (its own migration's trigger), so "current" is derived — the latest
  /// `postedAt` — and an earlier row's close time is the next row's
  /// `postedAt`. See `listDirections` for the derivation.
  postedById               String   @map("posted_by_id") @db.Uuid
  postedAt                 DateTime @default(now()) @map("posted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, postedAt])
  @@map("outreach_direction")
}

/// APPEND-ONLY AI suggestion about a lead (Task 106 Phase 8; master-context
/// §85's permitted list, §32-33's provenance rule). NEVER a fact about the
/// lead: nothing here is read back into `OutreachLead`. A person accepts a
/// suggestion by running the real command themselves (advance the stage,
/// log the activity) — the row stays what it was, a suggestion with its
/// provenance, so "what the AI said" and "what a human decided" can never
/// be confused for each other. Generated as the requesting human's own
/// actor (ADR-017): `sourceReads` lists the query keys the turn actually
/// executed, so a reader can see what it was grounded on — and, since
/// those ran through `enforcePolicy()`, that nothing outside the
/// requester's own access reached the model.
model OutreachAiInsight {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  leadId   String @map("lead_id") @db.Uuid

  /// Closed set: Summary | NextStep | Qualification.
  kind    String
  content String

  /// Provenance (§32): which model, which prompt version, which reads.
  model             String
  promptVersion     String   @map("prompt_version")
  sourceReads       String[] @default([]) @map("source_reads")
  requestedByPartyId String  @map("requested_by_party_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   OutreachLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([tenantId, leadId, createdAt])
  @@map("outreach_ai_insight")
}

/// Task 106 Phase A: the domain taxonomy's top level (master prompt §6 —
/// "DOMAIN GROUP -> DOMAIN", "must be database-driven", "do not hardcode").
/// Seeded once per tenant from the master prompt's 9-group list; Core-level
/// taxonomy management (add/rename/retire a group) is future work this
/// migration does not build UI for — the table exists so that door is open
/// without a schema change later.
model OutreachDomainGroup {
  id       String   @id @default(uuid()) @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  name     String
  /// Display order — the seed's own list order, not alphabetical.
  order    Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  domains OutreachDomain[]

  @@unique([tenantId, name])
  @@map("outreach_domain_group")
}

/// The taxonomy's leaf level — what `OutreachLead.domainId` points at.
/// `industry` (free text) predates this and is kept for leads created
/// before Phase A; new leads should carry a `domainId` instead.
model OutreachDomain {
  id       String   @id @default(uuid()) @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  groupId  String   @map("group_id") @db.Uuid
  name     String
  order    Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group  OutreachDomainGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  leads  OutreachLead[]

  @@unique([tenantId, groupId, name])
  @@map("outreach_domain")
}

/// Task 106 Phase B (master prompt §60): APPEND-ONLY attribution history.
/// Does not replace `OutreachLead.leadOriginatorId`/`opportunityOwnerId`/
/// `closerId` — those stay the fast, current-value fields every query
/// already reads. This is the queryable "how did we get here" trail Core
/// needs for compensation-adjacent review (§60: "Core-level attribution
/// decision is final ... Track attribution history").
model OutreachAttributionRecord {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  leadId   String @map("lead_id") @db.Uuid

  /// Closed set: Originator | Owner | Closer.
  role            String
  partyId         String   @map("party_id") @db.Uuid
  changedByPartyId String  @map("changed_by_party_id") @db.Uuid
  reason          String?
  effectiveFrom   DateTime @default(now()) @map("effective_from")

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   OutreachLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([tenantId, leadId, effectiveFrom])
  @@map("outreach_attribution_record")
}

/// Task 106 Phase C (master prompt §35): escalation promoted from fields on
/// `OutreachLead` to its own lifecycle object with OPEN/IN REVIEW/RESOLVED
/// states. The `OutreachLead.escalated*` fields are kept and still written
/// (existing UI reads them) — this table is additive, not a replacement,
/// so nothing already shipped breaks.
model OutreachEscalation {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  leadId   String @map("lead_id") @db.Uuid

  /// Closed set: Commercial | Technical | ClientIssue | Attribution | TeamIssue | Other.
  type    String?
  /// Closed set: Normal | High | Critical.
  urgency String?
  note    String

  /// Closed set: Open | InReview | Resolved.
  status String @default("Open")

  raisedByPartyId   String    @map("raised_by_party_id") @db.Uuid
  raisedAt          DateTime  @default(now()) @map("raised_at")
  resolvedByPartyId String?   @map("resolved_by_party_id") @db.Uuid
  resolvedAt        DateTime? @map("resolved_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   OutreachLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([tenantId, leadId, status])
  @@index([tenantId, status])
  @@map("outreach_escalation")
}

/// Task 106 Phase D (master prompt §8-9, §63): OPPORTUNITY as a fact
/// distinct from CLOSED CLIENT. Materialized once, from `advanceLeadStage`,
/// the moment a lead first reaches the `opportunity` stage — append-only,
/// never a second source of truth for pipeline stage (`OutreachLead.state`
/// still drives that; this is the audit/reporting record).
model OutreachOpportunity {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  leadId   String @map("lead_id") @db.Uuid
  teamId   String @map("team_id") @db.Uuid

  track              String
  estimatedValueMinor Int?     @map("estimated_value_minor")
  createdAt          DateTime @default(now()) @map("created_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   OutreachLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  team   OutreachTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([tenantId, leadId])
  @@map("outreach_opportunity")
}

/// APPEND-ONLY: one row per proposal sent (master prompt §9). A lead can
/// carry more than one across its life (revised terms), unlike Opportunity/
/// ClosedClient which are 0-or-1.
model OutreachProposal {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  leadId   String @map("lead_id") @db.Uuid

  valueMinor Int?     @map("value_minor")
  notes      String?
  sentAt     DateTime @default(now()) @map("sent_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   OutreachLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([tenantId, leadId, sentAt])
  @@map("outreach_proposal")
}

/// Task 106 Phase D (master prompt §8): the ONLY record that means a client
/// is closed for compensation/sales-reporting purposes. Created exclusively
/// from `advanceLeadStage`'s existing advance-threshold check when a lead
/// transitions to `closed_won` — the same gate that already exists, now
/// also materializing this row instead of leaving "closed" as an inferred
/// read over `OutreachLead.state`.
model OutreachClosedClient {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  leadId   String @map("lead_id") @db.Uuid

  closerId          String   @map("closer_id") @db.Uuid
  advanceReceivedMinor Int   @map("advance_received_minor")
  closedAt          DateTime @default(now()) @map("closed_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   OutreachLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([tenantId, leadId])
  @@map("outreach_closed_client")
}

/// Task 106 Phase E (master prompt §30): "Healthcare -> Shreya + Mehak" —
/// a Team Leader assigning a domain/group/track/geography slice of work to
/// a member. `value` holds whichever the scope names (a domain/group id as
/// text, a track name, or a free-text geography) — one column instead of
/// four mutually-exclusive nullable FKs.
model OutreachAssignment {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  teamId   String @map("team_id") @db.Uuid
  partyId  String @map("party_id") @db.Uuid

  /// Closed set: Domain | DomainGroup | Track | Geography.
  scope String
  value String

  assignedByPartyId String   @map("assigned_by_party_id") @db.Uuid
  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  team   OutreachTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([tenantId, teamId, partyId, active])
  @@map("outreach_assignment")
}

/// A machine credential for one membership (ADR-029, Task 120).
///
/// The key is a revocable, expiring HANDLE to a provisioned identity, never the
/// identity itself: revoking it ends machine access without touching the user or
/// their role. Only the SHA-256 of the secret half is stored, so a dump yields
/// nothing replayable; `keyId` is the non-secret lookup half. The tenant is
/// fixed by this row (PLA-TEN-006) — it is unknown until the key is read, which
/// is why lookup goes through the SECURITY DEFINER `verity.authenticate_api_key`
/// rather than an ordinary RLS-filtered read.
model ExternalApiKey {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  membershipId String    @map("membership_id") @db.Uuid
  keyId        String    @unique @map("key_id")
  secretHash   String    @map("secret_hash")
  name         String
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  lastUsedAt   DateTime? @map("last_used_at")
  createdById  String?   @map("created_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([membershipId])
  @@map("external_api_key")
}

/// Idempotency ledger for the external tool surface (ADR-029 constraint 7). One
/// row per (tenant, key, Idempotency-Key). A row with a null `response` is a
/// claim whose command has not finished; a retry then gets 409, not a second run.
model ExternalIdempotency {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  keyId          String   @map("key_id")
  idempotencyKey String   @map("idempotency_key")
  requestHash    String   @map("request_hash")
  response       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, keyId, idempotencyKey])
  @@map("external_idempotency")
}

/// One event in an order's delivery: it leaves ('dispatched', with the packaging
/// photograph as evidence) and later arrives ('delivered'). APPEND-ONLY, like the
/// QC ledger: a mistake is corrected by a newer fact, and the latest row is the
/// order's current logistics state.
model ManufacturingDispatch {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  orderId             String   @map("order_id") @db.Uuid
  status              String
  transporter         String?
  vehicleNo           String?  @map("vehicle_no")
  trackingRef         String?  @map("tracking_ref")
  packagingEvidenceId String?  @map("packaging_evidence_id") @db.Uuid
  note                String?
  recordedById        String?  @map("recorded_by_id") @db.Uuid
  recordedAt          DateTime @default(now()) @map("recorded_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order             ManufacturingOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  packagingEvidence Evidence?          @relation(fields: [packagingEvidenceId], references: [id], onDelete: Restrict)

  @@index([tenantId, orderId, recordedAt])
  @@map("manufacturing_dispatch")
}

/// Several draft orders produced together (one cutting run). It has no lifecycle
/// of its own: its progress is its member orders'. Dissolving it frees the orders.
model ManufacturingBatch {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  locationId  String   @map("location_id") @db.Uuid
  reference   String?
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders ManufacturingOrder[]

  @@index([tenantId])
  @@map("manufacturing_batch")
}

/// Stock held for a draft order but not yet consumed (Task 118). Not a movement:
/// nothing leaves the location. Available = on hand minus live reservations of
/// OTHER orders. Released (never deleted) when the order starts, is cancelled, or
/// the hold is let go, so why stock was unavailable last Tuesday has an answer.
model ManufacturingReservation {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  orderId         String    @map("order_id") @db.Uuid
  componentItemId String    @map("component_item_id") @db.Uuid
  locationId      String    @map("location_id") @db.Uuid
  qty             Int
  releasedAt      DateTime? @map("released_at")
  releaseReason   String?   @map("release_reason")
  createdAt       DateTime  @default(now()) @map("created_at")

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order         ManufacturingOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  componentItem InventoryItem      @relation(fields: [componentItemId], references: [id], onDelete: Restrict)

  @@index([tenantId, componentItemId, locationId, releasedAt])
  @@index([tenantId, orderId])
  @@map("manufacturing_reservation")
}
